#!/usr/bin/perl
use strict;
use warnings;
use Getopt::Long;
use Cwd qw(abs_path);
use File::Path qw(make_path);
use POSIX ();

########################################################################
# 中文用法说明（放在代码最前面；英文用法说明放在文件最末尾的__DATA__部分）
########################################################################
my $usage_cn = <<'USAGE';
用法:
    perl $0 [options] genome.fasta hints.gff

    程序将基因组序列和hints信息分成多份，使用内置的Perl多进程(fork)工作池并行调用augustus，不再依赖外部ParaFly，最后合并并行化结果，将最终的GFF3结果输出到标准输出(STDOUT)。输入的hints.gff3文件无需预先排序；相邻分段重叠区域内的基因只保留一份，不会重复输出。

    --species <string>    默认值: 无
    设置用于进行Augustus基因预测的物种HMM模型名称。该参数必须设置。

    --cpu <int>    默认值: 1
    设置并行运行augustus命令的进程数目。

    --segmentSize <int>    默认值: 5000000
    程序将基因组序列分割成单条进行基因预测；若单条序列长度超过该值(默认5Mb)，则将其切割成该长度的分段后再进行基因预测。

    --overlapSize <int>    默认值: 100000
    两条相邻分段间重叠的长度(默认100kb)，必须小于--segmentSize。重叠区域内的基因按其起始位置以重叠区中点为界，仅保留一份。

    --tmp_dir <string>    默认值: aug_para_with_hints.tmp
    设置临时文件夹。使用相同的临时文件夹和参数重新运行程序时，已经成功完成的分段将被跳过(断点续跑)。

    --gene_prefix <string>    默认值: augustus
    设置最终输出基因ID的前缀，基因ID形如augustus_g1、augustus_g2。

    --alternatives_from_evidence    默认值: 无
    添加该参数后，Augustus会根据hints证据进行可变剪接分析。

    --min_intron_len <int>    默认值: 20
    设置augustus预测时最小的intron长度。

    --AUGUSTUS_CONFIG_PATH <string>    默认值: 无
    设置AUGUSTUS软件的物种配置文件夹路径。在该路径下应该存在一个名为species的子文件夹，species文件夹下则存放物种名称文件夹。设置该参数有利于将物种配置文件存放到有权限读写的地方。需要注意的是：该参数比Linux下的$AUGUSTUS_CONFIG_PATH优先级更高；该参数指定的路径下还应该存在cgp、extrinsic、model、parameters和profile文件夹，运行etraining/augustus命令时需要依赖相应的文件。

    --help
    Show the help message in English and exit.

    --chinese_help
    显示中文用法说明并退出。
USAGE

my $usage_en = do { local $/; <DATA> };
my $prog = $0;
s/\$0/$prog/g for ($usage_cn, $usage_en);

########################################################################
# 参数解析
########################################################################
my ($species, $cpu, $tmp_dir, $gene_prefix, $segmentSize, $overlapSize);
my ($alternatives_from_evidence, $min_intron_len, $AUGUSTUS_CONFIG_PATH);
my ($help, $chinese_help);

if (@ARGV == 0) { print STDERR $usage_en; exit 1; }

GetOptions(
    "species=s"                   => \$species,
    "cpu=i"                       => \$cpu,
    "tmp_dir=s"                   => \$tmp_dir,
    "gene_prefix=s"               => \$gene_prefix,
    "segmentSize=i"               => \$segmentSize,
    "overlapSize=i"               => \$overlapSize,
    "min_intron_len=i"            => \$min_intron_len,
    "alternatives_from_evidence!" => \$alternatives_from_evidence,
    "AUGUSTUS_CONFIG_PATH=s"      => \$AUGUSTUS_CONFIG_PATH,
    "help"                        => \$help,
    "chinese_help"                => \$chinese_help,
) or do { print STDERR "\n", $usage_en; exit 1; };

if ($chinese_help) { print $usage_cn; exit 0; }
if ($help)         { print $usage_en; exit 0; }

$gene_prefix    = 'augustus'              unless defined $gene_prefix && length $gene_prefix;
$cpu            = 1                       unless defined $cpu;
$tmp_dir        = 'aug_para_with_hints.tmp' unless defined $tmp_dir && length $tmp_dir;
$segmentSize    = 5000000                 unless defined $segmentSize;
$overlapSize    = 100000                  unless defined $overlapSize;
$min_intron_len = 20                      unless defined $min_intron_len;

if (@ARGV != 2) { print STDERR "Error: exactly two input files (genome.fasta hints.gff) are required.\n\n", $usage_en; exit 1; }
my ($genome_file, $hints_file) = @ARGV;

die "Error: The --species parameter is not set!\n" unless defined $species && length $species;
die "Error: --cpu must be >= 1\n"                  if $cpu < 1;
die "Error: --segmentSize must be > 0\n"           if $segmentSize <= 0;
die "Error: --overlapSize must be >= 0 and smaller than --segmentSize\n" if $overlapSize < 0 || $overlapSize >= $segmentSize;
die "Error: --min_intron_len must be >= 0\n"       if $min_intron_len < 0;
die "Error: cannot read genome file $genome_file\n" unless -r $genome_file;
die "Error: cannot read hints file $hints_file\n"   unless -r $hints_file;

if (defined $AUGUSTUS_CONFIG_PATH) {
    my $p = abs_path($AUGUSTUS_CONFIG_PATH);
    die "Error: --AUGUSTUS_CONFIG_PATH $AUGUSTUS_CONFIG_PATH does not exist\n" unless defined $p && -d $p;
    $AUGUSTUS_CONFIG_PATH = $p;
}

########################################################################
# 读取基因组序列和hints
########################################################################
my (%seq, @seq_order, $id);
open my $gfh, '<', $genome_file or die "Cannot open $genome_file: $!\n";
while (my $line = <$gfh>) {
    $line =~ s/[\r\n]+$//;
    next if $line eq '';
    if ($line =~ /^>\s*(\S+)/) {
        $id = $1;
        die "Error: duplicated sequence ID '$id' in $genome_file\n" if exists $seq{$id};
        $seq{$id} = '';
        push @seq_order, $id;
    }
    elsif ($line =~ /^>/) {
        die "Error: empty sequence ID in $genome_file\n";
    }
    else {
        die "Error: sequence data before the first '>' header in $genome_file\n" unless defined $id;
        $line =~ s/\s+//g;
        $seq{$id} .= $line;
    }
}
close $gfh;

my (%hints, %unknown_hint_id);
my $n_bad_hints = 0;
open my $hfh, '<', $hints_file or die "Cannot open $hints_file: $!\n";
while (my $line = <$hfh>) {
    $line =~ s/[\r\n]+$//;
    next if $line =~ /^\s*$/ || $line =~ /^#/;
    my @f = split /\t/, $line;
    if (@f < 9 || $f[3] !~ /^\d+$/ || $f[4] !~ /^\d+$/) { $n_bad_hints++; next; }
    if (!exists $seq{$f[0]}) { $unknown_hint_id{$f[0]}++; next; }
    push @{ $hints{$f[0]} }, \@f;
}
close $hfh;
warn "Warning: $n_bad_hints malformed hints lines were skipped.\n" if $n_bad_hints;
warn "Warning: hints refer to " . scalar(keys %unknown_hint_id) . " sequence ID(s) absent from the genome file and were ignored.\n" if %unknown_hint_id;

########################################################################
# 临时目录、extrinsic.cfg
########################################################################
make_path($tmp_dir) unless -d $tmp_dir;
$tmp_dir = abs_path($tmp_dir) or die "Cannot resolve tmp_dir: $!\n";
my $extrinsic_cfg = "$tmp_dir/extrinsic.cfg";

# 给M E P W不同类型的hints设置参数。(1) 添加individual_liability，表示当组内有不满足要求的hint时，仅删除该hint，而不是像默认情况下删除整组的hints信息。(2) 添加1group1gene，表示程序尝试预测出一个能完全覆盖整组hints的基因模型，有利于处理多组hints之间的Gaps。
# Feature(CDS CDSpart intron)后紧跟两个数据，第一个是奖励系数，第二个是惩罚系数(可以有两个数值)。第二个值越小，则表示没有hints支持时，更谨慎地预测基因，即最终预测的基因数量越少，specificity越高。
my $extrinsic = <<'EXTRINSIC';
[SOURCES]
M RM E W P

[SOURCE-PARAMETERS]
M individual_liability 1group1gene
E individual_liability 1group1gene
P individual_liability 1group1gene
W individual_liability 1group1gene

[GENERAL]
      start      1         0.8    M    1  1e+100  RM  1     1    E 1    1e6  W 1    1                     P   1   1e3
       stop      1         0.8    M    1  1e+100  RM  1     1    E 1    1e6  W 1    1                     P   1   1e3
        tss      1         1      M    1  1e+100  RM  1     1    E 1    1    W 1    1                     P   1   1
        tts      1         1      M    1  1e+100  RM  1     1    E 1    1    W 1    1                     P   1   1
        ass      1  1      1      M    1  1e+100  RM  1     1    E 1    100  W 1    1                     P   1   100
        dss      1  1      1      M    1  1e+100  RM  1     1    E 1    100  W 1    1                     P   1   100
   exonpart      1  0.992  0.985  M    1  1e+100  RM  1     1    E 1    1e6  W 1    1                     P   1   1e3
       exon      1         0.9    M    1  1e+100  RM  1     1    E 1    1e6  W 1    1                     P   1   1e3
 intronpart      1         1      M    1  1e+100  RM  1     1    E 1    1e6  W 1    1                     P   1   1e3
     intron      1         0.34   M    1  1e+100  RM  1     1    E 1    1e6  W 4 5 50 500 10 1e3 1e5 1e7  P   1   1e3
    CDSpart      1  1      0.985  M    1  1e+100  RM  1     1    E 1    1e6  W 1    1                     P   1   1e3
        CDS      1         1      M    1  1e+100  RM  1     1    E 1    1e6  W 1    1                     P   1   1e3
    UTRpart      1  1      1      M    1  1e+100  RM  1     1    E 1    1    W 1    1                     P   1   1
        UTR      1         1      M    1  1e+100  RM  1     1    E 1    1    W 1    1                     P   1   1
     irpart      1         1      M    1  1e+100  RM  1     1    E 1    1    W 1    1                     P   1   1
nonexonpart      1         1      M    1  1e+100  RM  1     1.14 E 1    1    W 1    1                     P   1   1
  genicpart      1         1      M    1  1e+100  RM  1     1    E 1    1    W 1    1                     P   1   1
EXTRINSIC
open my $efh, '>', $extrinsic_cfg or die "Cannot create $extrinsic_cfg: $!\n";
print $efh $extrinsic;
close $efh;

########################################################################
# 分割基因组和hints（支持断点续跑）
########################################################################
my $list_file = "$tmp_dir/out_id.list";
my $split_ok  = "$tmp_dir/split.ok";

my $segments = (-e $split_ok && -s $list_file) ? load_segments($list_file) : undef;
if (!$segments) {
    unlink $split_ok;
    $segments = split_data();
}

# 写出命令行列表（仅供查看，实际由内置工作池执行）
open my $cfh, '>', "$tmp_dir/command.augustus.list" or die "Cannot create command list: $!\n";
foreach my $seg (@$segments) {
    my $cmd = build_cmd($seg);
    print $cfh join(' ', map { shell_quote($_) } @$cmd), " > $tmp_dir/$seg->{tid}.out 2> $tmp_dir/$seg->{tid}.log\n";
}
close $cfh;

########################################################################
# 并行运行augustus（fork工作池）
########################################################################
my @todo = grep { !(-e "$tmp_dir/$_->{tid}.ok" && -e "$tmp_dir/$_->{tid}.out") } @$segments;
print STDERR scalar(@$segments), " segment(s) in total, ", scalar(@todo), " to run, using $cpu worker(s).\n";
run_tasks($cpu, [ map { { tid => $_->{tid}, cmd => build_cmd($_) } } @todo ]);

########################################################################
# 合并结果：坐标转换、重叠区去冗余、基因ID重命名
########################################################################
print "##gff-version 3\n";
my $gene_num = 0;
foreach my $seg (@$segments) {
    merge_segment($seg, \$gene_num);
}
print STDERR "Done. $gene_num gene(s) written.\n";
exit 0;

########################################################################
# 子程序
########################################################################
sub get_partition {
    my ($length, $ss, $os) = @_;
    my @out;
    my $pos = 1;
    push @out, $pos;
    while (($pos + $ss - 1) < $length) {
        $pos = $pos + $ss - $os;
        push @out, $pos;
    }
    return @out;
}

sub split_data {
    my @segs;
    my $idx = 0;
    my $half = int($overlapSize / 2);
    foreach my $seq_id (@seq_order) {
        my $len = length $seq{$seq_id};
        if ($len == 0) { warn "Warning: sequence $seq_id is empty, skipped.\n"; next; }
        my @hs = sort { $a->[3] <=> $b->[3] || $a->[4] <=> $b->[4] } @{ $hints{$seq_id} || [] };
        my @starts = get_partition($len, $segmentSize, $overlapSize);
        for my $i (0 .. $#starts) {
            my $pos = $starts[$i];                       # 1-based segment start
            my $end = $pos + $segmentSize - 1;           # 1-based segment end
            $end = $len if $end > $len;
            my $offset    = $pos - 1;
            my $keep_from = $i == 0        ? 1    : $pos + $half;
            my $keep_to   = $i == $#starts ? $len : $starts[$i + 1] + $half - 1;
            my $tid = sprintf("seg%06d", ++$idx);

            # 基因组序列
            my $sub_seq = substr($seq{$seq_id}, $offset, $end - $offset);
            $sub_seq =~ s/(.{1,100})/$1\n/g;
            open my $o, '>', "$tmp_dir/$tid.fasta" or die "Cannot create $tmp_dir/$tid.fasta: $!\n";
            print $o ">$seq_id\n$sub_seq";
            close $o;

            # hints（完全落在分段内的hints，坐标转换为分段内坐标）
            open $o, '>', "$tmp_dir/$tid.gff" or die "Cannot create $tmp_dir/$tid.gff: $!\n";
            foreach my $h (@hs) {
                next unless $h->[3] >= $pos && $h->[4] <= $end;
                my @g = @$h;
                $g[3] -= $offset;
                $g[4] -= $offset;
                print $o join("\t", @g), "\n";
            }
            close $o;

            push @segs, { tid => $tid, seq_id => $seq_id, offset => $offset, keep_from => $keep_from, keep_to => $keep_to };
        }
    }

    open my $o, '>', $list_file or die "Cannot create $list_file: $!\n";
    print $o "#task\tseqID\toffset\tkeep_from\tkeep_to\n";
    print $o join("\t", @{$_}{qw(tid seq_id offset keep_from keep_to)}), "\n" for @segs;
    close $o;
    open $o, '>', $split_ok or die "Cannot create $split_ok: $!\n";
    close $o;
    return \@segs;
}

sub load_segments {
    my ($file) = @_;
    my @segs;
    open my $in, '<', $file or return undef;
    while (my $line = <$in>) {
        $line =~ s/[\r\n]+$//;
        next if $line =~ /^#/ || $line eq '';
        my @f = split /\t/, $line;
        return undef if @f != 5;
        my %s; @s{qw(tid seq_id offset keep_from keep_to)} = @f;
        return undef unless -e "$tmp_dir/$s{tid}.fasta" && -e "$tmp_dir/$s{tid}.gff";
        push @segs, \%s;
    }
    close $in;
    return @segs ? \@segs : undef;
}

sub build_cmd {
    my ($seg) = @_;
    my @cmd = ('augustus', '--gff3=on', "--species=$species");
    push @cmd, "--AUGUSTUS_CONFIG_PATH=$AUGUSTUS_CONFIG_PATH" if defined $AUGUSTUS_CONFIG_PATH;
    push @cmd, "--hintsfile=$tmp_dir/$seg->{tid}.gff", "--extrinsicCfgFile=$extrinsic_cfg", '--allow_hinted_splicesites=gcag,atac';
    push @cmd, '--alternatives-from-evidence=true' if $alternatives_from_evidence;
    push @cmd, "--min_intron_len=$min_intron_len", '--softmasking=1', "$tmp_dir/$seg->{tid}.fasta";
    return \@cmd;
}

sub shell_quote {
    my ($s) = @_;
    return $s if $s =~ /^[\w\-\.\/=,:+]+$/;
    $s =~ s/'/'\\''/g;
    return "'$s'";
}

# 基于fork的工作池：同时最多运行$cpu个augustus进程，任一失败则在全部结束后报错退出
sub run_tasks {
    my ($max, $tasks) = @_;
    my (%running, @failed);

    local $SIG{INT}  = sub { kill 'TERM', keys %running; die "Interrupted, workers terminated.\n"; };
    local $SIG{TERM} = $SIG{INT};

    my $reap = sub {
        my $pid = wait();
        die "wait() failed: $!\n" if $pid < 0;
        my $t = delete $running{$pid} or return;
        if ($? == 0) {
            rename "$tmp_dir/$t->{tid}.out.part", "$tmp_dir/$t->{tid}.out" or die "Cannot rename output of $t->{tid}: $!\n";
            open my $ok, '>', "$tmp_dir/$t->{tid}.ok" or die "Cannot create ok-file of $t->{tid}: $!\n";
            close $ok;
        }
        else {
            push @failed, $t->{tid};
            print STDERR "Task $t->{tid} failed (exit code " . ($? >> 8) . ", signal " . ($? & 127) . "), see $tmp_dir/$t->{tid}.log\n";
        }
    };

    foreach my $t (@$tasks) {
        $reap->() while scalar(keys %running) >= $max;
        my $pid = fork();
        die "fork failed: $!\n" unless defined $pid;
        if ($pid == 0) {
            open STDOUT, '>', "$tmp_dir/$t->{tid}.out.part" or POSIX::_exit(126);
            open STDERR, '>', "$tmp_dir/$t->{tid}.log"      or POSIX::_exit(126);
            { exec { $t->{cmd}[0] } @{ $t->{cmd} }; }
            print STDERR "Cannot execute $t->{cmd}[0]: $!\n";
            POSIX::_exit(127);
        }
        $running{$pid} = $t;
    }
    $reap->() while %running;

    die "Error: " . scalar(@failed) . " augustus task(s) failed: @failed\nFix the problem and re-run with the same --tmp_dir to resume.\n" if @failed;
}

sub merge_segment {
    my ($seg, $num_ref) = @_;
    my $file = "$tmp_dir/$seg->{tid}.out";
    open my $in, '<', $file or die "Cannot open $file: $!\n";
    my $locus = $seg->{offset};
    my $blk;

    my $finalize = sub {
        return unless $blk;
        my $b = $blk;
        $blk = undef;
        return unless defined $b->{gstart};
        return if $b->{gstart} < $seg->{keep_from} || $b->{gstart} > $seg->{keep_to};   # 属于相邻分段，丢弃
        $$num_ref++;
        my $new   = "${gene_prefix}_g${$num_ref}";
        my $old   = $b->{old};
        my @lines = @{ $b->{lines} };
        if (defined $b->{gidx}) {
            my $l = $lines[ $b->{gidx} ];
            chomp $l;
            my $hr = defined $b->{hint_ratio} ? $b->{hint_ratio} : 'NA';
            my $is = defined $b->{intron_sup} ? $b->{intron_sup} : 'NA';
            $lines[ $b->{gidx} ] = "$l;hintRatio=$hr;intronSupport=$is\n";
        }
        foreach my $l (@lines) {
            if (defined $old) {
                if ($l =~ /^#/) { $l =~ s/^(# (?:start|end) gene )\Q$old\E\s*$/$1$new\n/; }
                else            { $l =~ s/\b(ID|Parent)=\Q$old\E(?!\w)/$1=$new/g; }
            }
            print $l;
        }
    };

    while (my $line = <$in>) {
        $line =~ s/[\r\n]+$//;
        if ($line =~ /^# start gene (\S+)/) {
            $finalize->();
            $blk = { old => $1, lines => ["$line\n"] };
            next;
        }
        if ($line =~ /^# end gene\b/) {
            if ($blk) { push @{ $blk->{lines} }, "$line\n"; $finalize->(); }
            next;
        }
        if ($line =~ /^#/) {
            next unless $blk;
            $blk->{hint_ratio} = $1 if $line =~ /^# % of transcript supported by hints \(any source\): (\S+)/;
            $blk->{intron_sup} = $1 if $line =~ /^# CDS introns: (\S+)/;
            push @{ $blk->{lines} }, "$line\n";
            next;
        }
        next if $line =~ /^\s*$/;
        my @f = split /\t/, $line;
        next if @f < 9;
        $f[3] += $locus;
        $f[4] += $locus;
        $f[2] = 'mRNA' if $f[2] eq 'transcript';
        if ($f[2] eq 'gene') {
            if (!$blk || defined $blk->{gstart}) { $finalize->(); $blk = { lines => [] }; }
            $blk->{gstart} = $f[3];
            $blk->{gidx}   = scalar @{ $blk->{lines} };
            $blk->{old}    = $1 if $f[8] =~ /ID=([^;\s]+)/;
        }
        elsif (!$blk) { next; }
        push @{ $blk->{lines} }, join("\t", @f) . "\n";
    }
    close $in;
    $finalize->();
}

########################################################################
# 英文用法说明（放在文件最末尾，运行时通过DATA文件句柄读取）
########################################################################
__DATA__
Usage:
    perl $0 [options] genome.fasta hints.gff

    The program splits the genome sequences and the hints into segments, runs augustus on all segments in parallel with a built-in Perl worker pool (fork), so no external ParaFly is needed, and finally merges the parallel results into the final GFF3 written to STDOUT. The input hints.gff file does not need to be sorted, and genes lying in the overlapping regions of adjacent segments are reported only once.

    --species <string>    default: None
    Set the name of the Augustus species (HMM model) used for gene prediction. This parameter is required.

    --cpu <int>    default: 1
    Set the number of augustus processes running in parallel.

    --segmentSize <int>    default: 5000000
    Each sequence is predicted separately; if a sequence is longer than this value (5Mb by default), it is cut into segments of this size before gene prediction.

    --overlapSize <int>    default: 100000
    Set the overlap length between two adjacent segments (100kb by default); it must be smaller than --segmentSize. A gene lying in an overlap is kept only once, decided by its start position relative to the midpoint of the overlap.

    --tmp_dir <string>    default: aug_para_with_hints.tmp
    Set the temporary directory. When the program is re-run with the same directory and options, segments that have already finished successfully are skipped (resume).

    --gene_prefix <string>    default: augustus
    Set the prefix of the final gene IDs, e.g. augustus_g1, augustus_g2.

    --alternatives_from_evidence    default: None
    If set, Augustus performs alternative splicing analysis based on the hints evidence.

    --min_intron_len <int>    default: 20
    Set the minimum intron length used by augustus.

    --AUGUSTUS_CONFIG_PATH <string>    default: None
    Set the path of the AUGUSTUS configuration directory, which must contain a subdirectory named species holding the species folders. Setting it allows species configurations to be stored in a writable location. It takes priority over the $AUGUSTUS_CONFIG_PATH environment variable; the directory must also contain cgp, extrinsic, model, parameters and profile, which are needed when running etraining/augustus.

    --help
    Show this help message in English and exit.

    --chinese_help
