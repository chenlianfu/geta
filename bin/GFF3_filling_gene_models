#!/usr/bin/env perl
use strict;
use warnings;
no warnings 'numeric';
use Getopt::Long;
use Cwd qw/abs_path/;
use File::Basename;

my $usage = <<USAGE;
Usage:
    $0 [options] genome.fasta target.gff3 supplementary.gff3 > target_filled.gff3

    程序利用 supplementary.gff3 中的编码蛋白基因模型信息，对 target.gff3 文件中
    不完整编码蛋白基因模型的缺失末端进行填补。程序将 target.gff3 填补后的结果输出
    到标准输出；可通过 --output_filling_detail_tab 参数以表格形式给出填补的 mRNA
    信息；标准错误输出中给出统计信息。

    程序使用须知：
    （1）程序主要读取编码基因模型中的 CDS 信息，要求输入文件中必须有 CDS 信息。
         程序根据 CDS 计算出 intron 再进行后续分析，可以允许输入文件中没有 intron
         信息。
    （2）程序并不会输出 supplementary.gff3 中特有的基因模型，若需要输出，可以考虑
         本程序运行完毕后使用 GFF3Clear 命令整合 target_filled.gff3 和
         supplementary.gff3 文件。
    （3）程序最终输出 target.gff3 中所有的基因模型。

    程序进行填补的原理：
    （1）首先，通过 genome.fasta 信息分析 target.gff3 中 5' 或 3' 缺失的基因模型；
    （2）对于多 CDS 基因模型，分析 5' 或 3' 缺失末端的最临近 intron 和紧邻其后
         CDS 的起始读码框，在 supplementary.gff3 中找具有相同信息且末端更完整的
         基因模型进行填补；
    （3）对于单 CDS 基因模型，则在 supplementary.gff3 中找和缺失末端有重叠且末端
         更完整的基因模型进行填补。

    程序用途：
    （1）利用同源蛋白基因预测结果，对转录本预测基因模型进行填补；
    （2）利用 ab initio 基因预测，对转录本或同源蛋白预测的基因模型进行填补。

    本程序内置基于 Perl fork() 的并行化能力（--cpu 参数），按染色体和正负链对
    数据进行切分后并行处理。

    --cpu <int>    default: 1
    设置并行进程数。设为 1 时为纯串行模式。

    --output_filling_detail_tab <string>    default: None
    添加该参数，输出一个表格文件，包含相应的蛋白对转录本基因模型填补的信息。

    --start_codon <string>    default: ATG
    设置起始密码子。若有多个起始密码子，则使用逗号分割。

    --stop_codon <string>    default: TAA,TAG,TGA
    设置终止密码子。若有多个终止密码子，则使用逗号分割。

    --attribute_for_filling_complete <string>    default: None
    添加该参数，用于给补齐 mRNA 在 GFF3 第 9 列添加 attribute 标签信息。例如，
    使用同源蛋白进行补齐，设置 Filled_by_homolog=True。

    --help    default: None
    display this help and exit.

USAGE
if (@ARGV == 0) { die $usage }

my ($cpu, $start_codon_str, $stop_codon_str, $output_filling_detail_tab, $attribute_for_filling_complete, $help_flag);
GetOptions(
    "cpu:i"                             => \$cpu,
    "start_codon:s"                     => \$start_codon_str,
    "stop_codon:s"                      => \$stop_codon_str,
    "output_filling_detail_tab:s"       => \$output_filling_detail_tab,
    "ouput_filling_detail_tab:s"        => \$output_filling_detail_tab,   # 兼容旧的拼写错误参数名
    "attribute_for_filling_complete:s"  => \$attribute_for_filling_complete,
    "help"                              => \$help_flag,
) or die $usage;

die $usage if $help_flag;
die $usage unless @ARGV >= 3;

$start_codon_str ||= "ATG";
$stop_codon_str  ||= "TAA,TAG,TGA";
$cpu             ||= 1;
$cpu = 1 if $cpu < 1;

my %START_CODON = map { $_ => 1 } split /,/, $start_codon_str;
my %STOP_CODON  = map { $_ => 1 } split /,/, $stop_codon_str;

my $genome             = abs_path($ARGV[0]);
my $target_GFF3        = abs_path($ARGV[1]);
my $supplementary_GFF3 = abs_path($ARGV[2]);
$output_filling_detail_tab = abs_path($output_filling_detail_tab) if defined $output_filling_detail_tab;

# ---------------------------------------------------------------------------
# 全局（file-scope）变量：process_partition() 在处理每个分区前会重置它们，
# 供下面几个"核心算法子程序"（analysis_geneModels_integrity / get_content 等）
# 直接读取，行为上等价于原两个脚本中的文件级全局变量。
# 由于分区之间要么串行依次执行、要么由 fork 出的独立子进程各自处理（各自拥有
# 独立内存），不会出现并发写同一份全局变量的问题。
# ---------------------------------------------------------------------------
our %seq;               # 当前分区对应染色体的序列： $seq{$chr}
our %start_codon;       # 起始密码子集合
our %stop_codon;        # 终止密码子集合
our %gff3_score_attr;   # 原始 score/attribute 信息： "$chr\t$strand\t$type\t$start\t$end" => {score=>.., attr=>..}

%start_codon = %START_CODON;
%stop_codon  = %STOP_CODON;

# ---------------------------------------------------------------------------
# 读取基因组序列，同时记录染色体在文件中出现的顺序（用于保持输出顺序稳定）
# ---------------------------------------------------------------------------
my (%genome_seq, @chr_order, %seen_chr);
{
    my $id;
    open my $fh, "<", $genome or die "Error: Can not open file $genome: $!\n";
    while (<$fh>) {
        chomp;
        if (/^>(\S+)/) {
            $id = $1;
            $genome_seq{$id} = '';
            push @chr_order, $id unless $seen_chr{$id}++;
        }
        else {
            $genome_seq{$id} .= $_;
        }
    }
    close $fh;
}

# ---------------------------------------------------------------------------
# 按 (染色体, 正负链) 对 target.gff3 / supplementary.gff3 的原始行进行分组
# ---------------------------------------------------------------------------
my (%target_lines, %supplementary_lines);
foreach my $pair ( [$target_GFF3, \%target_lines], [$supplementary_GFF3, \%supplementary_lines] ) {
    my ($file, $href) = @$pair;
    open my $fh, "<", $file or die "Error: Can not open file $file: $!\n";
    while (<$fh>) {
        next if /^#/;
        next if /^\s*$/;
        my @f = split /\t/;
        next unless @f >= 8;
        push @chr_order, $f[0] unless $seen_chr{$f[0]}++;
        $href->{$f[0]}{$f[6]} .= $_;
    }
    close $fh;
}

# ---------------------------------------------------------------------------
# 构造并行任务分区：只对 target.gff3 中真实存在基因模型的 (chr, strand) 建任务
# ---------------------------------------------------------------------------
my @partitions;
foreach my $chr (@chr_order) {
    foreach my $strand ("+", "-") {
        my $t = $target_lines{$chr}{$strand};
        next unless defined $t && length $t;
        push @partitions, {
            chr    => $chr,
            strand => $strand,
            seq    => $genome_seq{$chr},
            target => $t,
            supp   => ( $supplementary_lines{$chr}{$strand} // '' ),
        };
    }
}

# ---------------------------------------------------------------------------
# 调度执行：分区数不多或 --cpu <= 1 时直接串行处理；否则用 fork() 并行处理。
# ---------------------------------------------------------------------------
my (@gff3_results, @tab_results);

if ( $cpu <= 1 || @partitions <= 1 ) {
    foreach my $p (@partitions) {
        my ($gff3_out, $tab_out) = process_partition($p, $attribute_for_filling_complete);
        push @gff3_results, $gff3_out;
        push @tab_results,  $tab_out;
    }
}
else {
    run_partitions_in_parallel(\@partitions, $cpu, $attribute_for_filling_complete, \@gff3_results, \@tab_results);
}

# ---------------------------------------------------------------------------
# 输出最终结果
# ---------------------------------------------------------------------------
print @gff3_results;

my $tab_all = join('', @tab_results);
if ( defined $output_filling_detail_tab ) {
    open my $oh, ">", $output_filling_detail_tab or die "Error: Can not create file $output_filling_detail_tab: $!\n";
    print $oh $tab_all;
    close $oh;
}

print STDERR summarize_stats($tab_all);


# =============================================================================
# 并行调度：使用 Perl 内置 fork() 实现多进程并行，不依赖任何外部程序。
# 每个子进程独立处理一个分区并将结果写入临时文件，父进程负责调度并发数、
# 回收子进程、并按分区原始顺序合并结果。
# =============================================================================
sub run_partitions_in_parallel {
    my ($partitions, $cpu, $attribute_for_filling_complete, $gff3_results, $tab_results) = @_;

    my $tmp_dir = "tmp_GFF3_filling_" . time() . "_$$";
    mkdir $tmp_dir or die "Error: Can not create tmp dir $tmp_dir: $!\n";
    $tmp_dir = abs_path($tmp_dir);

    my @pending = 0 .. $#$partitions;
    my %pid2idx;
    my %result_file;
    my $running = 0;

    my $launch_one = sub {
        my $idx = shift;
        my $gff3_file = "$tmp_dir/part_$idx.gff3";
        my $tab_file  = "$tmp_dir/part_$idx.tab";
        $result_file{$idx} = [$gff3_file, $tab_file];

        my $pid = fork();
        die "Error: fork() failed: $!\n" unless defined $pid;

        if ( $pid == 0 ) {
            # ------------------ 子进程 ------------------
            my ($gff3_out, $tab_out) = eval {
                process_partition($partitions->[$idx], $attribute_for_filling_complete);
            };
            if ($@) {
                warn "Error while processing partition $idx ($partitions->[$idx]{chr}/$partitions->[$idx]{strand}): $@";
                $gff3_out = '';
                $tab_out  = '';
            }
            open my $oh, ">", $gff3_file or die "Error: Can not write $gff3_file: $!\n";
            print $oh $gff3_out;
            close $oh;
            open my $th, ">", $tab_file or die "Error: Can not write $tab_file: $!\n";
            print $th $tab_out;
            close $th;
            exit(0);
        }
        return $pid;
    };

    while ( @pending || $running > 0 ) {
        while ( $running < $cpu && @pending ) {
            my $idx = shift @pending;
            my $pid = $launch_one->($idx);
            $pid2idx{$pid} = $idx;
            $running++;
        }
        if ( $running > 0 ) {
            my $pid = waitpid(-1, 0);
            if ( $pid > 0 && exists $pid2idx{$pid} ) {
                delete $pid2idx{$pid};
                $running--;
            }
        }
    }

    # 按分区原始顺序（即染色体在输入文件中出现的顺序、"+"链在前"-"链在后）合并结果
    for my $idx ( 0 .. $#$partitions ) {
        my ($gff3_file, $tab_file) = @{ $result_file{$idx} };
        push @$gff3_results, read_whole_file($gff3_file);
        push @$tab_results,  read_whole_file($tab_file);
    }

    unlink glob("$tmp_dir/*");
    rmdir $tmp_dir;
}

sub read_whole_file {
    my $file = shift;
    return '' unless -e $file;
    open my $fh, "<", $file or die "Error: Can not open file $file: $!\n";
    local $/;
    my $content = <$fh>;
    close $fh;
    return defined $content ? $content : '';
}


# =============================================================================
# 核心处理逻辑：处理单个 (染色体, 正负链) 分区，返回 (填补后的GFF3文本, 填补详情表文本)。
# 该子程序既可在串行模式下直接调用，也可在 fork 出的子进程中调用。
# =============================================================================
sub process_partition {
    my ($p, $attribute_for_filling_complete) = @_;
    my ($chr, $strand, $target_text, $supp_text) = ($p->{chr}, $p->{strand}, $p->{target}, $p->{supp});

    # 重置本分区使用的"全局"变量
    %seq = ( $chr => $p->{seq} );
    %gff3_score_attr = ();

    my $gff3_out = '';
    my $tab_out  = '';

    # ---------------- 解析 supplementary 基因模型（仅限该 chr+strand） ----------------
    my %supplementary_info = get_geneModels_from_GFF3_text($supp_text, 0);

    # 对 supplementary 每个基因模型进行解析，获得每个 intron+frame 上下游 CDSs 信息，
    # 以及每个 CDS 上下游 CDSs 信息（原理见文件头注释与原程序说明）。
    my (%up_stream_of_intron, %down_stream_of_intron, %up_stream_of_CDS, %down_stream_of_CDS);
    foreach my $gene_ID ( sort keys %supplementary_info ) {
        my @mRNA_ID = @{ $supplementary_info{$gene_ID}{"mRNA_ID"} || [] };
        foreach my $mRNA_ID ( sort @mRNA_ID ) {
            my $mRNA_info = $supplementary_info{$gene_ID}{"mRNA_info"}{$mRNA_ID};
            next unless defined $mRNA_info;

            my @CDS;
            foreach ( split /\n/, $mRNA_info ) {
                my @f = split /\t/;
                push @CDS, "$f[3]\t$f[4]\t$f[7]" if @f >= 8 && $f[2] eq "CDS";
            }
            next unless @CDS;

            if ( @CDS > 1 ) {
                my @intron = get_intron(\@CDS);

                my @CDS_and_intron = (@CDS, @intron);
                @CDS_and_intron = sort { $a <=> $b } @CDS_and_intron;
                @CDS_and_intron = sort { $b <=> $a } @CDS_and_intron if $strand eq "-";

                my (@upstream_CDS, $CDS_frame);
                while (@CDS_and_intron) {
                    my $one = shift @CDS_and_intron;
                    my @one = split /\t/, $one;
                    if ( defined $one[2] ) {
                        push @upstream_CDS, $one;
                        $CDS_frame = $one[2];
                    }
                    else {
                        my @left_CDS;
                        foreach (@CDS_and_intron) {
                            my @g = split /\t/;
                            push @left_CDS, $_ if @g >= 3;
                        }

                        my $next_CDS = shift @CDS_and_intron;
                        last unless defined $next_CDS;
                        my @CDS_info = split /\t/, $next_CDS;
                        $CDS_frame = $CDS_info[2];

                        my $up_stream_of_intron_out   = join "\n", ($mRNA_ID, @upstream_CDS);
                        my $down_stream_of_intron_out = join "\n", ($mRNA_ID, @left_CDS);
                        my $intron_out = "$chr\t$strand\t$one\t$CDS_frame";

                        # supplementary.gff3 中包含可变剪接信息时，优先选择字符数最多（即 CDS 数量最多）的
                        if ( !exists $up_stream_of_intron{$intron_out}
                            || length($up_stream_of_intron_out) > length($up_stream_of_intron{$intron_out}) ) {
                            $up_stream_of_intron{$intron_out} = $up_stream_of_intron_out;
                        }
                        if ( !exists $down_stream_of_intron{$intron_out}
                            || length($down_stream_of_intron_out) > length($down_stream_of_intron{$intron_out}) ) {
                            $down_stream_of_intron{$intron_out} = $down_stream_of_intron_out;
                        }

                        push @upstream_CDS, $next_CDS;
                    }
                }
            }

            # 解析 CDS 上下游 CDSs 信息，一个 CDS 上游/下游的 CDSs 包含它自己
            my @CDS_sorted = sort { $a <=> $b } @CDS;
            @CDS_sorted = sort { $b <=> $a } @CDS_sorted if $strand eq "-";
            my @upstream_CDS;
            my @CDS_remaining = @CDS_sorted;
            while (@CDS_remaining) {
                my @down_CDS = @CDS_remaining;
                my $one = shift @CDS_remaining;
                my @up_CDS = (@upstream_CDS, $one);

                my @f = split /\t/, $one;
                my ($int1, $int2) = (int($f[0] / 1000), int($f[1] / 1000));
                ($int1, $int2) = ($int2, $int1) if $int1 > $int2;
                foreach my $index ( $int1 .. $int2 ) {
                    my $up_stream_of_CDS_out   = join "\n", ($mRNA_ID, @up_CDS);
                    my $down_stream_of_CDS_out = join "\n", ($mRNA_ID, @down_CDS);
                    if ( !exists $up_stream_of_CDS{$chr}{$strand}{$index}{$one}
                        || length($up_stream_of_CDS_out) > length($up_stream_of_CDS{$chr}{$strand}{$index}{$one}) ) {
                        $up_stream_of_CDS{$chr}{$strand}{$index}{$one} = $up_stream_of_CDS_out;
                    }
                    if ( !exists $down_stream_of_CDS{$chr}{$strand}{$index}{$one}
                        || length($down_stream_of_CDS_out) > length($down_stream_of_CDS{$chr}{$strand}{$index}{$one}) ) {
                        $down_stream_of_CDS{$chr}{$strand}{$index}{$one} = $down_stream_of_CDS_out;
                    }
                }
                push @upstream_CDS, $one;
            }
        }
    }

    # ---------------- 解析 target 基因模型（仅限该 chr+strand） ----------------
    my %target_info = get_geneModels_from_GFF3_text($target_text, 1);

    foreach my $gene_ID ( sort keys %target_info ) {
        my @gene_header = split /\t/, $target_info{$gene_ID}{"header"};
        my ($gene_start, $gene_end) = ($gene_header[3], $gene_header[4]);
        my $mRNA_out = '';

        foreach my $mRNA_ID ( sort @{ $target_info{$gene_ID}{"mRNA_ID"} || [] } ) {
            my $mRNA_info   = $target_info{$gene_ID}{"mRNA_info"}{$mRNA_ID};
            my $mRNA_header = $target_info{$gene_ID}{"mRNA_header"}{$mRNA_ID};
            next unless defined $mRNA_info && defined $mRNA_header;
            my @mRNA_header = split /\t/, $mRNA_header;

            my ($m_chr, $source, $m_strand) = ($mRNA_header[0], $mRNA_header[1], $mRNA_header[6]);

            my @CDS;
            foreach ( split /\n/, $mRNA_info ) {
                my @f = split /\t/;
                push @CDS, "$f[3]\t$f[4]\t$f[7]" if @f >= 8 && $f[2] eq "CDS";
            }
            next unless @CDS;

            my $integrity = analysis_geneModels_integrity(\@CDS, $m_chr, $m_strand);

            if ( @CDS > 1 ) {
                # ---------- 多 CDS 基因模型填补 ----------
                my @intron = get_intron(\@CDS);
                @intron = sort { $a <=> $b } @intron;
                @intron = sort { $b <=> $a } @intron if $m_strand eq "-";
                @CDS = sort { $a <=> $b } @CDS;
                @CDS = sort { $b <=> $a } @CDS if $m_strand eq "-";

                if ( @intron && ( $integrity eq "5prime_partial" or $integrity eq "internal" ) ) {
                    my @f = split /\t/, $CDS[1];
                    my $intron_key = "$m_chr\t$m_strand\t$intron[0]\t$f[2]";
                    if ( exists $up_stream_of_intron{$intron_key} ) {
                        my @fill_CDS     = split /\n/, $up_stream_of_intron{$intron_key};
                        my $fill_mRNA_ID = shift @fill_CDS;

                        my (undef, $pos2_0) = split /\t/, $CDS[0];
                        my ($pos1_0) = split /\t/, $CDS[0];
                        my $len1 = $pos2_0 - $pos1_0 + 1;
                        my ($pos1_f, $pos2_f) = split /\t/, $fill_CDS[-1];
                        my $len2 = $pos2_f - $pos1_f + 1;

                        if ( $len2 > $len1 or ( $len2 == $len1 && @fill_CDS > 1 ) ) {
                            shift @CDS;
                            unshift @CDS, @fill_CDS;
                            $tab_out .= "$gene_ID\t$mRNA_ID\tMulti_CDS\t$integrity\tFilled_5p\t$fill_mRNA_ID\n";
                        }
                    }
                }
                if ( @intron && ( $integrity eq "3prime_partial" or $integrity eq "internal" ) ) {
                    my @f = split /\t/, $CDS[-1];
                    my $intron_key = "$m_chr\t$m_strand\t$intron[-1]\t$f[2]";
                    if ( exists $down_stream_of_intron{$intron_key} ) {
                        my @fill_CDS     = split /\n/, $down_stream_of_intron{$intron_key};
                        my $fill_mRNA_ID = shift @fill_CDS;

                        my ($pos1_l, $pos2_l) = split /\t/, $CDS[-1];
                        my $len1 = $pos2_l - $pos1_l + 1;
                        my ($pos1_f, $pos2_f) = split /\t/, $fill_CDS[0];
                        my $len2 = $pos2_f - $pos1_f + 1;

                        if ( $len2 > $len1 or ( $len2 == $len1 && @fill_CDS > 1 ) ) {
                            pop @CDS;
                            push @CDS, @fill_CDS;
                            $tab_out .= "$gene_ID\t$mRNA_ID\tMulti_CDS\t$integrity\tFilled_3p\t$fill_mRNA_ID\n";
                        }
                    }
                }
            }
            else {
                # ---------- 单 CDS 基因模型填补 ----------
                # 5' 端填补：独立作用域，避免与下面 3' 端填补逻辑发生变量遮蔽
                {
                    my ($start, $end, $frame) = split /\t/, $CDS[0];
                    my @candidate_CDS;
                    my ($index1, $index2) = ( int($start / 1000), int($end / 1000) );
                    foreach my $index ( $index1 .. $index2 ) {
                        foreach ( keys %{ $up_stream_of_CDS{$m_chr}{$m_strand}{$index} || {} } ) {
                            push @candidate_CDS, $up_stream_of_CDS{$m_chr}{$m_strand}{$index}{$_};
                        }
                    }
                    my %len_of;
                    foreach (@candidate_CDS) { $len_of{$_} = length($_); }
                    @candidate_CDS = sort { $len_of{$b} <=> $len_of{$a} or $a cmp $b } @candidate_CDS;

                    if ( $integrity eq "5prime_partial" or $integrity eq "internal" ) {
                        foreach (@candidate_CDS) {
                            my @fill_CDS     = split /\n/, $_;
                            my $fill_mRNA_ID = shift @fill_CDS;
                            my $test_fill_CDS = pop @fill_CDS;
                            my ( $fill_CDS_start, $fill_CDS_end, $fill_CDS_frame ) = split /\t/, $test_fill_CDS;

                            next unless $start <= $fill_CDS_end && $end >= $fill_CDS_start;

                            if ( $m_strand eq "+" && ( $fill_CDS_start < $start or ( $fill_CDS_start == $start && @fill_CDS > 1 ) ) ) {
                                my $add_frame = $fill_CDS_frame;
                                $add_frame = 1 if $add_frame == 2; $add_frame = 2 if $add_frame == 1;
                                my $extra_bp_num = ( $start - $fill_CDS_start + $add_frame ) % 3;
                                $extra_bp_num = 1 if $extra_bp_num == 2; $extra_bp_num = 2 if $extra_bp_num == 1;
                                if ( $extra_bp_num == $frame ) {
                                    my $first_CDS = shift @CDS;
                                    my (undef, $first_end) = split /\t/, $first_CDS;
                                    unshift @CDS, "$fill_CDS_start\t$first_end\t$fill_CDS_frame";
                                    unshift @CDS, @fill_CDS;
                                    $tab_out .= "$gene_ID\t$mRNA_ID\tSingle_CDS\t$integrity\tFilled_5p\t$fill_mRNA_ID\n";
                                    last;
                                }
                            }
                            if ( $m_strand eq "-" && ( $fill_CDS_end > $end or ( $fill_CDS_end == $end && @fill_CDS > 1 ) ) ) {
                                my $add_frame = $fill_CDS_frame;
                                $add_frame = 1 if $add_frame == 2; $add_frame = 2 if $add_frame == 1;
                                my $extra_bp_num = ( $fill_CDS_end - $end + $add_frame ) % 3;
                                $extra_bp_num = 1 if $extra_bp_num == 2; $extra_bp_num = 2 if $extra_bp_num == 1;
                                if ( $extra_bp_num == $frame ) {
                                    my $first_CDS = shift @CDS;
                                    my ($first_start) = split /\t/, $first_CDS;
                                    unshift @CDS, "$first_start\t$fill_CDS_end\t$fill_CDS_frame";
                                    unshift @CDS, @fill_CDS;
                                    $tab_out .= "$gene_ID\t$mRNA_ID\tSingle_CDS\t$integrity\tFilled_5p\t$fill_mRNA_ID\n";
                                    last;
                                }
                            }
                        }
                    }
                }

                # 3' 端填补：独立作用域
                {
                    my ($start, $end, $frame) = split /\t/, $CDS[-1];
                    my @candidate_CDS;
                    my ($index1, $index2) = ( int($start / 1000), int($end / 1000) );
                    foreach my $index ( $index1 .. $index2 ) {
                        foreach ( keys %{ $down_stream_of_CDS{$m_chr}{$m_strand}{$index} || {} } ) {
                            push @candidate_CDS, $down_stream_of_CDS{$m_chr}{$m_strand}{$index}{$_};
                        }
                    }
                    my %len_of;
                    foreach (@candidate_CDS) { $len_of{$_} = length($_); }
                    @candidate_CDS = sort { $len_of{$b} <=> $len_of{$a} or $a cmp $b } @candidate_CDS;

                    if ( $integrity eq "3prime_partial" or $integrity eq "internal" ) {
                        foreach (@candidate_CDS) {
                            my @fill_CDS      = split /\n/, $_;
                            my $fill_mRNA_ID  = shift @fill_CDS;
                            my $test_fill_CDS = shift @fill_CDS;
                            my ( $fill_CDS_start, $fill_CDS_end, $fill_CDS_frame ) = split /\t/, $test_fill_CDS;

                            next unless $start <= $fill_CDS_end && $end >= $fill_CDS_start;

                            if ( $m_strand eq "+" && ( $fill_CDS_end > $end or ( $fill_CDS_end == $end && @fill_CDS > 1 ) ) ) {
                                my $add_frame = $fill_CDS_frame;
                                $add_frame = 1 if $add_frame == 2; $add_frame = 2 if $add_frame == 1;
                                my $fill_CDS_frame_new = ( $end - $fill_CDS_start + 1 + $add_frame ) % 3;
                                my $add_frame2 = $frame;
                                $add_frame2 = 1 if $add_frame2 == 2; $add_frame2 = 2 if $add_frame2 == 1;
                                my $frame_new = ( $end - $start + 1 + $add_frame2 ) % 3;
                                if ( $fill_CDS_frame_new == $frame_new ) {
                                    my $last_CDS = pop @CDS;
                                    my ($last_start) = split /\t/, $last_CDS;
                                    push @CDS, "$last_start\t$fill_CDS_end\t$frame";
                                    push @CDS, @fill_CDS;
                                    $tab_out .= "$gene_ID\t$mRNA_ID\tSingle_CDS\t$integrity\tFilled_3p\t$fill_mRNA_ID\n";
                                    last;
                                }
                            }
                            if ( $m_strand eq "-" && ( $fill_CDS_start < $start or ( $fill_CDS_start == $start && @fill_CDS > 1 ) ) ) {
                                my $add_frame = $fill_CDS_frame;
                                $add_frame = 1 if $add_frame == 2; $add_frame = 2 if $add_frame == 1;
                                my $fill_CDS_frame_new = ( $fill_CDS_end - $start + 1 + $add_frame ) % 3;
                                my $add_frame2 = $frame;
                                $add_frame2 = 1 if $add_frame2 == 2; $add_frame2 = 2 if $add_frame2 == 1;
                                my $frame_new = ( $end - $start + 1 + $add_frame2 ) % 3;
                                if ( $fill_CDS_frame_new == $frame_new ) {
                                    my $last_CDS = pop @CDS;
                                    my (undef, $last_end) = split /\t/, $last_CDS;
                                    push @CDS, "$fill_CDS_start\t$last_end\t$frame";
                                    push @CDS, @fill_CDS;
                                    $tab_out .= "$gene_ID\t$mRNA_ID\tSingle_CDS\t$integrity\tFilled_3p\t$fill_mRNA_ID\n";
                                    last;
                                }
                            }
                        }
                    }
                }
            }

            # 分析 mRNA 的 exon 信息
            my @exon;
            foreach ( split /\n/, $mRNA_info ) {
                my @f = split /\t/;
                push @exon, "$f[3]\t$f[4]" if @f >= 5 && $f[2] eq "exon";
            }

            @exon = sort { $a <=> $b } @exon;
            @CDS  = sort { $a <=> $b } @CDS;
            my $mRNA_exons = join "\n", @exon;
            my $mRNA_CDSs  = join "\n", @CDS;
            my ($mRNA_start, $mRNA_end, $mRNA_content) =
                get_mRNA_info($mRNA_CDSs, $mRNA_exons, $mRNA_ID, $m_chr, $m_strand, $source);
            $mRNA_header[3] = $mRNA_start;
            $mRNA_header[4] = $mRNA_end;
            $mRNA_header = join "\t", @mRNA_header;

            if ( $integrity ne "complete" ) {
                my $integrity_new = analysis_geneModels_integrity(\@CDS, $m_chr, $m_strand);
                if ( $integrity_new eq "complete" ) {
                    $tab_out .= "Filled_to_complete: $gene_ID\n";
                    $mRNA_header =~ s/\;?\s*$/;$attribute_for_filling_complete;\n/ if defined $attribute_for_filling_complete;
                }
            }

            $mRNA_out .= $mRNA_header;
            $mRNA_out .= $mRNA_content;

            $gene_start = $mRNA_start if $gene_start > $mRNA_start;
            $gene_end   = $mRNA_end   if $mRNA_end > $gene_end;
        }

        $mRNA_out = correct_ends_of_transcript_and_exon($mRNA_out, $gene_start, $gene_end);

        $gene_header[3] = $gene_start;
        $gene_header[4] = $gene_end;
        $gff3_out .= join("\t", @gene_header);
        $gff3_out .= "$mRNA_out\n";
    }

    return ($gff3_out, $tab_out);
}


# =============================================================================
# 统计信息汇总（对应原并行脚本尾部的统计逻辑，改用 scalar(keys %hash) 计数，
# 避免旧式 "my $n = %hash;" 写法在不同 Perl 版本间的语义差异）
# =============================================================================
sub summarize_stats {
    my $tab_all = shift;

    my (%gene, %mRNA, %Multi_CDS, %Multi_CDS_5p, %Multi_CDS_3p, %Multi_CDS_internal,
        %Single_CDS, %Single_CDS_5p, %Single_CDS_3p, %Single_CDS_internal, %filled_complete);

    foreach my $line ( split /\n/, $tab_all ) {
        if ( $line =~ /^Filled_to_complete:\s*(\S+)/ ) {
            $filled_complete{$1} = 1;
            next;
        }
        next unless $line =~ /\t/;
        my @f = split /\t/, $line;
        next unless @f >= 4;

        $gene{ $f[0] } = 1;
        $mRNA{ $f[1] } = 1;

        if ( $f[2] eq "Multi_CDS" ) {
            $Multi_CDS{ $f[0] } = 1;
            $Multi_CDS_5p{ $f[0] }       = 1 if $f[3] eq "5prime_partial";
            $Multi_CDS_3p{ $f[0] }       = 1 if $f[3] eq "3prime_partial";
            $Multi_CDS_internal{ $f[0] } = 1 if $f[3] eq "internal";
        }
        elsif ( $f[2] eq "Single_CDS" ) {
            $Single_CDS{ $f[0] } = 1;
            $Single_CDS_5p{ $f[0] }       = 1 if $f[3] eq "5prime_partial";
            $Single_CDS_3p{ $f[0] }       = 1 if $f[3] eq "3prime_partial";
            $Single_CDS_internal{ $f[0] } = 1 if $f[3] eq "internal";
        }
    }

    return sprintf(
        "对 %d 个基因的 %d 个mRNA进行了末端填补，其中有 %d 个基因填补完整。\n" .
        "对 %d 个多CDS基因进行了末端填补，其中5prime_partial，3prime_partial和internal的基因数量分别为：%d, %d, %d。\n" .
        "对 %d 个单CDS基因模型进行了末端填补，其中5prime_partial，3prime_partial和internal的基因数量分别为：%d，%d，%d。\n",
        scalar( keys %gene ), scalar( keys %mRNA ), scalar( keys %filled_complete ),
        scalar( keys %Multi_CDS ), scalar( keys %Multi_CDS_5p ), scalar( keys %Multi_CDS_3p ), scalar( keys %Multi_CDS_internal ),
        scalar( keys %Single_CDS ), scalar( keys %Single_CDS_5p ), scalar( keys %Single_CDS_3p ), scalar( keys %Single_CDS_internal ),
    );
}


# =============================================================================
# 以下为核心算法子程序
# =============================================================================

# 解析基因的完整性：complete / 5prime_partial / 3prime_partial / internal
sub analysis_geneModels_integrity {
    my @CDS = @{ $_[0] };
    my ( $chr, $strand ) = ( $_[1], $_[2] );

    @CDS = sort { $a <=> $b } @CDS;
    my $cds_seq = '';
    foreach (@CDS) {
        my @f = split /\t/;
        $cds_seq .= substr( $seq{$chr}, $f[0] - 1, $f[1] - $f[0] + 1 );
    }
    if ( $strand eq "-" ) {
        $cds_seq = reverse $cds_seq;
        $cds_seq =~ tr/ATCGatcgn/TAGCTAGCN/;
    }

    my $out;
    if ( $cds_seq =~ m/^(\w{3})/ && exists $start_codon{$1} ) {
        if ( $cds_seq =~ m/(\w{3})$/ && exists $stop_codon{$1} ) {
            $out = "complete";
        }
        else {
            $out = "3prime_partial";
        }
    }
    elsif ( $cds_seq =~ m/(\w{3})$/ && exists $stop_codon{$1} ) {
        $out = "5prime_partial";
    }
    else {
        $out = "internal";
    }
    return $out;
}

# 根据一组 CDS/exon 区间，得到其间的 intron 区间列表
sub get_intron {
    my @exon = @{ $_[0] };
    @exon = sort { $a <=> $b } @exon;

    my @intron;
    my $first_exon = shift @exon;
    my ( undef, $last_end ) = split /\t/, $first_exon;
    foreach (@exon) {
        my ( $start, $end ) = split /\t/;
        if ( $start > $last_end + 1 ) {
            push @intron, ( $last_end + 1 ) . "\t" . ( $start - 1 );
        }
        $last_end = $end;
    }
    return @intron;
}

# 从一段 GFF3 文本（多行）中解析出以 gene 为单位的基因模型信息结构：
#   $gene_info{gene_ID}{header}                 => gene 那一行原始文本
#   $gene_info{gene_ID}{mRNA_ID}                 => [mRNA_ID, ...]
#   $gene_info{gene_ID}{mRNA_header}{mRNA_ID}    => mRNA 那一行原始文本
#   $gene_info{gene_ID}{mRNA_info}{mRNA_ID}      => 该 mRNA 下 CDS/exon 等行拼接的文本
# $capture_attr 为真时，同时把 CDS/exon 的原始 score/attribute 记录到 %gff3_score_attr，
# 供输出时尽量保留原始注释信息（仅对 target.gff3 使用，supplementary.gff3 不记录）。
sub get_geneModels_from_GFF3_text {
    my ( $text, $capture_attr ) = @_;
    return () unless defined $text && length $text;

    my @lines = split /(?<=\n)/, $text;
    my %gene_info;

    foreach (@lines) {
        if (/\tgene\t.*ID=([^;\s]+)/) {
            $gene_info{$1}{"header"} = $_;
        }
    }

    my %mRNA_ID2gene_ID;
    foreach (@lines) {
        if (/Parent=([^;\s]+)/) {
            my $parent = $1;
            if ( exists $gene_info{$parent} ) {
                if (/ID=([^;\s]+)/) {
                    push @{ $gene_info{$parent}{"mRNA_ID"} }, $1;
                    $gene_info{$parent}{"mRNA_header"}{$1} = $_;
                    $mRNA_ID2gene_ID{$1} = $parent;
                }
            }
        }
    }

    foreach (@lines) {
        if (/Parent=([^;\s]+)/ && exists $mRNA_ID2gene_ID{$1}) {
            my $parent = $1;
            $gene_info{ $mRNA_ID2gene_ID{$1} }{"mRNA_info"}{$parent} .= $_;

            if ($capture_attr) {
                my @f = split /\t/;
                if ( @f >= 9 && ( $f[2] eq "CDS" || $f[2] eq "exon" ) ) {
                    my $key = "$f[0]\t$f[6]\t$f[2]\t$f[3]\t$f[4]";
                    $gff3_score_attr{$key} = { score => $f[5], attr => get_attr( $f[8] ) };
                }
            }
        }
    }

    return %gene_info;
}

sub get_mRNA_info {
    my ( $mRNA_CDSs, $mRNA_exons, $mRNA_ID, $chr, $strand, $source ) = @_;

    my @CDS  = split /\n/, $mRNA_CDSs;
    my @exon = split /\n/, $mRNA_exons;
    @CDS  = sort { $a <=> $b } @CDS;
    @exon = sort { $a <=> $b } @exon;

    my ( $mRNA_start, $mRNA_end, $mRNA_introns );
    ( $mRNA_start, $mRNA_end, $mRNA_exons, $mRNA_introns ) = modify_exon( \@CDS, \@exon );
    my $mRNA_UTR = get_UTR( \@CDS, \@exon, $strand );

    my $mRNA_content = sort_mRNA_info(
        $chr, $strand, $mRNA_ID, $mRNA_start, $mRNA_end,
        $mRNA_CDSs, $mRNA_exons, $mRNA_introns, $mRNA_UTR, $source
    );

    return ( $mRNA_start, $mRNA_end, $mRNA_content );
}

sub sort_mRNA_info {
    my ( $chr, $strand, $mRNA_ID, $mRNA_start, $mRNA_end, $mRNA_CDSs, $mRNA_exons, $mRNA_introns, $mRNA_UTR, $source ) = @_;

    my ( $mRNA_content, %sort1, %sort2 ) = ('');

    my $add_line = sub {
        my ( $feature_type, $feature_showname, $start, $end, $frame, $num, $sort_num ) = @_;
        my $out_content = get_content( $chr, $source, $feature_type, $start, $end, $strand, $frame, $mRNA_ID, $num, $feature_showname );
        $sort1{$out_content} = $start;
        $sort2{$out_content} = $sort_num;
    };

    my @exon_list  = split /\n/, $mRNA_exons;
    my @CDS_list   = split /\n/, $mRNA_CDSs;
    my @intron_list = split /\n/, $mRNA_introns;
    @exon_list   = reverse @exon_list   if $strand eq "-";
    @CDS_list    = reverse @CDS_list    if $strand eq "-";
    @intron_list = reverse @intron_list if $strand eq "-";

    my $num = 0;
    foreach (@exon_list) {
        $num++;
        my @f = split /\t/;
        $add_line->( "exon", "exon", $f[0], $f[1], '.', $num, 2 );
    }

    ( $num, my $CDS_length, my $frame ) = ( 0, 0, 0 );
    foreach (@CDS_list) {
        $num++;
        my @f = split /\t/;
        $CDS_length += ( abs( $f[1] - $f[0] ) + 1 );
        $add_line->( "CDS", "CDS", $f[0], $f[1], $frame, $num, 3 );
        $frame = $CDS_length % 3;
        if    ( $frame == 1 ) { $frame = 2; }
        elsif ( $frame == 2 ) { $frame = 1; }
    }

    $num = 0;
    foreach (@intron_list) {
        $num++;
        my @f = split /\t/;
        $add_line->( "intron", "intron", $f[0], $f[1], '.', $num, 4 );
    }

    my @UTR_list = split /\n/, $mRNA_UTR;
    @UTR_list = reverse @UTR_list if $strand eq "-";
    my ( $num5, $num3 ) = ( 0, 0 );
    foreach (@UTR_list) {
        my @f = split /\t/;
        if ( $f[0] eq "five_prime_UTR" ) {
            $num5++;
            $add_line->( "five_prime_UTR", "utr5p", $f[1], $f[2], '.', $num5, 1 );
        }
        elsif ( $f[0] eq "three_prime_UTR" ) {
            $num3++;
            $add_line->( "three_prime_UTR", "utr3p", $f[1], $f[2], '.', $num3, 5 );
        }
    }

    if ( $strand eq "+" ) {
        foreach ( sort { $sort1{$a} <=> $sort1{$b} or $sort2{$a} cmp $sort2{$b} } keys %sort1 ) {
            $mRNA_content .= $_;
        }
    }
    else {
        foreach ( sort { $sort1{$b} <=> $sort1{$a} or $sort2{$a} <=> $sort2{$b} } keys %sort1 ) {
            $mRNA_content .= $_;
        }
    }

    return $mRNA_content;
}

# 根据 CDS 和 exon 信息得到 UTR。
sub get_UTR {
    my @cds  = @{ $_[0] };
    my @exon = @{ $_[1] };
    my $strand = $_[2];

    my ( @utr, %cds_pos );
    foreach (@cds) {
        my @f = split /\t/;
        $cds_pos{ $f[0] } = 1;
        $cds_pos{ $f[1] } = 1;
    }

    foreach my $one_exon (@exon) {
        my ( $start, $end ) = split /\t/, $one_exon;
        my $utr_keep = 1;
        foreach my $one_cds (@cds) {
            my ( $cds_start, $cds_end ) = split /\t/, $one_cds;
            next unless $cds_start <= $end && $cds_end >= $start;
            $utr_keep = 0;
            push @utr, "$start\t" . ( $cds_start - 1 ) if $start < $cds_start;
            push @utr, ( $cds_end + 1 ) . "\t$end"      if $end > $cds_end;
        }
        push @utr, $one_exon if $utr_keep == 1;
    }

    my @out;
    my @cds_pos = sort { $a <=> $b } keys %cds_pos;
    if (@cds_pos) {
        if ( $strand eq "+" ) {
            @utr = sort { $a <=> $b } @utr;
            foreach (@utr) {
                my @f = split /\t/;
                if    ( $f[1] <= $cds_pos[0] ) { push @out, "five_prime_UTR\t$_"; }
                elsif ( $f[0] >= $cds_pos[-1] ) { push @out, "three_prime_UTR\t$_"; }
            }
        }
        elsif ( $strand eq "-" ) {
            @utr = sort { $b <=> $a } @utr;
            foreach (@utr) {
                my @f = split /\t/;
                if    ( $f[0] >= $cds_pos[-1] ) { push @out, "five_prime_UTR\t$_"; }
                elsif ( $f[1] <= $cds_pos[0] )  { push @out, "three_prime_UTR\t$_"; }
            }
        }
    }

    return join "\n", @out;
}

# 根据一个基因模型的 CDS 信息对 exon 信息进行修正/补全，并给出 mRNA 边界与 intron 信息。
# 要求输入的 CDS 信息正确（CDS 之间不重叠）。
sub modify_exon {
    my @cds  = sort { $a <=> $b } @{ $_[0] };
    my @exon = sort { $a <=> $b } @{ $_[1] };

    my @pos;
    foreach (@cds)  { my @f = split /\t/; push @pos, $f[0], $f[1]; }
    foreach (@exon) { my @f = split /\t/; push @pos, $f[0], $f[1]; }
    @pos = sort { $a <=> $b } @pos;
    my ( $mRNA_start, $mRNA_end ) = ( $pos[0], $pos[-1] );

    my %intron;
    if (@cds) {
        my $first_CDS = shift @cds;
        my ( undef, $last_end ) = split /\t/, $first_CDS;
        foreach (@cds) {
            my ( $start, $end ) = split /\t/;
            if ( $start > $last_end ) {
                my ( $intron_start, $intron_stop ) = ( $last_end + 1, $start - 1 );
                $intron{"$intron_start\t$intron_stop"} = 1 if $intron_stop >= $intron_start;
            }
            $last_end = $end;
        }
    }

    if (@exon) {
        my $first_exon = shift @exon;
        my ( undef, $last_end ) = split /\t/, $first_exon;
        foreach my $exon_line (@exon) {
            my ( $start, $end ) = split /\t/, $exon_line;
            if ( $start > $last_end ) {
                my ( $intron_start, $intron_stop ) = ( $last_end + 1, $start - 1 );
                my $keep_intron = 1;
                foreach ( keys %intron ) {
                    my ( $i1, $i2 ) = split /\t/;
                    $keep_intron = 0 if $i1 <= $intron_stop && $i2 >= $intron_start;
                }
                $intron{"$intron_start\t$intron_stop"} = 1 if ( $keep_intron == 1 && $intron_stop >= $intron_start );
            }
            $last_end = $end;
        }
    }

    my @exon_out;
    my @intron_sorted = sort { $a <=> $b } keys %intron;
    my @intron_out    = @intron_sorted;
    if (@intron_sorted) {
        my $first_intron = shift @intron_sorted;
        my ( $last_start, $last_end ) = split /\t/, $first_intron;
        my $exon_start = $mRNA_start;
        my $exon_end   = $last_start - 1;
        push @exon_out, "$exon_start\t$exon_end";
        $exon_start = $last_end + 1;
        foreach (@intron_sorted) {
            my ( $start, $end ) = split /\t/;
            $exon_end = $start - 1;
            push @exon_out, "$exon_start\t$exon_end";
            $exon_start = $end + 1;
        }
        push @exon_out, "$exon_start\t$mRNA_end";
    }
    else {
        push @exon_out, "$mRNA_start\t$mRNA_end";
    }

    return ( $mRNA_start, $mRNA_end, ( join "\n", @exon_out ), ( join "\n", @intron_out ) );
}

# 提取 GFF3 第 9 列 attribute 中除 ID、Parent 外的其余信息
sub get_attr {
    my $attribute = $_[0];
    return '' unless defined $attribute;
    my @out;
    foreach ( split /;/, $attribute ) {
        next if /^\s*$/;
        s/^\s*//;
        s/\s*$//;
        next if /^ID/i;
        next if /^Parent/i;
        push @out, $_;
    }
    my $out = join ";", @out;
    $out .= ';' if $out;
    return $out;
}

# 生成 GFF3 文件的一行。若该 feature 在原始 target.gff3 中存在（未被同源填补覆盖），
# 则尽量沿用其原始 score / attribute；否则使用默认值。
sub get_content {
    my ( $chr, $source, $feature_type, $start, $end, $strand, $frame, $mRNA_ID, $num, $feature_showname ) = @_;

    my $score = '.';
    my $add_attr = '';
    my $key = "$chr\t$strand\t$feature_type\t$start\t$end";
    if ( exists $gff3_score_attr{$key} ) {
        $score    = $gff3_score_attr{$key}{score} // '.';
        $add_attr = $gff3_score_attr{$key}{attr}  // '';
    }

    return "$chr\t$source\t$feature_type\t$start\t$end\t$score\t$strand\t$frame\tID=$mRNA_ID.$feature_showname$num;Parent=$mRNA_ID;$add_attr\n";
}

# 基因内所有转录本的起止位置若因填补而发生变化，需统一修正到基因的起止范围，
# 并对每个转录本的首尾 exon 边界做相应修正。
sub correct_ends_of_transcript_and_exon {
    my ( $transcript_info, $geneStart, $geneEnd ) = @_;
    return '' unless defined $transcript_info && length $transcript_info;
    my $out = '';

    my ( %parent, %transcript_ID );
    foreach ( split /\n/, $transcript_info ) {
        my ( $ID, $parent ) = ( "null", "null" );
        $ID     = $1 if /ID=([^;]+)/;
        $parent = $1 if /Parent=([^;]+)/;
        $parent{$ID} = $parent if ( $ID && $parent );
    }
    foreach ( keys %parent ) {
        $transcript_ID{$_} = 1 unless exists $parent{ $parent{$_} };
    }

    my ( %transcript_content, %transcript_header );
    foreach ( split /\n/, $transcript_info ) {
        my ( $ID, $parent ) = ( "null", "null" );
        $ID     = $1 if /ID=([^;]+)/;
        $parent = $1 if /Parent=([^;]+)/;
        if ( exists $transcript_ID{$ID} ) {
            $transcript_header{$ID} = $_;
        }
        elsif ( exists $transcript_ID{$parent} ) {
            $transcript_content{$parent} .= "$_\n";
        }
    }

    foreach my $transcript_ID ( sort keys %transcript_ID ) {
        my @transcript_header = split /\t/, $transcript_header{$transcript_ID};
        $transcript_header[3] = $geneStart;
        $transcript_header[4] = $geneEnd;
        $out .= ( join "\t", @transcript_header ) . "\n";

        my @exon;
        foreach ( split /\n/, ( $transcript_content{$transcript_ID} // '' ) ) {
            my @f = split /\t/;
            push @exon, "$f[3]\t$f[4]" if @f >= 5 && $f[2] eq "exon";
        }

        if (@exon) {
            @exon = sort { $a <=> $b } @exon;
            my @exon_first = split /\t/, $exon[0];
            my @exon_last  = split /\t/, $exon[-1];
            my ( $exon_start, $exon_end ) = ( $exon_first[0], $exon_last[-1] );

            foreach ( split /\n/, ( $transcript_content{$transcript_ID} // '' ) ) {
                my @f = split /\t/;
                if ( @f && $f[2] eq "exon" ) {
                    s/\texon\t$exon_start\t/\texon\t$geneStart\t/;
                    s/\texon\t(\d+)\t$exon_end\t/\texon\t$1\t$geneEnd\t/;
                }
                $out .= "$_\n";
            }
        }
        else {
            $out .= ( $transcript_content{$transcript_ID} // '' );
        }
    }

    return $out;
}
