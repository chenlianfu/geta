#!/usr/bin/env perl

use strict;
use Getopt::Long;
use Cwd qw/abs_path getcwd cwd/;
use File::Basename;
use Fcntl qw(:flock);

my $binPath = dirname($0);

my $usage = <<USAGE;
Usage:
    $0 [options] homolog_proteins.fasta genome_seq.fasta > out.tab

    本程序用于将全基因组序列和多个临近物种的全基因组同源蛋白使用MMseqs2软件进行比对，得到类似BLAST outfmt 6格式，由制表符分割的比对结果。
    输出结果中，每一行代表同源蛋白匹配到基因组某一区域的比对结果。结果文件有16列：query同源蛋白ID、target参考基因组序列ID、CIP、Alignment Length、Query Length、Target Length、Query start、Query end、Target start、Target end、E-vaule、BitScore、Query coverage、Query HSPs、Target HSPs和Group_Region。其表头标识出了每一列的意义，其中：CIP，cumulative identity percentage，表示Hit累积的identity百分比；Query coverage，表示对query序列的累积覆盖率；Query HSPs，由逗号分隔在同源蛋白序列上的HSP（High-scoring Segment Pair）；Target HSPs，由逗号分隔在基因组序列上的HSPs；Group Region，多个同源蛋白在基因组序列上的匹配区域，表示对应同源基因的所在区域。

    程序分析流程：（1）首先，调用MMseq2软件（--search-type 2，蛋白query比对到核酸基因组target，即translated search）将多个物种的同源蛋白序列作为query，比对到全基因组序列上，得到比对结果。（2）对HSPs比对结果使用identity和evalue进行过滤。（3）由于一个基因可能在基因组中有多个拷贝，或基因中有introns，导致一个同源蛋白可能有多个HSPs比对结果。因此，再将多拷贝基因的HSPs分开，将可变剪接导致的多个HSPs合并为一个Hit——合并时要求参与合并的HSPs在query（同源蛋白）和subject（基因组）坐标上保持共线（collinear），避免把不符合基因结构、坐标顺序错乱的HSPs错误地合并为同一个Hit。（4）对Hits使用identity、evaule和query coverage进行过滤。（5）最后，对匹配到相同基因组位点的同源蛋白比对Hits进行过滤，仅保留一定数量(最高10个)的高得分Hits。

    注意：第（3）(4)步（HSPs合并为Hits并过滤）和第（5）步（基因组位点上的Hits去冗余）均采用多进程动态任务队列（dynamic work queue）并行运算，并行数由--cpu参数控制：先将数据切分为数量明显多于--cpu的小数据块，再由多个worker子进程从队列中动态领取空闲数据块进行处理，空闲的进程会立即领取下一个任务，从而缓解不同数据块计算量不均衡导致的"长尾"等待问题。
    第（3）(4)步按 query-target 组合进行数据分割，第（5）步按基因组序列ID进行数据分割，分割后的数据块之间相互独立，并行结果和单线程结果完全一致。

    程序在临时文件夹中生成了中间文件：
    output.HSP.tab，MMseqs2程序的结果文件，包含所有HSPs信息；
    output.Hit.tab，将HSPs过滤，合并为Hit，并对Hit进行了过滤。每行表示一个Hit信息，即同源蛋白和基因组上基因区域的比对结果。该文件有表头信息，第三列是整体的Identity百分比，第7-10行是整体比对的起始和结束位点，第11行是最优HSP的evalue值，第12行是多个HSPs的得分之和，最后两列是详细的HSPs信息；
    output.filter.tab，最终过滤后的结果文件，内容和程序标准输出一致。

    --cpu <int>    default: 8
    设置CPU线程数。该参数值将传递给mmseqs命令的--threads参数，同时也是本程序进行HSP合并、Hit过滤时动态任务队列的并行worker进程数。

    --HSP_identity <float>    default: 0.1
    --HSP_evalue <float>    default: 1e-3
    设置HSP (High-scoring Segment Pair) 阈值，对MMseqs2的比对结果进行过滤。MMseqs2程序分析完毕后，每行表示同源蛋白某一区域和基因组序列某一区域的比对结果，即一个HSP。通过设置identity和evalue阈值对所有HSPs结果统一进行过滤。

    --HSP_max_distance <int>    default: 3.6 * sqrt(genomeSize)，其中genomeSize为输入基因组序列的总长度（bp）。若用户显式指定该参数，则以用户指定值为准，不再使用该公式计算默认值。
    --HSP_max_overlap_ratio <float>    default: 0.5
    设置HSPs分隔或合并为Hits时的阈值参数。由于一个基因可能在基因组中有多个拷贝，或基因中有introns，导致一个同源蛋白可能有多个HSPs比对结果。程序需要将这些HSPs进行分隔和合并。将多拷贝基因的HSPs分开，将可变剪接导致的多个HSPs合并为一个Hit。操作算法：在多个HSPs中找最优HSP(按Evalue和Score排序)，将和最优HSP(组)方向一致、在基因组上距离较近（低于--HSP_max_distance参数设置值，单位bp）、在query蛋白序列上重叠较低（对待加入HSP重叠比例低于--HSP_max_overlap_ratio参数设置值）、且和当前HSP组在query与subject坐标上保持共线（即新HSP在基因组上的位置和其在同源蛋白上的位置相对已有HSP组的延伸方向一致，不会出现基因组坐标前移但蛋白坐标却后退等交叉错位的情况）的HSPs合并为一组；继续于剩下的HSPs继续找最优HSP及其分组；于是将多个HSPs分割成不同的组，每个HSPs组表示一个Hit，即对应一个拷贝的基因区域。

    --identity <float>    default: 0.2
    --evalue <float>    default: 1e-9
    --homolog_coverage <float>    default: 0.3
    设置Hit阈值。Hit的identity为多个HSPs累积的一致性氨基酸数量除以匹配长度的值；Hit的evalue值为其所有HSPs中的最低evalue值；Hit的homolog coverage即其所有HSPs的氨基酸占同源蛋白序列的比例。

    --threshold_Hit_cover_ratio <float>    default: 0.9
    --threshold_Hit_score_ratio <foat>    default: 0.4
    --threshold_species_num <int>    default: 2
    --threshold_Hit_num <int>    default: 10
    设置以上阈值，在基因组某一匹配区域上最优Hit包含多个其它Hits时，仅保留一定数量(最高10个)的高得分Hits。若Hit A和其它多个Hits之间重叠，且覆盖每个其它Hits区域的 >= 90% 时（此处认为Hit A包含了其它Hits），且Hit A的Evalue、Score得分都优于其它Hits，则对Hit A和其它Hits按Evalue和Score进行排序，挑选较好的Hits，采用以下三种方法过滤一部分Hits：（1）当其它Hit的Score得分低于Hit A Score的一定比例（默认40%）时， 对其Hit进去去除；（2）同一个物种最多保留指定数量（默认2个）的Hits；（3）最多保留指定数量（默认为10个）的较好Hits

    对--threshold_Hit_cover_ratio参数更加详细描述：--threshold_Hit_cover_ratio，设置Hit A包含另外一个Hit B时，要求两个Hits重叠区域对Hit B匹配区域的覆盖比例阈值。当Hit A的Evalue和Score值都优于Hit B，且Hit B >=90%以上的区域和Hit A重叠时，则认为该Hit A包含Hit B，进而考虑对Hit B其进行去除。计算覆盖比例时 ，根据Hit A和Hit B的HSPs信息进行overlap比例计算，分子为Overlap部分的碱基数量，分母为Hit B的HSPs的总碱基数量。

    对--threshold_Hit_score_ratio参数更加详细描述：设置Score比例阈值。当两个BLAST Hits的匹配区域有包含关系时，Hit A包含Hit B，Hit A evalue优于Hit B evalue， 且B Hit Score / A Hit Score低于--threshold_Hit_score_ratio参数设置的阈值，则去除Hit B。

    对--threshold_species_num参数更加详细描述：设置物种数量阈值。若Hit A和包含了多个其它Hits，对这些Hits进行去冗余时，来自同一物种的Hits最多保留--threshold_species_num阈值指定的个数。该参数生效需要subject name中包含物种名称信息。程序识别query name中的关键词species（大小写均可以识别）及其后的字符[a-zA-Z0-9]作为物种名称。例如XP_002436309_2_SpeciesSorghumBicolor，程序识别其物种名称为SpeciesSorghumBicolor。若subject name中不包含关键词species及其后紧跟的物种名称，程序则以整个subject name为物 种名称，从而使本参数不生效。

    对--threshold_Hit_num参数更加详细描述：设置数量阈值。若Hits之间有包含关系时，最多保留指定数量（默认为10个）的较好Hits。分析过程分多步：（1）在第一条基因组序列前3Kb窗口范围有重叠的所有Hits按Evalue从小到大、Score值从大到小、匹配范围从大到小进行排序，然后按顺序对Hits进行后 续分析；（2）根据排序对Evalue值最小的最优Hit进行分析，在所有Hits中检索Score值更低并被最优Hit包含（根据--threshold_Hit_cover_ratio参数分析结果）的Hits，对这些Hits按Evalue和Score进行排序，去除Score值过低的Hits，再同一物种保留最多--threshold_species_num个数的Hits，再最多保留较好的指定数量（--threshold_Hit_num参数设置值）的Hits，删除其余较差的Hits；（3）对剩下未保留也未删除的Hits，延用第二步 的策略，进一步的进行保留和删除操作，进行多轮直至分析完毕所有的Hit数据；（4）对整条基因组序列往后滑动，每次往后滑 动1Kb距离，分析3Kb窗口，鉴定需要删除的的Hits信息。

    --tmp_dir <string>    default: tmp_\$date\$pid
    程序运行时临时文件夹名称。

    --help    default: None
    display this help and exit.

USAGE
if (@ARGV==0){die $usage}

my ($cpu, $HSP_identity, $HSP_evalue, $HSP_max_distance, $HSP_max_overlap_ratio, $identity, $evalue, $homolog_coverage, $threshold_Hit_cover_ratio, $threshold_Hit_score_ratio, $threshold_species_num, $threshold_Hit_num, $tmp_dir, $help_flag);
GetOptions(
    "cpu:i" => \$cpu,
    "HSP_identity:f" => \$HSP_identity,
    "HSP_evalue:f" => \$HSP_evalue,
    "HSP_max_distance:i" => \$HSP_max_distance,
    "HSP_max_overlap_ratio:f" => \$HSP_max_overlap_ratio,
    "identity:f" => \$identity,
    "evalue:f" => \$evalue,
    "homolog_coverage:f" => \$homolog_coverage,
    "threshold_Hit_cover_ratio:f" => \$threshold_Hit_cover_ratio,
    "threshold_Hit_score_ratio:f" => \$threshold_Hit_score_ratio,
    "threshold_species_num:i" => \$threshold_species_num,
    "threshold_Hit_num:i" => \$threshold_Hit_num,
    "tmp_dir:s" => \$tmp_dir,
    "help" => \$help_flag,
);

if ( $help_flag ) { die $usage }

# 记录--HSP_max_distance是否由用户显式指定，以便后续决定是否使用基于基因组大小计算的默认值。
my $HSP_max_distance_set_by_user = defined($HSP_max_distance) ? 1 : 0;

$cpu ||= 8;
$HSP_identity ||= 0.1;
$HSP_evalue ||= 1e-3;
$HSP_max_overlap_ratio ||= 0.5;
$identity ||= 0.2;
$evalue ||= 1e-9;
$homolog_coverage ||= 0.3;
$threshold_Hit_cover_ratio ||= 0.9;
$threshold_Hit_score_ratio ||= 0.4;
$threshold_species_num ||= 2;
$threshold_Hit_num ||= 10;
my $date = `date +%Y%m%d%H%M%S`; chomp($date);
$tmp_dir ||= "tmp_$date$$";
$tmp_dir = abs_path($tmp_dir);
mkdir $tmp_dir unless -e $tmp_dir;

my $input_protein = abs_path($ARGV[0]);
my $input_genome = abs_path($ARGV[1]);

# 计算基因组总长度，用于设置--HSP_max_distance的默认值：3.6 * sqrt(genomeSize)。
my $genomeSize = &get_fasta_total_length($input_genome);
unless ( $HSP_max_distance_set_by_user ) {
    $HSP_max_distance = int( 3.6 * sqrt($genomeSize) + 0.5 );
}
print STDERR "Genome total size: $genomeSize bp.\n";
print STDERR "HSP_max_distance " . ( $HSP_max_distance_set_by_user ? "(user-specified)" : "(auto-calculated as 3.6*sqrt(genomeSize))" ) . ": $HSP_max_distance bp.\n";

my $pwd = `pwd`; print STDERR "##########\nPWD (Current Directory): $pwd";
print STDERR (localtime) . "CMD (Main Program): $0 " . join(" ", @ARGV) . "\n##########\n";


# 1 运行 mmseqs createdb 命令，将蛋白序列做成数据库。
print STDERR "\n1. run the command \"mmseqs createdb\", to create homolog protein databases.\n";
chdir $tmp_dir;
$pwd = `pwd`; print STDERR "PWD: $pwd";
my $cmdString = "mmseqs createdb $input_protein homolog &> a.mmseqs_createdb_homolog.log";
unless (-e "a.mmseqs_createdb_homolog.ok") {
    print STDERR (localtime) . ": CMD: $cmdString\n";
    system("$cmdString") == 0 or die "failed to execute: $cmdString\n";
    open OUT, ">", "a.mmseqs_createdb_homolog.ok" or die $!; close OUT;
}
else {
    print STDERR "CMD(Skipped): $cmdString\n";
}

# 2 运行 mmseqs createdb 命令，将基因组序列做成数据库。
print STDERR "\n2. run the command \"mmseqs createdb\", to create genome database.\n";
$pwd = `pwd`; print STDERR "PWD: $pwd";
$cmdString = "mmseqs createdb $input_genome genome &> b.mmseqs_createdb_genome.log";
unless (-e "b.mmseqs_createdb_genome.ok") {
    print STDERR (localtime) . ": CMD: $cmdString\n";
    system("$cmdString") == 0 or die "failed to execute: $cmdString\n";
    open OUT, ">", "b.mmseqs_createdb_genome.ok" or die $!; close OUT;
}
else {
    print STDERR "CMD(Skipped): $cmdString\n";
}

# 3 运行 mmseqs search 命令将蛋白序列（query）和基因组序列（target）进行比对。
# --search-type 2：显式声明为蛋白query比对核酸target的translated search（相当于tblastn），
# 避免不同版本mmseqs对dbtype自动探测行为不一致导致的比对错误；其余参数使用软件默认值。
print STDERR "\n3. run the command \"mmseqs search\", to align homolog protein sequences (query) to genome sequences (target).\n";
$pwd = `pwd`; print STDERR "PWD: $pwd";
$cmdString = "mmseqs search homolog genome alignment mmseqs_search.tmp --threads $cpu --search-type 2 &> c.mmseqs_search.log";
unless (-e "c.mmseqs_search.ok") {
    print STDERR (localtime) . ": CMD: $cmdString\n";
    system("$cmdString") == 0 or die "failed to execute: $cmdString\n";
    open OUT, ">", "c.mmseqs_search.ok" or die $!; close OUT;
}
else {
    print STDERR "CMD(Skipped): $cmdString\n";
}

# 4 运行 mmseqs convertalis 输出BLAST格式比对结果。
print STDERR "\n4. run the command \"mmseqs convertalis\", and output the alignment results with BLAST format.\n";
$pwd = `pwd`; print STDERR "PWD: $pwd"; chomp($pwd);
$cmdString = "mmseqs convertalis homolog genome alignment output.HSP.tab --threads $cpu --format-output query,target,pident,alnlen,qlen,tlen,qstart,qend,tstart,tend,evalue,bits &> d.mmseqs_convertalis.log";
unless (-e "d.mmseqs_convertalis.ok") {
    print STDERR (localtime) . ": CMD: $cmdString\n";
    system("$cmdString") == 0 or die "failed to execute: $cmdString\n";
    open OUT, ">", "d.mmseqs_convertalis.ok" or die $!; close OUT;
}
else {
    print STDERR "CMD(Skipped): $cmdString\n";
}


#####################################################################
# 5. 将比对HSP结果转换为Hit结果，并进行过滤。（多进程动态任务队列并行）
#####################################################################
unless ( -e "e.HSP2Hit.ok" ) {
    # 5.1 对 MMseqs2 的HSPs结果按identity和evalue阈值进行过滤。
    print STDERR "\n5.1 filtering HSPs with threshold: identity >= $HSP_identity && E-value <= $HSP_evalue.\n";
    print STDERR (localtime) . ": Start.\n";

    my ($line_num1, $line_num2) = (0, 0);
    open my $ffh, ">", "output.HSP.filtered.tab" or die "Can not create file $pwd/output.HSP.filtered.tab, $!";
    open IN, "<", "output.HSP.tab" or die "Can not open file $pwd/output.HSP.tab, $!";
    while (<IN>) {
        $line_num1 ++;
        @_ = split /\t/;
        next unless ( $_[2] >= $HSP_identity && $_[-2] <= $HSP_evalue );
        $line_num2 ++;
        print $ffh $_;
    }
    close IN;
    close $ffh;
    print STDERR "The MMseqs result have $line_num1 HSPs, and $line_num2 HSPs were picked out for downstrem analysis.\n";

    # 5.2 按 query,target 两列排序，使同一个 query-target 组合（key）的所有HSPs在文件中相邻，
    #     以便按key边界切分成多个数据块，且不会把同一个key的HSPs拆到不同数据块中。
    print STDERR "\n5.2 sorting HSPs by query,target, and spliting into small chunks for the dynamic work queue.\n";
    system("sort -k1,1 -k2,2 --parallel=$cpu -T . output.HSP.filtered.tab -o output.HSP.sorted.tab") == 0
        or die "failed to sort output.HSP.filtered.tab\n";
    unlink "output.HSP.filtered.tab";

    # 目标数据块数量明显多于 $cpu（这里取4倍），配合动态任务队列，让空闲的worker能持续领到新任务，
    # 缓解数据块之间计算量不均衡（某些位点HSPs远多于其它位点）导致的长尾等待问题。
    my $num_chunks = $cpu * 4;
    $num_chunks = 1 if $num_chunks < 1;
    my $total_size = -s "output.HSP.sorted.tab";
    $total_size ||= 0;
    my $target_chunk_size = int($total_size / $num_chunks) + 1;

    my @HSP_chunk_files;
    my ($chunk_idx, $chunk_size, $cur_key, $chunk_fh) = (0, 0, "", undef);
    open IN, "<", "output.HSP.sorted.tab" or die "Can not open file $pwd/output.HSP.sorted.tab, $!";
    while (<IN>) {
        @_ = split /\t/;
        my $key = "$_[0]\t$_[1]";
        if ( ! defined $chunk_fh ) {
            open $chunk_fh, ">", "split.HSP.$chunk_idx" or die "Can not create file $pwd/split.HSP.$chunk_idx, $!";
            push @HSP_chunk_files, "split.HSP.$chunk_idx";
        }
        elsif ( $key ne $cur_key && $chunk_size >= $target_chunk_size ) {
            close $chunk_fh;
            $chunk_idx ++;
            $chunk_size = 0;
            open $chunk_fh, ">", "split.HSP.$chunk_idx" or die "Can not create file $pwd/split.HSP.$chunk_idx, $!";
            push @HSP_chunk_files, "split.HSP.$chunk_idx";
        }
        print $chunk_fh $_;
        $chunk_size += length($_);
        $cur_key = $key;
    }
    close $chunk_fh if defined $chunk_fh;
    close IN;
    unlink "output.HSP.sorted.tab";

    my $chunk_num = @HSP_chunk_files;
    print STDERR "HSPs were split into $chunk_num chunks for $cpu parallel worker processes (dynamic work queue).\n";

    # 5.3 对HSPs进行分隔合并成Hits，再对Hits进行过滤。使用动态任务队列，由 $cpu 个worker进程
    #     从队列中动态领取数据块进行处理，空闲进程会立即领取下一个任务。
    print STDERR "\n5.3. Spliting the HSPs for different gene copys, and combining the HSPs from a intron gene to a Hit, and then filtring Hits.\n";
    print STDERR (localtime) . ": run $cpu worker processes with dynamic work queue.\n";

    &run_dynamic_pool($cpu, \@HSP_chunk_files, sub {
        my $chunk_file = shift;
        &HSP2Hit($chunk_file, "$chunk_file.out");
    });

    # 5.4 合并各数据块的处理结果
    open OUT, ">", "output.Hit.tab" or die "Can not create file $pwd/output.Hit.tab, $!";
    print OUT "#QueryID\tTargetID\tCIP\tAlignmentLength\tQueryLength\tTargetLength\tQueryStart\tQueryEnd\tTargetStart\tTargetEnd\tEvalue\tBitScore\tQuery_coverage\tQuery_HSPs\tTarget_HSPs\n";
    my ($hit_num1, $hit_num2) = (0, 0);
    foreach my $chunk_file ( @HSP_chunk_files ) {
        open my $in, "<", "$chunk_file.out" or die "Can not open file $pwd/$chunk_file.out, $!";
        print OUT while <$in>;
        close $in;

        open my $stat, "<", "$chunk_file.out.stat" or die "Can not open file $pwd/$chunk_file.out.stat, $!";
        my $stat_line = <$stat>; close $stat; chomp($stat_line);
        my @stat = split /\t/, $stat_line;
        $hit_num1 += $stat[0];
        $hit_num2 += $stat[1];

        unlink $chunk_file, "$chunk_file.out", "$chunk_file.out.stat";
    }
    close OUT;

    print STDERR "HSPs were combined to $hit_num1 Hits, and $hit_num2 Hits were reserved with thresholds identity >= $identity && homolog coverage >= $homolog_coverage && E-value <= $evalue.\n";
    print STDERR (localtime) . ": Done.\n";

    open OUT, ">", "e.HSP2Hit.ok" or die $!; close OUT;
}
else {
    print STDERR "\n(Skipped): 5. combining HSPs to Hits and filtering.\n";
}


#####################################################################
# 6. 对匹配到相同基因组位点的同源蛋白Hits进行过滤，仅保留一定数量(最高10个)的高得分Hits。
#    （多进程动态任务队列并行）
#    并行策略：按基因组序列ID(TargetID)对数据进行分割。由于Hits的索引、去冗余、Group_Region的
#    计算全部在同一条基因组序列内部完成，跨序列之间没有任何依赖，因此并行结果和单线程结果完全一致。
#    说明（嵌套基因/intron中含有另一个基因的情况）：判断两个Hits是否冗余、是否存在包含关系，
#    依据的是它们真实exon(HSP)坐标的重叠比例（子程序filterHits中调用cal_overlap_ratio_fast），
#    而不是Hit整体的起止范围。因此若基因A的intron内部存在另一个基因B，只要B的exon和A的exon
#    在碱基层面确实不重叠，两者的重叠比例即为0，不会被当作冗余Hit而彼此删除。同时filterHits中
#    对Hit的索引也改为按真实exon位置（而非Hit整体跨度）登记，避免了大intron基因被重复登记进
#    intron跨度内所有窗口、进而被反复比较所带来的额外开销。
#####################################################################
print STDERR "\n6. retain a part of excellent Hits at each gene locus.\n";
unless ( -e "f.filterHits.ok" ) {
    print STDERR (localtime) . ": Start.\n";

    # 6.1 统计每条基因组序列上的Hit数量，采用贪心算法将序列分配到数量明显多于 $cpu 的数据块中
    #     （这里取4倍），配合动态任务队列，缓解不同基因组位点上Hits数量差异巨大导致的长尾等待问题。
    my %seq_hit_num;
    open IN, "<", "output.Hit.tab" or die "Can not open file $pwd/output.Hit.tab, $!";
    <IN>;
    while (<IN>) {
        chomp;
        next unless $_;
        @_ = split /\t/;
        $seq_hit_num{$_[1]} ++;
    }
    close IN;

    my $num_chunks = $cpu * 4;
    my $distinct_seq_num = scalar(keys %seq_hit_num);
    $num_chunks = $distinct_seq_num if $distinct_seq_num > 0 && $distinct_seq_num < $num_chunks;
    $num_chunks = 1 if $num_chunks < 1;

    my %seq2chunk;
    my @chunk_load = (0) x $num_chunks;
    foreach my $seq_ID ( sort { $seq_hit_num{$b} <=> $seq_hit_num{$a} or $a cmp $b } keys %seq_hit_num ) {
        my $min_chunk = 0;
        foreach ( 1 .. $num_chunks - 1 ) {
            $min_chunk = $_ if $chunk_load[$_] < $chunk_load[$min_chunk];
        }
        $seq2chunk{$seq_ID} = $min_chunk;
        $chunk_load[$min_chunk] += $seq_hit_num{$seq_ID};
    }

    my @filter_chunk_files;
    my @SPLIT;
    foreach my $i ( 0 .. $num_chunks - 1 ) {
        open my $fh, ">", "split.filter.$i" or die "Can not create file $pwd/split.filter.$i, $!";
        $SPLIT[$i] = $fh;
        push @filter_chunk_files, "split.filter.$i";
    }
    open IN, "<", "output.Hit.tab" or die "Can not open file $pwd/output.Hit.tab, $!";
    <IN>;
    while (<IN>) {
        chomp;
        next unless $_;
        my $line = $_;
        @_ = split /\t/, $line;
        my $fh = $SPLIT[$seq2chunk{$_[1]}];
        print $fh "$line\n";
    }
    close IN;
    close $_ foreach @SPLIT;
    %seq2chunk = (); %seq_hit_num = ();

    my $chunk_num = @filter_chunk_files;
    print STDERR "Hits were split into $chunk_num chunks (by TargetID) for $cpu parallel worker processes (dynamic work queue).\n";

    # 6.2 使用动态任务队列，由 $cpu 个worker进程从队列中动态领取数据块，对每个数据块独立
    #     进行Hits去冗余分析。
    print STDERR (localtime) . ": run $cpu worker processes with dynamic work queue.\n";
    &run_dynamic_pool($cpu, \@filter_chunk_files, sub {
        my $chunk_file = shift;
        &filterHits($chunk_file, "$chunk_file.out");
    });

    # 6.3 合并各数据块结果，按 TargetID 和匹配位置排序后输出。
    my @final;
    my ($hits_all_num, $hits_filtered_num) = (0, 0);
    foreach my $chunk_file ( @filter_chunk_files ) {
        open my $in, "<", "$chunk_file.out" or die "Can not open file $pwd/$chunk_file.out, $!";
        while (<$in>) { chomp; push @final, $_ if $_; }
        close $in;

        open my $stat, "<", "$chunk_file.out.stat" or die "Can not open file $pwd/$chunk_file.out.stat, $!";
        my $stat_line = <$stat>; close $stat; chomp($stat_line);
        my @stat = split /\t/, $stat_line;
        $hits_all_num += $stat[0];
        $hits_filtered_num += $stat[1];

        unlink $chunk_file, "$chunk_file.out", "$chunk_file.out.stat";
    }

    my (%target, %target_start, %target_end);
    foreach my $line ( @final ) {
        @_ = split /\t/, $line;
        $target{$line} = $_[1];
        $target_start{$line} = $_[8];
        $target_end{$line} = $_[9];
    }

    open OUT, ">", "output.filter.tab" or die "Can not create file $pwd/output.filter.tab, $!";
    print OUT "#QueryID\tTargetID\tCIP\tAlignmentLength\tQueryLength\tTargetLength\tQueryStart\tQueryEnd\tTargetStart\tTargetEnd\tEvalue\tBitScore\tQuery_coverage\tQuery_HSPs\tTarget_HSPs\tGroup_Region\n";
    foreach ( sort { $target{$a} cmp $target{$b} or $target_start{$a} <=> $target_start{$b} or $target_end{$a} <=> $target_end{$b} or $a cmp $b } @final ) {
        print OUT "$_\n";
    }
    close OUT;

    my $remain_num = $hits_all_num - $hits_filtered_num;
    print STDERR "Total Hits Number: $hits_all_num\nFiltered Hits Number: $hits_filtered_num\nRemained Hits Numer: $remain_num\n";
    print STDERR (localtime) . ": Done.\n";

    open OUT, ">", "f.filterHits.ok" or die $!; close OUT;
}
else {
    print STDERR "(Skipped): 6. retain a part of excellent Hits at each gene locus.\n";
}

# 输出最终结果到标准输出
open IN, "<", "output.filter.tab" or die "Can not open file $pwd/output.filter.tab, $!";
print while <IN>;
close IN;


#####################################################################
# 子程序
#####################################################################

# 动态任务队列（work-stealing风格的进程池）：
# 将 @$tasks_ref 中的每一个任务元素依次交给 $cpu 个worker子进程处理，worker通过对一个共享
# 计数器文件加互斥锁(flock)来原子地领取下一个任务的下标，从而实现"谁先算完谁先领下一个任务"，
# 而不是像静态均分那样提前把任务固定分配给某个进程，可以有效缓解各任务耗时差异很大时的长尾等待。
# 参数：$cpu 并行进程数；$tasks_ref 任务列表（数组引用，元素类型不限，直接传给$worker_sub）；
#       $worker_sub 处理单个任务的代码引用，形如 sub { my $task = shift; ... }。
sub run_dynamic_pool {
    my ($cpu, $tasks_ref, $worker_sub) = @_;
    my @tasks = @$tasks_ref;
    my $ntasks = scalar @tasks;
    return unless $ntasks;

    my $counter_file = "queue_counter.$$.tmp";
    open my $cfh, ">", $counter_file or die "Can not create file $counter_file, $!";
    print $cfh "0\n";
    close $cfh;

    my $workers = ( $cpu < $ntasks ) ? $cpu : $ntasks;
    my @pid;
    foreach ( 1 .. $workers ) {
        my $pid = fork();
        die "Can not fork: $!" unless defined $pid;
        if ( $pid == 0 ) {
            while (1) {
                my $idx;
                open my $fh, "+<", $counter_file or die "Can not open file $counter_file, $!";
                flock($fh, LOCK_EX);
                my $val = <$fh>; chomp($val) if defined $val;
                $idx = $val;
                if ( $idx < $ntasks ) {
                    seek($fh, 0, 0);
                    print $fh ($idx + 1) . "\n";
                    truncate($fh, tell($fh));
                }
                flock($fh, LOCK_UN);
                close $fh;

                last if $idx >= $ntasks;
                $worker_sub->( $tasks[$idx] );
            }
            exit 0;
        }
        push @pid, $pid;
    }
    foreach my $pid ( @pid ) {
        waitpid($pid, 0);
        die "The child process $pid failed with exit status $?\n" if $?;
    }
    unlink $counter_file;
}

# 本子程序由worker调用：读取一个HSP数据块，将HSPs合并为Hits并进行过滤，结果输出到指定文件。
# 注意：子进程中一律使用词法文件句柄，避免和父进程/其它子进程共用文件描述符导致输出错乱。
sub HSP2Hit {
    my ($in_file, $out_file) = @_;

    my %input_info;
    open my $in, "<", $in_file or die "Can not open file $in_file, $!";
    while (<$in>) {
        @_ = split /\t/;
        $input_info{"$_[0]\t$_[1]"} .= $_;
    }
    close $in;

    my ($line_num1, $line_num2) = (0, 0);
    open my $out, ">", $out_file or die "Can not create file $out_file, $!";
    foreach ( sort keys %input_info ) {
        # 对一个query同源蛋白和一条基因组序列比对的HSPs进行分析，得到每行一个Hit结果
        my $output = &parsingHSP($input_info{$_});
        # 对每行Hit信息进行过滤。
        foreach ( split /\n/, $output ) {
            $line_num1 ++;
            @_ = split /\t/;
            # 要求Evalue优于阈值
            next unless $_[10] <= $evalue;

            # 再计算累积identity
            my ($CIP_fenzi, $CIP_fenmu, $CIP) = (0, 0, 0);
            my @HSP_query;
            foreach ( split /,/, $_[-2] ) {
                my @value = split /-/;
                push @HSP_query, "$value[0]-$value[1]";
                $CIP_fenzi += $value[2] * $value[3];
                $CIP_fenmu += $value[3];
            }
            $CIP = int($CIP_fenzi / $CIP_fenmu * 100 + 0.5) / 100 if $CIP_fenmu > 0;
            # 要求identity优于阈值
            next unless $CIP >= $identity * 100;

            # 再计算对同源蛋白的覆盖率
            my ($HSP_query_match_length, $HSP_query_match_coverage) = (0, 0);
            $HSP_query_match_length = &match_length(@HSP_query);
            $HSP_query_match_coverage = $HSP_query_match_length / $_[4] if $_[4];
            # 要求覆盖率优于阈值
            next unless $HSP_query_match_coverage >= $homolog_coverage;

            $line_num2 ++;
            $_[2] = $CIP;
            $_[3] = $CIP_fenmu;
            my $Target_HSPs = pop @_;
            my $Query_HSPs = pop @_;
            $Query_HSPs = join ",", @HSP_query;
            push @_, ($HSP_query_match_coverage, $Query_HSPs, $Target_HSPs);
            print $out join("\t", @_) . "\n";
        }
    }
    close $out;

    open my $stat, ">", "$out_file.stat" or die "Can not create file $out_file.stat, $!";
    print $stat "$line_num1\t$line_num2\n";
    close $stat;
}

# 本子程序由worker调用：读取一个Hit数据块（其中的Hits只属于本数据块分配到的基因组序列），
# 对匹配到相同基因组位点的Hits进行去冗余，结果输出到指定文件。
sub filterHits {
    my ($in_file, $out_file) = @_;

    my (%hits_all, %index, %score, %evalue_of_hit, %alignment_length,
        %target, %target_start, %target_end, %HSP, %HSP_len);

    open my $in, "<", $in_file or die "Can not open file $in_file, $!";
    while (<$in>) {
        chomp;
        next unless $_;
        my $line = $_;
        next if exists $hits_all{$line};
        $hits_all{$line} = 1;

        my @field = split /\t/, $line;
        $score{$line} = $field[11];
        $evalue_of_hit{$line} = $field[10];
        $alignment_length{$line} = abs($field[8] - $field[9]) + 1;
        $target{$line} = $field[1];
        $target_start{$line} = $field[8];
        $target_end{$line} = $field[9];

        # 预先解析Target_HSPs为区间数组，避免后续重复的字符串解析（这是原程序最主要的性能瓶颈之一）。
        my @hsp;
        foreach ( split /,/, $field[-1] ) {
            if ( m/(\d+)-(\d+)/ ) {
                my ($start, $end) = ($1, $2);
                ($start, $end) = ($end, $start) if $start > $end;
                push @hsp, [$start, $end];
            }
        }
        @hsp = sort { $a->[0] <=> $b->[0] } @hsp;
        $HSP{$line} = \@hsp;
        $HSP_len{$line} = &region_length(\@hsp);

        # 对Hit进行索引：不使用Hit的整体起止范围（TargetStart-TargetEnd，可能横跨很长的intron），
        # 而是分别用每一个真实exon(HSP)的区间进行索引（同样每侧额外扩展1Kb侧翼区域）。
        # 这么做主要是为了正确、高效地处理"一个基因的intron内部嵌套了另一个基因"的情况：
        # 若仍按Hit整体起止范围索引，一个带大intron的基因会被重复登记进intron跨度内的每一个
        # 1Kb窗口，而"已保留"的Hit又永远不会被移出候选集，导致它在intron横跨的所有窗口里被
        # 反复拿出来做重叠比较，造成大量无意义的计算；且intron中真正嵌套的基因通常离外层基因
        # 的exon边界较远，即便被比较，重叠比例也一定是0，不会影响是否保留的结果——因此改为
        # 按真实exon位置索引后，既不会影响"是否保留"这一判断的正确性（仍由下面的真实exon级别
        # cal_overlap_ratio_fast计算决定），又能避免这部分无意义的重复比较，对大intron基因、
        # 嵌套基因场景尤其有效。
        foreach my $exon ( @hsp ) {
            my ($exon_start, $exon_end) = @$exon;
            my $win_start = int($exon_start / 1000) - 1; $win_start = 0 if $win_start < 0;
            my $win_end = int($exon_end / 1000) + 2;
            foreach ( $win_start .. $win_end ) {
                $index{$field[1]}{$_}{$line} = 1;
            }
        }
    }
    close $in;

    my %hits_filtered;
    foreach my $seq_ID ( sort keys %index ) {
        foreach my $idx ( sort {$a <=> $b} keys %{$index{$seq_ID}} ) {
            my %hit;
            foreach ( keys %{$index{$seq_ID}{$idx}} ) {
                $hit{$_} = 1 unless exists $hits_filtered{$_};
            }
            next unless %hit;
            my @hit = sort { $evalue_of_hit{$a} <=> $evalue_of_hit{$b} or $score{$b} <=> $score{$a} or $alignment_length{$b} <=> $alignment_length{$a} or $a cmp $b } keys %hit;

            while (@hit) {
                # 对一个目标Hit A进行分析，找到所有被目标Hit包含且匹配效果更差的Hits：evalue值 >= Hit A && score值 <= Hit A。
                # 由于经过了排序，Hit A就是evalue值最低(优)的。
                my $hitA = shift @hit;
                my (%be_contained_hit, @hit_A_group_pos, %hit_A_group_hit);
                $be_contained_hit{$hitA} = 1;
                my $scoreA = $score{$hitA};
                my ($startA, $endA) = ($target_start{$hitA}, $target_end{$hitA});
                ($startA, $endA) = ($endA, $startA) if $startA > $endA;

                foreach my $hitB ( @hit ) {
                    # 先用Hit整体区域做快速判断，完全不重叠的Hit直接跳过，不必计算HSP级别的overlap。
                    my ($startB, $endB) = ($target_start{$hitB}, $target_end{$hitB});
                    ($startB, $endB) = ($endB, $startB) if $startB > $endB;
                    next if ( $startB > $endA or $startA > $endB );

                    my $overlap_ratio = &cal_overlap_ratio_fast($HSP{$hitA}, $HSP{$hitB}, $HSP_len{$hitB});
                    # 寻找和Hit A冗余的Hits
                    next unless $overlap_ratio >= $threshold_Hit_cover_ratio;

                    # 第一步剔除方法：去除Score得分低于Hit A Score的一定比例（默认40%）Hits。
                    if ( $score{$hitB} < $scoreA * $threshold_Hit_score_ratio ) {
                        delete $hit{$hitB};
                        $hits_filtered{$hitB} = 1;
                    }
                    elsif ( $score{$hitB} < $scoreA ) {
                        $be_contained_hit{$hitB} = 1;
                    }
                }

                # 对冗余的Hits执行保留和删除操作
                my @be_contained_hit = sort { $evalue_of_hit{$a} <=> $evalue_of_hit{$b} or $score{$b} <=> $score{$a} or $alignment_length{$b} <=> $alignment_length{$a} or $a cmp $b } keys %be_contained_hit;
                my $keep_num = 0;
                my %species_num;
                foreach my $hitB ( @be_contained_hit ) {
                    # 第二步剔除方法：同一个物种最多保留指定数量（默认2个）的Hits。
                    my @field = split /\t/, $hitB;
                    my $subject_species = $field[0];
                    $subject_species = $1 if $field[0] =~ m/(species[a-zA-Z0-9]+)/i;
                    $species_num{$subject_species} ++;
                    if ( $species_num{$subject_species} > $threshold_species_num ) {
                        $hits_filtered{$hitB} = 1;
                        delete $hit{$hitB};
                        next;
                    }
                    $keep_num ++;
                    # 第三步剔除方法：最多保留指定数量（默认为10个）的较好Hits。
                    if ( $keep_num > $threshold_Hit_num ) {
                        $hits_filtered{$hitB} = 1;
                    }
                    else {
                        push @hit_A_group_pos, ($field[8], $field[9]);
                        $hit_A_group_hit{$hitB} = 1;
                    }
                    delete $hit{$hitB};
                }

                # 得到Hit A group的区域，再于结果尾部增加一列Hit Group Region信息
                @hit_A_group_pos = sort {$a <=> $b} @hit_A_group_pos;
                foreach ( keys %hit_A_group_hit ) {
                    $hits_all{$_} = "$_\t$hit_A_group_pos[0]-$hit_A_group_pos[-1]";
                }

                # 下一轮的Hits，则去除了所有被保留和被删除的Hits。
                @hit = sort { $evalue_of_hit{$a} <=> $evalue_of_hit{$b} or $score{$b} <=> $score{$a} or $alignment_length{$b} <=> $alignment_length{$a} or $a cmp $b } keys %hit;
            }
        }
    }

    open my $out, ">", $out_file or die "Can not create file $out_file, $!";
    foreach ( keys %hits_all ) {
        print $out "$hits_all{$_}\n" unless exists $hits_filtered{$_};
    }
    close $out;

    my $hits_all_num = keys %hits_all;
    my $hits_filtered_num = keys %hits_filtered;
    open my $stat, ">", "$out_file.stat" or die "Can not create file $out_file.stat, $!";
    print $stat "$hits_all_num\t$hits_filtered_num\n";
    close $stat;
}

# 本子程序用于解析HPSs，得到一个Hit结果。
# 相比原版新增：向HSP组添加候选HSP时，除了方向一致、距离阈值、query重叠比例阈值以外，
# 还要求候选HSP和当前HSP组在query（同源蛋白）与subject（基因组）坐标上保持共线，
# 避免把坐标顺序交叉错位（可能来自并联重复、旁系同源拷贝等）的HSPs错误地合并为一个Hit。
sub parsingHSP {
    my $info = $_[0];
    chomp($info);

    # 去冗余。可能会出现相同的匹配区域出现两种不同的比对结果。例如：
    # NC_029256.1     XP_002437861_1  35.48   372     138     102     6381589 6381819 289     365     1.7e-58 100.1   39.2    0.13    92.37
    # NC_029256.1     XP_002437861_1  41.53   366     121     93      6381589 6381819 289     365     5.9e-67 100.1   44.24   0.13    92.92
    my (%lines, @lines);
    foreach ( split /\n/, $info ) {
        @_ = split /\t/;
        $lines{"$_[0]\t$_[1]\t$_[6]\t$_[7]\t$_[8]\t$_[9]"}{$_} = $_[10];
    }
    foreach ( keys %lines ) {
        @_ = sort {$lines{$_}{$a} <=> $lines{$_}{$b}} keys %{$lines{$_}};
        push @lines, $_[0];
    }
    %lines = ();
    foreach (@lines) { $lines{$_} = 1; }

    my @out;
    while ( @lines ) {
        # 寻找最佳HSP，最优的evalue和score值。
        my (%evalue, %score);
        foreach ( @lines ) {
            @_ = split /\t/;
            $evalue{$_} = $_[10];
            $score{$_} = $_[11];
        }
        @lines = sort {$evalue{$a} <=> $evalue{$b} or $score{$b} <=> $score{$a} or $a cmp $b} @lines;
        my $best_HSP = shift @lines;
        delete $lines{$best_HSP};

        # 通过最佳HSP，确定匹配方向。
        @_ = split /\t/, $best_HSP;
        my @best_field = @_;
        my ($direction_query, $direction_subject) = ("plus", "plus");
        $direction_query = "minus" if $_[6] > $_[7];
        $direction_subject = "minus" if $_[8] > $_[9];

        my @query_region = ("$_[6]-$_[7]-$_[2]-$_[3]");
        my @subject_region = ("$_[8]-$_[9]");
        my @query_site = ($_[6], $_[7]);
        my @subject_site = ($_[8], $_[9]);
        my $score_out = $_[11];

        # 对除最佳HSP外的其余HSPs，按距离从近到远进行分析。若距离低于--HSP_max_distance参数设定的值，
        # 且在同源蛋白上HSPs的重叠比例低于--HSP_max_overlap_ratio参数设定值，且和当前HSP组保持共线，
        # 则两临近HSPs处于一个Hit，并入到HSP组中。继续对其余HSP进行分析和HSP组的距离，直至HSP组不再增加。
        my @HSPs = keys %lines;
        my $HSP_group_add = 1;
        while ( $HSP_group_add ) {
            # 对HSPs按离最佳HSP组从近到远排序
            my %distance_to_best_HSP_group;
            @subject_site = sort {$a <=> $b} @subject_site;
            foreach my $HSP ( @HSPs ) {
                my @HSP_filed = split /\t/, $HSP;
                my $distance_value = 0;
                my ($HSP_filed_start, $HSP_filed_end) = ($HSP_filed[8], $HSP_filed[9]);
                ($HSP_filed_start, $HSP_filed_end) = ($HSP_filed[9], $HSP_filed[8]) if $HSP_filed[9] < $HSP_filed[8];
                $distance_value = $HSP_filed_start - $subject_site[-1] if $HSP_filed_start > $subject_site[-1];
                $distance_value = $subject_site[0] - $HSP_filed_end if $subject_site[0] > $HSP_filed_end;
                $distance_to_best_HSP_group{$HSP} = $distance_value;
            }
            @HSPs = sort { $distance_to_best_HSP_group{$a} <=> $distance_to_best_HSP_group{$b} } @HSPs;

            # 对距离HSP组从近到远的HSP进行分析
            my $add_OK = 0;
            foreach ( @HSPs ) {
                # 若距离开始超出阈值，则直接退出foreach循环。
                last if $distance_to_best_HSP_group{$_} > $HSP_max_distance;
                # 分析HSP方向，需要一致
                @_ = split /\t/;
                my ($direction_query1, $direction_subject1) = ("plus", "plus");
                $direction_query1 = "minus" if $_[6] > $_[7];
                $direction_subject1 = "minus" if $_[8] > $_[9];
                # 若临近的HSP和最优HSP方向一致
                if ($direction_query eq $direction_query1 && $direction_subject eq $direction_subject1) {
                    # 继续分析临近HSP在query同源蛋白上重叠率
                    my $HSPA = join ",", @query_region;
                    my $HSPB = "$_[6]-$_[7]";
                    my $overlap_ratio_for_B = &cal_overlap_ratio($HSPA, $HSPB);
                    # 再分析临近HSP和当前HSP组是否保持共线
                    my $collinear_OK = &is_collinear($direction_query, $direction_subject, \@query_site, \@subject_site, $_[6], $_[7], $_[8], $_[9]);
                    # 若重叠率低于阈值，且共线关系成立
                    if ( $overlap_ratio_for_B <= $HSP_max_overlap_ratio && $collinear_OK ) {
                        # 则将HSP添加到HSP组。
                        push @query_region, "$_[6]-$_[7]-$_[2]-$_[3]";
                        push @subject_region, "$_[8]-$_[9]";
                        push @query_site, ($_[6], $_[7]);
                        push @subject_site, ($_[8], $_[9]);
                        $score_out += $_[11];
                        delete $lines{$_};
                        $add_OK = 1;
                    }
                }
            }

            # 若成功增加了临近的HSP，则进行下一轮增加，直至不能增加HSP为止。
            if ( $add_OK == 1 ) {
                $HSP_group_add = 1;
                @HSPs = keys %lines;
            }
            else {
                $HSP_group_add = 0;
            }
        }

        @query_site = sort {$a <=> $b} @query_site;
        @subject_site = sort {$a <=> $b} @subject_site;
        my $query_region = "$query_site[0]\t$query_site[-1]";
        my $subject_region = "$subject_site[0]\t$subject_site[-1]";
        $query_region = "$query_site[-1]\t$query_site[0]" if $direction_query eq "minus";
        $subject_region = "$subject_site[-1]\t$subject_site[0]" if $direction_subject eq "minus";
        ($best_field[6], $best_field[7]) = split /\t/, $query_region;
        ($best_field[8], $best_field[9]) = split /\t/, $subject_region;
        $best_field[11] = $score_out;

        if ( $direction_query eq "minus" ) {
            @query_region = sort {$b <=> $a} @query_region;
        }
        else {
            @query_region = sort {$a <=> $b} @query_region;
        }
        if ( $direction_subject eq "minus" ) {
            @subject_region = sort {$b <=> $a} @subject_region;
        }
        else {
            @subject_region = sort {$a <=> $b} @subject_region;
        }
        # 在Hit尾部增加两列信息，Query的HSP匹配区域。
        push @best_field, join(",", @query_region);
        push @best_field, join(",", @subject_region);
        push @out, join("\t", @best_field);

        @lines = keys %lines;
    }
    return join("\n", @out);
}

# 判断将候选HSP加入当前HSP组后，是否仍保持共线（collinear）关系。
# 共线的含义：随着基因组坐标（subject）沿HSP组的延伸方向增大/减小，同源蛋白坐标（query）
# 也应沿着与之匹配的方向单调变化，而不会出现基因组上"前移"但蛋白序列上却"后退"的交叉错位。
# 这种交叉错位通常意味着这些HSPs并非来自同一个基因拷贝的正常exon-intron结构（例如可能是
# 并联重复、旁系同源基因、或组装错误区域），不应被合并为同一个Hit。
#
# 参数：
#   $direction_query / $direction_subject：当前HSP组的query/subject方向（"plus"/"minus"）
#   $query_site_ref / $subject_site_ref：当前HSP组已有的query/subject坐标点（数组引用）
#   $cand_qstart, $cand_qend, $cand_sstart, $cand_send：候选HSP的query和subject坐标
# 返回：1表示共线（可以合并），0表示不共线（不应合并）。
sub is_collinear {
    my ($direction_query, $direction_subject, $query_site_ref, $subject_site_ref,
        $cand_qstart, $cand_qend, $cand_sstart, $cand_send) = @_;

    my @subject_site = sort { $a <=> $b } @$subject_site_ref;
    my @query_site   = sort { $a <=> $b } @$query_site_ref;
    my ($subject_min, $subject_max) = ($subject_site[0], $subject_site[-1]);
    my ($query_min, $query_max)     = ($query_site[0], $query_site[-1]);

    my ($cs_min, $cs_max) = sort { $a <=> $b } ($cand_sstart, $cand_send);
    my ($cq_min, $cq_max) = sort { $a <=> $b } ($cand_qstart, $cand_qend);

    # combined_sign为1，表示subject坐标增大方向和query坐标增大方向一致（例如正常正链基因）；
    # 为-1，表示两者方向相反（例如基因位于基因组负链，但蛋白query坐标仍按正常顺序给出）。
    my $subject_sign  = ( $direction_subject eq "plus" ) ? 1 : -1;
    my $query_sign    = ( $direction_query   eq "plus" ) ? 1 : -1;
    my $combined_sign = $subject_sign * $query_sign;

    if ( $cs_min > $subject_max ) {
        # 候选HSP在基因组坐标上位于当前HSP组的右侧（更靠后的基因组位置），
        # 要求候选HSP在query坐标上也要相应地向"前进方向"延伸。
        return $combined_sign == 1 ? ( $cq_max >= $query_max ) : ( $cq_min <= $query_min );
    }
    elsif ( $cs_max < $subject_min ) {
        # 候选HSP在基因组坐标上位于当前HSP组的左侧（更靠前的基因组位置）。
        return $combined_sign == 1 ? ( $cq_min <= $query_min ) : ( $cq_max >= $query_max );
    }
    else {
        # 候选HSP在基因组坐标上和当前HSP组有重叠，不做额外的共线性限制（保持原有宽松行为）。
        return 1;
    }
}

sub get_distance {
    my $out = 0;
    if ( $_[0] <= $_[3] && $_[1] >= $_[2] ) {
        my $value1 = abs($_[2] - $_[1]) - 1;
        my $value2 = abs($_[0] - $_[3]) - 1;
        $out = $value1;
        $out = $value2 if $value2 < $value1;
        $out = 0 - $out;
    }
    elsif ( $_[2] > $_[1] )  {
        $out = $_[2] - $_[1] - 1;
    }
    elsif ( $_[0] > $_[3] ) {
        $out = $_[0] - $_[3] - 1;
    }
    return $out;
}

# 本程序用于计算Hit A和Hit B的重叠比例。前者是Evalue值更小的Hit。程序计算对B的覆盖率。
# 该子程序被 parsingHSP 调用（传入的是字符串形式的HSPs信息），保留原有实现。
sub cal_overlap_ratio {
    my ($hitA, $hitB) = @_;

    # 得到Hit A和Hit B的HSPs信息
    my (@HSPA, @HSPB);
    @_ = split /\t/, $hitA;
    foreach ( split /,/, $_[-1] ) {
        push @HSPA, "$1\t$2" if m/(\d+)-(\d+)/;
    }
    @_ = split /\t/, $hitB;
    foreach ( split /,/, $_[-1] ) {
        push @HSPB, "$1\t$2" if m/(\d+)-(\d+)/;
    }

    # 计算Hit A和Hit B的重叠区域
    my @overlap;
    foreach my $HSPA ( @HSPA ) {
        my ($startA, $endA) = split /\t/, $HSPA;
        ($startA, $endA) = ($endA, $startA) if $startA > $endA;
        foreach my $HSPB ( @HSPB ) {
            my ($startB, $endB) = split /\t/, $HSPB;
            ($startB, $endB) = ($endB, $startB) if $startB > $endB;
            if ( $startA <= $endB && $startB <= $endA ) {
                my @sites = sort { $a <=> $b } ($startA, $endA, $startB, $endB);
                push @overlap, "$sites[1]\t$sites[2]";
            }
        }
    }

    # 计算重叠部分和HitB的碱基数
    my $overlap_length = &match_length(@overlap);
    my $HSPB_length = &match_length(@HSPB);
    my $ratio = 0;
    $ratio = $overlap_length / $HSPB_length if $HSPB_length;

    return $ratio;
}

# cal_overlap_ratio 的高速版本：直接接收已解析好的区间数组引用和Hit B的HSPs总长度，
# 避免在 Hits 去冗余的 O(n^2) 循环中反复进行字符串解析。
sub cal_overlap_ratio_fast {
    my ($HSPA, $HSPB, $HSPB_length) = @_;
    return 0 unless $HSPB_length;

    my @overlap;
    foreach my $a ( @$HSPA ) {
        foreach my $b ( @$HSPB ) {
            # @$HSPB 已按起点从小到大排序，一旦起点超出当前A区间的终点，后面的都不会重叠。
            last if $b->[0] > $a->[1];
            next if $b->[1] < $a->[0];
            my $start = $a->[0] > $b->[0] ? $a->[0] : $b->[0];
            my $end   = $a->[1] < $b->[1] ? $a->[1] : $b->[1];
            push @overlap, [$start, $end];
        }
    }

    return &region_length(\@overlap) / $HSPB_length;
}

# 计算一组区间（数组引用，元素为 [start, end]）的并集长度。
sub region_length {
    my @region = sort { $a->[0] <=> $b->[0] } @{$_[0]};
    my ($length, $cur_start, $cur_end);
    $length = 0;
    foreach ( @region ) {
        my ($start, $end) = @$_;
        if ( ! defined $cur_start ) {
            ($cur_start, $cur_end) = ($start, $end);
        }
        elsif ( $start > $cur_end + 1 ) {
            $length += $cur_end - $cur_start + 1;
            ($cur_start, $cur_end) = ($start, $end);
        }
        elsif ( $end > $cur_end ) {
            $cur_end = $end;
        }
    }
    $length += $cur_end - $cur_start + 1 if defined $cur_start;
    return $length;
}

sub match_length {
    my @inter_sorted_site;
    foreach (@_) {
        my @aaa = $_ =~ m/(\d+)/g;
        @aaa = sort { $a <=> $b } @aaa;
        push @inter_sorted_site, "$aaa[0]\t$aaa[1]";
    }
    @inter_sorted_site = sort { $a <=> $b } @inter_sorted_site;

    my $out_site_number = 0;
    my $former_region = shift @inter_sorted_site;
    my @aaa = $former_region =~ m/(\d+)/g;
    $out_site_number += ($aaa[1] - $aaa[0] + 1) if @aaa;
    foreach (@inter_sorted_site) {
        my @former_region = $former_region =~ m/(\d+)/g;
        my @present_region = $_ =~ m/(\d+)/g;

        if ($present_region[0] > $former_region[1]) {
            $out_site_number += ($present_region[1] - $present_region[0] + 1);
            $former_region = $_;
        }
        elsif ($present_region[1] > $former_region[1]) {
            $out_site_number += ($present_region[1] - $former_region[1]);
            $former_region = $_;
        }
        else {
            next
        }
    }
    return $out_site_number;
}

# 计算fasta文件中所有序列的总长度（bp），用于设置--HSP_max_distance的默认值。
# 逐行读取，不将整个文件读入内存，可用于较大的基因组文件。
sub get_fasta_total_length {
    my ($fasta_file) = @_;
    my $total_length = 0;
    open my $fh, "<", $fasta_file or die "Can not open fasta file $fasta_file, $!";
    while (<$fh>) {
        next if /^>/;
        chomp;
        $total_length += length($_);
    }
    close $fh;
    return $total_length;
}
