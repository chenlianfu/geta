#!/usr/bin/env perl

use strict;
use Getopt::Long;
use Cwd qw/abs_path getcwd cwd/;
use File::Basename;
use List::Util qw/shuffle/;
use POSIX ();

# ======================================================================
# 中文用法说明（英文用法说明位于程序最尾部的 __DATA__ 段，程序直接运行时默认显示英文用法说明）
# ======================================================================
my $usage_chinese = <<'USAGE_CN';
用法:
    __SCRIPT__ [options] Species_Directory train.gb

示例:
    __SCRIPT__ --onlytrain genes.only_train.gb --cpu 120 --gene_models_minimum_num_for_test 100 --gene_models_maximum_num_for_test 600 --gene_models_ratio_for_test 0.20 --gene_models_num_per_test 50 --tmp_dir BGM2AT.optimize_augustus.tmp --AUGUSTUS_CONFIG_PATH ./config --pstep 6 --rounds 6 --reduced_round 3 Species_Directory train.gb

[程序说明]
    本程序能利用train.gb中的基因模型，对AUGUSTUS的参数进行优化。相比于AUGUSTUS的optimize_augustus.pl程序一次仅能对一个参数进行优化，本程序可以充分利用所有CPU线程资源，一次性对所有参数同时优化，能减少计算时间消耗。本程序功能上也有减配：仅支持常规的AUGUSTUS参数优化，不支持CGP(comparative gene prediction)参数优化；要求用于检测的基因模型的尾部CDS包含终止密码子。

    程序输入的Species_Directory必须是一个物种文件夹名称，配合Linux环境变量中$AUGUSTUS_CONFIG_PATH指定的路径，或输入参数--AUGUSTUS_CONFIG_PATH(优先级更高)指定的路径。程序对$AUGUSTUS_CONFIG_PATH/species/Species_Directory/Species_Directory_parameters.cfg配置文件中的28个参数进行优化。若该配置文件不存在，则程序无法运行。

    程序运行原理：（1）首先解析metapars.cfg文件获得各个参数的取值范围，准备对每个参数最多取6个值，进行准确性检测，选最优值。（2）根据train.gb文件，随机挑选最多600条序列用于准确性检测。（3）对总共28个参数，每个参数约6个值，再将用于检测的600条序列分隔成多份，分别生成数据文件和命令行，由程序内置的Perl多进程worker(fork)并行检测分析，得到nucleotide、exon和gene水平的sensitivity和specifity值，计算得到整体accuracy = (3*nucleotide_sensitivity + 2*nucleotide_specificity + 4*exon_sensitivity + 3*exon_specificity + 2*gene_sensitivity + 1*gene_specificity)/15。（4）选择28个参数的最优值，计算其准确性均值。若某个参数最优值的准确性超过了上一轮的均值，则对parameters.cfg文件内容中的参数进行修改优化。（5）程序进行多轮优化，直至没有参数能被优化，或完成指定轮数截止。在进行到第3轮优化后，若某参数值的准确性有提升，则程序额外对参数的范围也进行收缩，以利于下一轮找到更优的参数值。（6）此外，程序还会对/Constant/gc_range_min、/Constant/gc_range_max、/Constant/amberprob、/Constant/ochreprob和/Constant/opalprob这5个参数进行修正。

    并行化由程序内置的Perl worker池完成，不依赖外部的parafly程序：父进程最多同时维持--cpu个worker子进程，每个worker执行一条etraining+augustus命令，一个worker结束后立即领取下一条命令。每条命令成功后会被记录到当前轮文件夹下的command.list.completed文件中，程序中断后重新运行时，已完成的命令不会重复运行。若有命令运行失败，程序会在该轮所有命令结束后报错并停止。

    程序运行时会在标准错误输出中显示进度(准备数据阶段和命令并行运行阶段)：当标准错误是终端时，使用\r在同一行刷新进度、已用时间和预计剩余时间；当标准错误被重定向到文件时，则每前进一定比例输出一整行进度信息。

    程序对AUGUSTUS配置目录仅修改物种文件夹下的parameters.cfg和metapars.cfg两个文件，修改前会将它们备份为“原文件名.日期时间.进程号”。用于修正Constant参数的etraining在独立的临时配置目录中运行，不会改写真实配置目录里的.pbl等模型文件。

[主要参数]
    --onlytrain <string>    default: None
    输入一个genebank格式文件，包含一些仅用于etraining的基因模型。

    --cpu <int>    default: 8
    程序运行etraining和augustus时的并行数(同时运行的worker数量，不小于1)。

    --gene_models_minimum_num_for_test <int>    default: 100
    每测试一个参数时，需要利用一定数量的基因模型来测试其准确性，本参数设置所用基因模型数量的下限。默认设置下，随机挑选train.gb中基因模型数量的20%进行检测，且最低不少于100个；若train.gb中的基因模型数量低于该值，则使用全部基因模型用于检测。

    --gene_models_maximum_num_for_test <int>    default: 600
    设置每测试一个参数时所用基因模型数量的上限。默认设置下，检测的基因模型数量最高不超过600个。

    --gene_models_ratio_for_test <float>    default: 0.20
    设置每测试一个参数时所用基因模型数量占train.gb中基因模型总数的比例，实际数量取整后再受最小值和最大值的限制。

    --gene_models_num_per_test <int>    default: 50
    每个augustus命令分析时检测的基因模型数量，此时使用所有其它基因模型进行etraining。对一个AUGUSTUS参数值进行检测时，需要运行 ceil(用于检测的基因模型数量 / 50) 个etraining和augustus命令(向上取整，整除时不额外增加)。运行完毕后，合并所有用于检测的基因模型在gene/exon/nucleotide水平上的TP/FP/FN值，再计算整体上的准确性值。

    --tmp_dir <string>    default: tmp_$date$pid
    程序运行时临时文件夹名称。若该文件夹中已存在某轮的roundN.stats文件，则程序跳过该轮，并从stats文件中恢复准确性阈值，从而实现断点续跑。

    --AUGUSTUS_CONFIG_PATH <string>    default: None
    设置AUGUSTUS软件的物种配置文件夹路径。在该路径下应该存在一个名为species的子文件夹，species文件夹下则存放物种名称文件夹。设置该参数有利于将物种配置文件存放到有权限读写的地方。需要注意的是：该参数比Linux下的$AUGUSTUS_CONFIG_PATH优先级更高；该参数指定的路径下还应该存在cgp、extrinsic、model、parameters和profile文件夹，运行etraining命令时需要依赖相应的文件。

    --pstep <int>    default: 6
    设置对一个参数进行优化时，用于比较的参数值个数(不小于2)。程序读取$AUGUSTUS_CONFIG_PATH/species/Species_Directory/Species_Directory_metapars.cfg内容确定优化的参数及其取值范围。例如，/IntronModel/d参数值的取值范围为100~950且是整数，默认情况下，则是比较100、270、440、610、780和950这六个参数值的优劣。程序会在取值范围内均匀选择5个参数值。该值越大，则计算量越大，可能越容易找到更优参数。

    --rounds <int>    default: 6
    设置程序优化的轮数。程序每轮对28个参数进行优化，直至某轮没有优化，或优化到指定轮数截止。

    --reduced_round <int>    default: 3
    程序会从第3轮结束后，缩小参数的取值范围。这样有利于寻找更优的参数值。而标准的AUGUSTUS的optimize_augustus.pl程序并没有该操作。有些参数取值数量低于--pstep参数设定值时，则不会缩小其取值范围。例如，/Constant/dss_end参数值为整数，只能取值0、1、2、3和4，则不会缩小其取值范围。缩小取值范围的方法：默认比较6个数据，按准确性结果从好到坏对这6个数据值进行排序，从排第2名往后寻找，直至同时找到比第一名大和小的值止。取找到的数值的最大和最小值作为新的取值范围。

    --min_intron_len <int>    default: 30
    设置augustus/etraining程序运行的--min_intron_len参数。augustus默认的参数值是39，对于一些小基因组来说，偏大。推荐对于较小基因组，将该参数值设置为20。

[帮助参数]
    --help    default: None
    Display the English help message and exit.

    --chinese_help    default: None
    显示中文用法说明并退出。
USAGE_CN

# 英文用法说明存放于程序尾部 __DATA__ 段，此处一次性读入。
my $usage_english = do { local $/; <DATA> };

if (@ARGV==0){ die usage_text($usage_english) }

my ($onlytrain, $cpu, $gene_models_num_per_test, $gene_models_minimum_num_for_test, $gene_models_maximum_num_for_test, $gene_models_ratio_for_test, $rounds, $tmp_dir, $AUGUSTUS_CONFIG_PATH, $pstep, $reduced_round, $help_flag, $chinese_help_flag, $min_intron_len, $cmdString);
GetOptions(
    "onlytrain:s" => \$onlytrain,
    "cpu:i" => \$cpu,
    "gene_models_num_per_test:i" => \$gene_models_num_per_test,
    "gene_models_minimum_num_for_test:i" => \$gene_models_minimum_num_for_test,
    "gene_models_maximum_num_for_test:i" => \$gene_models_maximum_num_for_test,
    "gene_models_ratio_for_test:f" => \$gene_models_ratio_for_test,
    "rounds:i" => \$rounds,
    "tmp_dir:s" => \$tmp_dir,
    "AUGUSTUS_CONFIG_PATH:s" => \$AUGUSTUS_CONFIG_PATH,
    "pstep:i" => \$pstep,
    "reduced_round:i" => \$reduced_round,
    "min_intron_len:i" => \$min_intron_len,
    "help" => \$help_flag,
    "chinese_help" => \$chinese_help_flag,
);

# 帮助信息和参数检查必须放在创建任何文件夹之前。
if ( $chinese_help_flag ) { die usage_text($usage_chinese) }
if ( $help_flag ) { die usage_text($usage_english) }
if ( @ARGV != 2 ) {
    die "Error: 需要且仅需要两个位置参数 Species_Directory 和 train.gb，当前给出了 " . scalar(@ARGV) . " 个。\n\n" . usage_text($usage_english);
}

$cpu ||= 8;
$gene_models_num_per_test ||= 50;
$gene_models_minimum_num_for_test ||= 100;
$gene_models_maximum_num_for_test ||= 600;
$gene_models_ratio_for_test ||= 0.20;
$rounds ||= 6;
$pstep ||= 6;
$reduced_round ||= 3;
$min_intron_len ||= 30;

die "Error: --pstep 的值必须不小于2。\n" if $pstep < 2;
die "Error: --cpu 的值必须不小于1。\n" if $cpu < 1;
die "Error: 输入文件 $ARGV[1] 不存在。\n" unless -e $ARGV[1];
die "Error: 输入文件 $onlytrain 不存在。\n" if $onlytrain && ! -e $onlytrain;

# 进度显示相关的全局状态：标准错误是终端时使用 \r 在同一行刷新；否则(如重定向到日志文件)按比例输出整行。
my $is_tty = ( -t STDERR ) ? 1 : 0;
my $progress_active = 0;

my $date = `date +%Y%m%d%H%M%S`; chomp($date);
$tmp_dir ||= "tmp_$date$$";
$tmp_dir = abs_path($tmp_dir) if -e $tmp_dir;
mkdir $tmp_dir unless -e $tmp_dir;
$tmp_dir = abs_path($tmp_dir);

# 当 Constant/decomp_num_steps > 1 时，推荐修改/Constant/gc_range_min和/Constant/gc_range_max的值。只需要做一次。
my $Constant_decomp_num_steps = 0;
# 推荐修改三种终止密码子的概率/Constant/amberprob、/Constant/ochreprob和/Constant/opalprob参数的值。只需要修改一次。
my $Constant_stop_codon_prob = 0;
# 断点续跑时，通过标记文件恢复以上两个状态。
$Constant_decomp_num_steps = 1 if -e "$tmp_dir/Constant_decomp_num_steps.done";
$Constant_stop_codon_prob = 1 if -e "$tmp_dir/Constant_stop_codon_prob.done";

# 使用绝对路径
my $file_testGeneModel = abs_path($ARGV[1]);
my $file_onlytrainGeneModel;
$file_onlytrainGeneModel = abs_path($onlytrain) if $onlytrain;
$AUGUSTUS_CONFIG_PATH = abs_path($AUGUSTUS_CONFIG_PATH) if $AUGUSTUS_CONFIG_PATH;
chdir $tmp_dir;

# 优先使用自己设置的AUGUSTUS物种配置路径。
$ENV{"AUGUSTUS_CONFIG_PATH"} = $AUGUSTUS_CONFIG_PATH if $AUGUSTUS_CONFIG_PATH;
# 分析AUGUSTUS物种文件夹
my $species_name = basename($ARGV[0]);
my $file_parameters = "$ENV{'AUGUSTUS_CONFIG_PATH'}/species/$species_name/${species_name}_parameters.cfg";
if ( -e $file_parameters ) {
    print STDERR "程序将对 $file_parameters 文件进行参数优化。\n";
}
else {
    die "Error: $file_parameters 文件不存在，程序没有优化的对象，停止运行。\n";
}

# 先备份metapars.cfg和parameters.cfg文件。
my $file_metapars = "$ENV{'AUGUSTUS_CONFIG_PATH'}/species/$species_name/${species_name}_metapars.cfg";
open IN, $file_metapars or die "Can not open file $file_metapars, $!";
open OUT, ">", "$file_metapars.$date.$$" or die "Error: Can not create file $file_metapars.$date.$$, $!";
while (<IN>) { print OUT; }
close IN; close OUT;
print STDERR "将$file_metapars文件备份到$file_metapars.$date.$$\n";
open IN, $file_parameters or die "Can not open file $file_parameters, $!";
open OUT, ">", "$file_parameters.$date.$$" or die "Error: Can not create file $file_parameters.$date.$$, $!";
while (<IN>) { print OUT; }
close IN; close OUT;
print STDERR "将$file_parameters文件备份到$file_parameters.$date.$$\n";

# 读取test基因模型和onlytrain基因模型。只保留含有LOCUS行的有效记录，CDS长度以LOCUS名称为键存放。
my @geneModels_test = &read_genbank($file_testGeneModel);
my $num_of_geneModels = scalar(@geneModels_test);
die "Error: 输入文件 $file_testGeneModel 中没有有效的基因模型(未找到LOCUS记录)。\n" if $num_of_geneModels == 0;
my %CDS_length_of_geneModel;
my @geneModels_onlytrain;
open OUT, ">", "$tmp_dir/all.gb" or die "Error: Can not create file $tmp_dir/all.gb, $!";
foreach my $record ( @geneModels_test ) {
    print OUT $record;
    my $locus = &locus_of($record);
    if ( exists $CDS_length_of_geneModel{$locus} ) {
        print STDERR "Warning: 输入文件中LOCUS名称 $locus 重复出现，其CDS长度以第一次出现的记录为准。\n";
        next;
    }
    $CDS_length_of_geneModel{$locus} = &cds_length_of_record($record);
    print STDERR "Warning: 基因模型 $locus 未能解析出CDS长度，其在nucleotide水平上的权重将为0。\n" if $CDS_length_of_geneModel{$locus} == 0;
}
if ( $onlytrain ) {
    @geneModels_onlytrain = &read_genbank($file_onlytrainGeneModel);
    foreach my $record ( @geneModels_onlytrain ) { print OUT $record; }
}
close OUT;

# 分析用于test的基因模型数量。
my $num_of_geneModels_for_test = int($num_of_geneModels * $gene_models_ratio_for_test);
if ( $num_of_geneModels < $gene_models_minimum_num_for_test ) {
    $num_of_geneModels_for_test = $num_of_geneModels;
}
elsif ( $num_of_geneModels * $gene_models_ratio_for_test > $gene_models_maximum_num_for_test ) {
    $num_of_geneModels_for_test = int($gene_models_maximum_num_for_test);
}
elsif ( $num_of_geneModels * $gene_models_ratio_for_test < $gene_models_minimum_num_for_test ) {
    $num_of_geneModels_for_test = int($gene_models_minimum_num_for_test);
}
$num_of_geneModels_for_test = $num_of_geneModels if $num_of_geneModels_for_test > $num_of_geneModels;
print STDERR "输入文件 $file_testGeneModel 中有 $num_of_geneModels 个基因模型，在每个参数优化测试中，随机使用使用其中 $num_of_geneModels_for_test 个基因模型用于准确性检测。\n";

# 进行一轮轮的参数优化
my $round_current = 1; my $accuracy_value = 0;
my $stop_flag = 0;   # 本轮没有参数被优化时置1，本轮收尾工作完成后再结束循环。
while ( $round_current <= $rounds  ) {
    print STDERR "\n\nROUND:\t$round_current\n";
    chdir $tmp_dir;

    # 若本轮有结果，则跳过，并从stats文件中恢复准确性阈值和终止状态。
    if ( -e "$tmp_dir/round$round_current.stats" ) {
        open IN, "$tmp_dir/round$round_current.stats" or die $!;
        my $stats_info = join "", <IN>;
        close IN;
        print $stats_info;
        if ( $stats_info =~ m/下一轮优化参数时的准确性阈值为\s+([\d\.]+)/ ) {
            my $threshold_resumed = $1;
            $accuracy_value = $threshold_resumed if $accuracy_value < $threshold_resumed;
        }
        $stop_flag = 1 if $stats_info =~ m/未能检测到更优的参数/;
        $round_current ++;
        last if $stop_flag;
        next;
    }
    my $outStats;

    # 读取参数值范围，得到每个参数进行比较的数据值。
    my %metapars = &get_metapars($file_metapars);

    # 准备本轮数据分析的文件夹
    if ( ! -e "$tmp_dir/round$round_current" ) {
        mkdir "$tmp_dir/round$round_current" or die "Error: can not create file $tmp_dir/round$round_current, $!";
    }
    chdir "$tmp_dir/round$round_current";
    # 进行准确性检测
    &analysis(\%metapars, \@geneModels_test, \@geneModels_onlytrain);

    # 分析最优参数
    my ($best_parameters_ref, $accuracy_ref) = &get_best_parameters(\%metapars);
    my %best_parameters = %{$best_parameters_ref};  #存放最优参数，键是参数名称，值是"参数值\taccuracy"。
    my %accuracy = %{$accuracy_ref}; # 双重哈希，存放参数名、数值、准确性（值）。

    print STDERR "在第 $round_current 轮分析中，其最优参数、其取值和准确性：\n";
    $outStats .= "在第 $round_current 轮分析中，其最优参数、其取值和准确性：\n";
    foreach ( sort keys %best_parameters ) {
        print STDERR "\t$_\t$best_parameters{$_}\n";
        $outStats .= "\t$_\t$best_parameters{$_}\n";
    }

    # 修改parameters.cfg文件参数并进行比较，得到改进的参数信息
    my @compare_result = &improve_parameters(\%best_parameters, $file_parameters, $accuracy_value);
    if ( @compare_result >= 1 ) {
        my $compare_result_num = @compare_result;
        print STDERR "在第 $round_current 轮参数优化中，有 $compare_result_num 个参数有优化：\n";
        $outStats .= "在第 $round_current 轮参数优化中，有 $compare_result_num 个参数有优化：\n";
        foreach ( sort @compare_result ) {
            print STDERR "\t$_\n";
            $outStats .= "\t$_\n";
        }
    }
    else {
        print STDERR "在第 $round_current 轮参数优化中，未能检测到更优的参数。\n";
        $outStats .= "在第 $round_current 轮参数优化中，未能检测到更优的参数。\n";
        $stop_flag = 1;
    }

    # 缩小参数值范围。本轮已无参数可优化(即将结束)时，不再修改metapars.cfg。
    if ( $round_current >= $reduced_round && ! $stop_flag ) {
        # 改写metapars.cfg文件内容。
        my @range_change = &modify_metapars(\%accuracy, $file_metapars, $accuracy_value);
        my $range_change_num = @range_change;
        print STDERR "在第 $round_current 轮参数优化中，有 $range_change_num 个参数的范围有优化：\n";
        $outStats .= "在第 $round_current 轮参数优化中，有 $range_change_num 个参数的范围有优化：\n";
        foreach ( @range_change  ) {
            print STDERR "\t$_\n";
            $outStats .= "\t$_\n";
        }
    }

    # 计算本轮所有最优参数准确性均值
    my $accuracy_value_current = &get_accuracy_value(\%best_parameters);
    $accuracy_value = $accuracy_value_current if $accuracy_value < $accuracy_value_current;
    print STDERR "在第 $round_current 轮参数优化中，最优参数的准确性均值为 $accuracy_value_current ；下一轮优化参数时的准确性阈值为 $accuracy_value。\n";
    $outStats .= "在第 $round_current 轮参数优化中，最优参数的准确性均值为 $accuracy_value_current ；下一轮优化参数时的准确性阈值为 $accuracy_value。\n";

    open OUT, ">", "$tmp_dir/round$round_current.stats"  or die $!;
    print OUT $outStats;
    close OUT;

    # 先离开本轮文件夹，再删除它。
    chdir $tmp_dir;
    $cmdString = "rm -rf $tmp_dir/round$round_current";
    print STDERR (localtime) . ": CMD: $cmdString\n";
    system($cmdString) == 0 or die "Error: Failed to excute: $cmdString\n";

    $round_current ++;
    last if $stop_flag;
}

chdir $tmp_dir;

# ======================================================================
# 子程序
# ======================================================================

# 子程序，将用法说明中的程序名占位符替换为实际的程序名。
sub usage_text {
    my $text = $_[0];
    my $name = $0;
    $text =~ s/__SCRIPT__/$name/g;
    return $text;
}

# 子程序，将秒数格式化为 HH:MM:SS。
sub format_time {
    my $sec = int( $_[0] + 0.5 );
    $sec = 0 if $sec < 0;
    return sprintf("%02d:%02d:%02d", int($sec / 3600), int(($sec % 3600) / 60), $sec % 60);
}

# 子程序，在标准错误中输出进度信息。
# 参数：标签、已完成数、总数、附加信息、起始时间(time)、已在本次运行中完成的数量(用于估算剩余时间)、
#       非终端时的输出间隔百分比、指向"上次输出档位"变量的引用。
# 标准错误是终端时，用 \r 回到行首并清除行尾，在同一行刷新；否则仅在进度跨过一个档位时输出一整行。
sub report_progress {
    my ($label, $done, $total, $extra, $t0, $done_session, $step_pct, $last_bucket_ref) = @_;
    my $pct = $total > 0 ? 100 * $done / $total : 100;
    my $elapsed = time() - $t0;
    my $eta_str = "--:--:--";
    if ( $done_session > 0 && $total > $done ) {
        $eta_str = format_time( $elapsed / $done_session * ( $total - $done ) );
    }
    elsif ( $total <= $done ) {
        $eta_str = "00:00:00";
    }
    my $text = sprintf("[%s] %d/%d (%.1f%%)", $label, $done, $total, $pct);
    $text .= " | $extra" if defined $extra && $extra ne '';
    $text .= " | 已用 " . format_time($elapsed) . " | 预计剩余 $eta_str";
    if ( $is_tty ) {
        print STDERR "\r$text\033[K";
        $progress_active = 1;
    }
    else {
        my $bucket = int( $pct / $step_pct );
        $bucket = int( 100 / $step_pct ) + 1 if $done >= $total;   # 完成时必定输出一次
        if ( ! defined $$last_bucket_ref || $bucket != $$last_bucket_ref ) {
            print STDERR "$text\n";
            $$last_bucket_ref = $bucket;
        }
    }
}

# 子程序，结束当前的进度行(输出换行)，以免后续信息与进度行混在一起。
sub progress_end {
    if ( $is_tty && $progress_active ) {
        print STDERR "\n";
        $progress_active = 0;
    }
}

# 子程序，判断字符串是否为普通数值(非nan/inf)。
sub is_number {
    my $value = $_[0];
    return 0 unless defined $value;
    return ( $value =~ m/^[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?$/ ) ? 1 : 0;
}

# 子程序，将字符串转为数值；nan、inf或其它非数值一律记为0。
sub to_number {
    my $value = $_[0];
    return is_number($value) ? $value + 0 : 0;
}

# 子程序，安全除法；分母不大于0时返回0。
sub safe_div {
    my ($numerator, $denominator) = @_;
    return 0 unless $denominator > 0;
    return $numerator / $denominator;
}

# 子程序，比较两个参数值是否不同。均为数值时按数值比较，否则按字符串比较。
sub values_differ {
    my ($x, $y) = @_;
    if ( is_number($x) && is_number($y) ) {
        my $max_abs = abs($x) > abs($y) ? abs($x) : abs($y);
        return ( abs($x - $y) > 1e-5 * $max_abs ) ? 1 : 0;
    }
    return ( $x ne $y ) ? 1 : 0;
}

# 子程序，读取genbank文件，返回有效记录(含LOCUS行)的列表，每条记录以"//\n"结尾。
sub read_genbank {
    my $file = $_[0];
    my @records;
    open(my $fh, "<", $file) or die "Error: Can not open file $file, $!";
    local $/ = "//\n";
    while ( my $record = <$fh> ) {
        next unless $record =~ m/^LOCUS\s+\S+/m;
        $record =~ s/^\s+//;
        $record =~ s/\s+$//;
        $record .= "\n//" unless $record =~ m{(?:^|\n)//$};
        $record .= "\n";
        push @records, $record;
    }
    close $fh;
    return @records;
}

# 子程序，获取一条genbank记录的LOCUS名称。
sub locus_of {
    my $record = $_[0];
    return ( $record =~ m/^LOCUS\s+(\S+)/m ) ? $1 : '';
}

# 子程序，计算一条genbank记录中所有CDS特征的碱基总长度。支持单外显子(CDS 123..456)、join(...)、complement(...)以及跨行的位置描述。
sub cds_length_of_record {
    my $record = $_[0];
    my @locations;
    my $in_cds = 0;
    foreach my $line ( split /\n/, $record ) {
        if ( $line =~ m/^\s{1,10}CDS\s+(\S.*?)\s*$/ ) {
            my $location = $1;
            $location =~ s/\s+//g;
            push @locations, $location;
            $in_cds = 1;
        }
        elsif ( $line =~ m/^\s{1,10}\S/ ) {
            $in_cds = 0;
        }
        elsif ( $in_cds && $line =~ m/^\s{11,}([^\s\/].*?)\s*$/ ) {
            my $fragment = $1;
            $fragment =~ s/\s+//g;
            $locations[-1] .= $fragment;
        }
        else {
            $in_cds = 0;
        }
    }
    my $length = 0;
    foreach my $location ( @locations ) {
        while ( $location =~ m/(\d+)\.\.(\d+)/g ) {
            $length += abs($2 - $1) + 1;
        }
    }
    return $length;
}

# 子程序，读取配置文件中某个参数的当前值。
sub get_cfg_value {
    my ($file, $name) = @_;
    open(my $fh, "<", $file) or die "Error: Can not open file $file, $!";
    while ( my $line = <$fh> ) {
        return $1 if $line =~ m{^\Q$name\E[ \t]+(\S+)};
    }
    return;
}

# 子程序，修改配置文件中某个参数的值，返回旧值；若配置文件中没有该参数，则不修改并返回undef。
sub set_cfg_value {
    my ($file, $name, $new_value) = @_;
    open(my $in, "<", $file) or die "Error: Can not open file $file, $!";
    my $info = join "", <$in>;
    close $in;
    my $old_value;
    $info =~ s{^(\Q$name\E[ \t]+)(\S+)}{ $old_value = $2; $1 . $new_value }me;
    return unless defined $old_value;
    open(my $out, ">", $file) or die "Error: Can not write file $file, $!";
    print $out $info;
    close $out;
    return $old_value;
}

# 子程序，创建一个独立的AUGUSTUS临时配置目录：仅复制当前物种文件夹，其它文件夹使用软链接。
sub make_config_copy {
    my $dest = $_[0];
    my $src = $ENV{'AUGUSTUS_CONFIG_PATH'};
    mkdir $dest unless -e $dest;
    opendir(my $dh, $src) or die "Error: Can not open directory $src, $!";
    foreach my $entry ( grep { $_ ne '.' && $_ ne '..' } readdir $dh ) {
        next if $entry eq 'species';
        symlink("$src/$entry", "$dest/$entry") unless -e "$dest/$entry";
    }
    closedir $dh;
    mkdir "$dest/species" unless -e "$dest/species";
    system("cp -a '$src/species/$species_name' '$dest/species/'") == 0 or die "Error: Failed to copy species directory $src/species/$species_name\n";
}

# 子程序，在独立的临时配置目录中对全部基因模型运行一次etraining，结果输出到指定文件。不会改写真实配置目录里的模型文件。
sub run_etraining_on_all {
    my $out_file = $_[0];
    my $config_copy = "$tmp_dir/etraining_config";
    system("rm -rf '$config_copy'");
    &make_config_copy($config_copy);
    my $cmdString = "etraining --min_intron_len=$min_intron_len --species=$species_name --AUGUSTUS_CONFIG_PATH=$config_copy $tmp_dir/all.gb > $out_file 2> /dev/null";
    print STDERR (localtime) . ": CMD: $cmdString\n";
    system($cmdString) == 0 or die "Error: Failed to excute: $cmdString\n";
    system("rm -rf '$config_copy'");
}

# 子程序，使用Perl内置的fork worker池并行运行命令文件中的每一行命令。
# 最多同时维持 $ncpu 个worker子进程；一个worker结束后立即领取下一条命令。
# 成功完成的命令序号(从0开始)追加记录到 "$list_file.completed"，重新运行时会跳过这些命令，实现断点续跑。
# 若有命令失败，则在所有命令结束后报错退出。
# 运行过程中在标准错误输出进度(终端中使用 \r 在同一行刷新)。
sub run_parallel_commands {
    my ($list_file, $ncpu) = @_;
    my $completed_file = "$list_file.completed";

    # 读取全部命令
    my @commands;
    open(my $fh, "<", $list_file) or die "Error: Can not open file $list_file, $!";
    while ( my $line = <$fh> ) {
        chomp $line;
        next if $line =~ m/^\s*$/;
        push @commands, $line;
    }
    close $fh;

    # 读取已完成命令的记录
    my %done;
    if ( -e $completed_file ) {
        open(my $cfh, "<", $completed_file) or die "Error: Can not open file $completed_file, $!";
        while ( my $line = <$cfh> ) {
            chomp $line;
            $done{$line} = 1 if $line =~ m/^\d+$/;
        }
        close $cfh;
    }

    my @todo = grep { ! $done{$_} } 0 .. $#commands;
    my $total = scalar(@commands);
    my $skipped = $total - scalar(@todo);
    print STDERR (localtime) . ": 并行运行 $total 条命令，其中 $skipped 条此前已完成而跳过，使用 $ncpu 个worker。\n";

    my %running;    # pid => 命令序号
    my @failed;     # 失败的命令序号

    # 进度显示所需的变量
    my $progress_label = "Round $round_current/$rounds 分析";
    my $t0 = time();
    my $done_count = $skipped;     # 已完成数(含此前已完成而跳过的)
    my $done_session = 0;          # 本次运行中完成的数量，用于估算剩余时间
    my $last_bucket;
    my $show = sub {
        &report_progress($progress_label, $done_count, $total,
            sprintf("运行中 %d | 失败 %d", scalar(keys %running), scalar(@failed)),
            $t0, $done_session, 5, \$last_bucket);
    };

    # 收到中断信号时，先终止所有worker再退出。
    my $terminate = sub {
        my $sig = $_[0];
        local $SIG{TERM} = 'IGNORE';
        kill 'TERM', keys %running if %running;
        1 while wait() > 0;
        &progress_end();
        die "Error: 收到信号 $sig，已终止所有worker。\n";
    };
    local $SIG{INT}  = $terminate;
    local $SIG{TERM} = $terminate;

    $show->() if @todo;

    while ( @todo || %running ) {
        # 补充worker
        my $spawned = 0;
        while ( @todo && scalar(keys %running) < $ncpu ) {
            my $idx = shift @todo;
            my $pid = fork();
            die "Error: fork failed, $!\n" unless defined $pid;
            if ( $pid == 0 ) {
                # worker子进程：执行命令，并以命令的成败作为退出状态。
                $SIG{INT} = 'DEFAULT';
                $SIG{TERM} = 'DEFAULT';
                my $ret = system($commands[$idx]);
                POSIX::_exit( $ret == 0 ? 0 : 1 );
            }
            $running{$pid} = $idx;
            $spawned = 1;
        }

        # 等待任意一个worker结束
        my $pid = wait();
        next if $pid <= 0;
        next unless exists $running{$pid};
        my $status = $?;
        my $idx = delete $running{$pid};
        if ( $status == 0 ) {
            open(my $cfh, ">>", $completed_file) or die "Error: Can not open file $completed_file, $!";
            print $cfh "$idx\n";
            close $cfh;
            $done_count ++;
            $done_session ++;
        }
        else {
            push @failed, $idx;
            &progress_end();
            print STDERR "Error: 命令运行失败: $commands[$idx]\n";
        }
        $show->();
    }

    # 结束进度行；若没有任何命令需要运行，则不输出进度。
    $show->() if $done_session == 0 && $total > 0 && $skipped == $total && ! $is_tty;
    &progress_end();

    if ( @failed ) {
        my $failed_num = scalar(@failed);
        my $show_num = $failed_num > 5 ? 5 : $failed_num;
        my $msg = "Error: 共有 $failed_num 条命令运行失败，例如：\n";
        foreach my $idx ( (sort { $a <=> $b } @failed)[0 .. $show_num-1] ) { $msg .= "\t$commands[$idx]\n"; }
        die $msg;
    }
}

sub get_accuracy_value {
    my %best_parameters_in = %{$_[0]};
    my ($out, $total, $num);
    foreach ( keys %best_parameters_in ) {
        @_ = split /\t/, $best_parameters_in{$_};
        if ( $_ ) {
            $num ++;
            $total += $_[1];
        }
    }
    $out = $num ? $total / $num : 0;
    $out = sprintf("%.4f", $out);
    return $out;
}

sub modify_metapars {
    my %accuracy = %{$_[0]};
    my $file_metapars = $_[1];
    my $accuracy_threshold = $_[2];
    my @out;

    open IN, $file_metapars or die $!;
    my $file_info = join "", <IN>;
    close IN;

    open OUT, ">", $file_metapars or die $!;
    foreach ( split /\n/, $file_info ) {
        my ( $parname, $range );
        if ( m/^#/ ) {
            print OUT "$_\n";
        }
        elsif ( m/^\s*$/ ) {
            print OUT "$_\n";
        }
        elsif ( /^\s*(\S+)\s+(.*)\s*/ ) {
            my $line = $_;
            ($parname, $range) = ($1, $2);
            if ( exists $accuracy{$parname} && $range =~ m/("[^"]+"([-_])"[^"]+")/ ) {
                # 获得文件中的取值范围；
                my ($old_range, $fuhao) = ($1, $2);

                # 寻找新的取值范围。首先，将取值按从好到坏排序。
                my @value = sort {$accuracy{$parname}{$b} <=> $accuracy{$parname}{$a}} keys %{$accuracy{$parname}};
                # 若参数取值数量少于 --pstep，则不进行范围收缩。
                if ( @value < $pstep ) {
                    print OUT "$line\n";
                    next;
                }

                my @new_value;
                # 将最优值加入到新的数组中
                my $first_value = shift @value; push @new_value, $first_value;
                # 若最优准确性值低于阈值，则不进行范围收缩。
                if ( $accuracy{$parname}{$first_value} <= $accuracy_threshold ) {
                    print OUT "$line\n";
                    next;
                }

                my ($found_high, $found_low) = (0, 0);
                # 将其它值加入到新的数组中，直至同时找到更大和更小值。
                foreach ( @value ) {
                    push @new_value, $_;
                    $found_high = 1 if $_ > $first_value;
                    $found_low = 1 if $_ < $first_value;
                    last if ($found_high == 1 && $found_low == 1);
                }
                # 获得新的范围数据
                @new_value = sort {$a <=> $b} @new_value;
                my $new_range = "\"$new_value[0]\"$fuhao\"$new_value[-1]\"";

                # 比较取值范围
                if ( $new_range ne $old_range ) {
                    my $out = sprintf("%-40s%-25s->  %s", $parname, $old_range, $new_range);
                    push @out, $out;
                    $line =~ s/\Q$old_range\E/$new_range/;
                    print OUT "$line\n";
                }
                else {
                    print OUT "$line\n";
                }
            }
            else {
                print OUT "$line\n";
            }
        }
        else {
            print OUT "$_\n";
        }
    }
    close OUT;

    my $out_num = 0; $out_num = @out if @out;
    print STDERR "对配置文件 $file_metapars 的参数范围进行了 $out_num 项修改。\n";

    return @out;
}

sub improve_parameters {
    my %best_par_in = %{$_[0]};
    my $file_for_modify = $_[1];
    my $accuracy_threshold = $_[2];
    my @out;

    # 将 %best_par_in 拆成两个哈希 %best_par 存放参数及其值； %best_accuracy 存放参数及其准确性。
    my (%best_par, %best_accuracy );
    foreach ( keys %best_par_in ) {
        @_ = split /\t/, $best_par_in{$_};
        $best_par{$_} = $_[0];
        $best_accuracy{$_} = $_[1];
    }

    open IN, $file_for_modify or die $!;
    my $file_info = join "", <IN>;
    close IN;

    open OUT, ">", $file_for_modify or die $!;
    foreach ( split /\n/, $file_info ) {
        if ( m/^#/ ) {
            print OUT "$_\n";
        }
        elsif ( m/^\s*$/ ) {
            print OUT "$_\n";
        }
        elsif ( m/^(\S+)(\s+)(\S+)(.*)/ ) {
            my ($par_name, $par_space, $par_old_value, $par_rest) = ($1, $2, $3, $4);
            # 参数值按数值比较，避免 0.0100 与 0.01 被误判为有修改。
            if ( exists $best_par{$par_name} && &values_differ($best_par{$par_name}, $par_old_value) && $best_accuracy{$par_name} > $accuracy_threshold ) {
                my $out = sprintf("%-40s%-10s ->  %s", "$par_name:", $par_old_value, $best_par{$par_name});
                push @out, $out;
                print OUT "$par_name$par_space$best_par{$par_name}$par_rest\n";
            }
            else {
                print OUT "$_\n";
            }
        }
        else {
            print OUT "$_\n";
        }
    }
    close OUT;

    my $out_num = 0; $out_num = @out if @out;
    print STDERR "对配置文件 $file_for_modify 的参数进行了 $out_num 项修改。\n";

    # 运行一次 etraining，以用于修改/Constant/amberprob、/Constant/ochreprob、/Constant/opalprob、/Constant/gc_range_min 和 /Constant/gc_range_max 这5个参数的值。
    # etraining在独立的临时配置目录中运行，不会改写真实配置目录里的模型文件。

    # 若配置文件中 /Constant/decomp_num_steps 的当前值 > 1，需要修改 /Constant/gc_range_min 和 /Constant/gc_range_max的值。
    my $decomp_num_steps_current = &get_cfg_value($file_for_modify, "/Constant/decomp_num_steps");
    if ( is_number($decomp_num_steps_current) && $decomp_num_steps_current > 1 && $Constant_decomp_num_steps == 0 ) {
        $Constant_decomp_num_steps = 1;
        open(my $marker, ">", "$tmp_dir/Constant_decomp_num_steps.done"); close $marker;
        my ($gc_range_min, $gc_range_max);
        &run_etraining_on_all("$tmp_dir/etraining.out");
        open IN, "$tmp_dir/etraining.out" or die $!;
        while (<IN>) {
            if (m#/Constant/gc_range_min to (\S*) and /Constant/gc_range_max to (\S+)#) {
                ($gc_range_min, $gc_range_max) = ($1, $2);
                last;
            }
        }
        close IN;

        if ( defined $gc_range_min && $gc_range_min ne '' && defined $gc_range_max && $gc_range_max ne '' ) {
            my $old_gc_range_min = &set_cfg_value($file_for_modify, "/Constant/gc_range_min", $gc_range_min);
            my $old_gc_range_max = &set_cfg_value($file_for_modify, "/Constant/gc_range_max", $gc_range_max);
            $old_gc_range_min = "NA" unless defined $old_gc_range_min;
            $old_gc_range_max = "NA" unless defined $old_gc_range_max;

            print STDERR "由于 /Constant/decomp_num_steps 参数的值 > 1，对配置文件 $file_for_modify 的参数进行了两项额外修改：\n\t/Constant/gc_range_min:  $old_gc_range_min  ->  $gc_range_min\n\t/Constant/gc_range_max:  $old_gc_range_max  ->  $gc_range_max\n";

            if ( $old_gc_range_min ne $gc_range_min ) {
                my $out = sprintf("%-40s%-10s ->  %s", "/Constant/gc_range_min:", $old_gc_range_min, $gc_range_min);
                push @out, $out;
            }
            if ( $old_gc_range_max ne $gc_range_max ) {
                my $out = sprintf("%-40s%-10s ->  %s", "/Constant/gc_range_max:", $old_gc_range_max, $gc_range_max);
                push @out, $out;
            }
        }
        else {
            print STDERR "Warning: 未能从 etraining 输出中获得 /Constant/gc_range_min 和 /Constant/gc_range_max 的建议值，未作修改。\n";
        }
    }

    # 修改 /Constant/amberprob、/Constant/ochreprob和/Constant/opalprob参数值。
    if ( $Constant_stop_codon_prob == 0 ) {
        $Constant_stop_codon_prob = 1;
        open(my $marker, ">", "$tmp_dir/Constant_stop_codon_prob.done"); close $marker;
        # 若没有 etraining 结果，则执行 etraining。
        if ( ! -e "$tmp_dir/etraining.out" ) {
            &run_etraining_on_all("$tmp_dir/etraining.out");
        }

        # 获取三种终止密码止概率
        my ($tag_prob, $taa_prob, $tga_prob) = (0.33, 0.33, 0.34);
        open IN, "$tmp_dir/etraining.out" or die $!;
        while (<IN>) {
            $tag_prob = $1 if m/^tag:.*\((\S+?)\)/;
            $taa_prob = $1 if m/^taa:.*\((\S+?)\)/;
            $tga_prob = $1 if m/^tga:.*\((\S+?)\)/;
        }
        close IN;

        # 修改参数文件
        my $old_tag_prob = &set_cfg_value($file_for_modify, "/Constant/amberprob", $tag_prob);
        my $old_taa_prob = &set_cfg_value($file_for_modify, "/Constant/ochreprob", $taa_prob);
        my $old_tga_prob = &set_cfg_value($file_for_modify, "/Constant/opalprob", $tga_prob);
        $old_tag_prob = "NA" unless defined $old_tag_prob;
        $old_taa_prob = "NA" unless defined $old_taa_prob;
        $old_tga_prob = "NA" unless defined $old_tga_prob;

        print STDERR "对配置文件 $file_for_modify 的参数进行了三项额外修改：\n\t/Constant/amberprob:  $old_tag_prob  ->  $tag_prob\n\t/Constant/ochreprob:  $old_taa_prob  ->  $taa_prob\n\t/Constant/opalprob:   $old_tga_prob  ->  $tga_prob\n";

        if ( $old_tag_prob ne $tag_prob ) {
            my $out = sprintf("%-40s%-10s ->  %s", "/Constant/amberprob:", $old_tag_prob, $tag_prob);
            push @out, $out;
        }
        if ( $old_taa_prob ne $taa_prob ) {
            my $out = sprintf("%-40s%-10s ->  %s", "/Constant/ochreprob:", $old_taa_prob, $taa_prob);
            push @out, $out;
        }
        if ( $old_tga_prob ne $tga_prob ) {
            my $out = sprintf("%-40s%-10s ->  %s", "/Constant/opalprob:", $old_tga_prob, $tga_prob);
            push @out, $out;
        }
    }

    return @out;
}


sub get_best_parameters {
    my %metapars = %{$_[0]};

    #
    my (%out, %out3);

    # 读取结果文件路径
    open IN, "command.list" or die "Can not open file command.list";
    my %result_file;
    while (<IN>) {
        $result_file{$2}{$1} = 1 if m/.*>\s+((.*)\/\d+.out)\n$/;
    }
    close IN;

    # 分析每个参数多个取值的准确性
    print STDERR "本轮所有参数取值及其准确性如下：\n";
    foreach my $par_name_orig ( sort keys %metapars ) {
        my $par_name = $par_name_orig;
        $par_name =~ s#^/##; $par_name =~ s#/#_#g;
        my (%out2, %sort1, %sort2, %sort3);
        foreach my $value ( sort {$a <=> $b} keys %{$metapars{$par_name_orig}} ) {
            # 分析nucleotide、exon和gene的标准注释数量、预测数量、TP数量。
            my ($nucleotide_annot, $nucleotide_pred, $nucleotide_TP, $exon_annot, $exon_pred, $exon_TP, $gene_annot, $gene_pred, $gene_TP) = (0,0,0,0,0,0,0,0,0);

            # 每个参数取值有多个命令的结果
            foreach my $file_out ( keys %{$result_file{"${par_name}_$value"}} ) {
                # 分析nucleotide水平上的CDS碱基长度
                my $file_TotalCDSLength = $file_out;
                $file_TotalCDSLength =~ s/\.out/\.TotalCDSLength/;
                open IN, $file_TotalCDSLength or die $!;
                my $TotalCDSLength = <IN>;
                close IN;
                $TotalCDSLength = to_number($TotalCDSLength);
                $nucleotide_annot += $TotalCDSLength;

                # 分析augusts检测结果文件。数值字段允许出现nan等非数值内容，此时按0处理，分母为0时特异性记0。
                open IN, $file_out or die $!;
                while (<IN>) {
                    if ( m/nucleotide level[\s|]+([^\s|]+)[\s|]+([^\s|]+)/ ) {
                        my ($sn_str, $sp_str) = ($1, $2);
                        my $sn = to_number($sn_str);
                        my $sp = to_number($sp_str);
                        $nucleotide_TP += int($TotalCDSLength * $sn + 0.5);
                        $nucleotide_pred += int($TotalCDSLength * $sn / $sp + 0.5) if $sp > 0;
                    }
                    elsif ( m/exon level[\s|]+([^\s|]+)[\s|]+([^\s|]+)[\s|]+([^\s|]+)/ ) {
                        my ($pred_str, $annot_str, $tp_str) = ($1, $2, $3);
                        $exon_pred += to_number($pred_str);
                        $exon_annot += to_number($annot_str);
                        $exon_TP += to_number($tp_str);
                    }
                    elsif ( m/gene level[\s|]+([^\s|]+)[\s|]+([^\s|]+)[\s|]+([^\s|]+)/ ) {
                        my ($pred_str, $annot_str, $tp_str) = ($1, $2, $3);
                        $gene_pred += to_number($pred_str);
                        $gene_annot += to_number($annot_str);
                        $gene_TP += to_number($tp_str);
                    }
                }
                close IN;
            }

            my ($nucleotide_sensitivity, $nucleotide_specificity, $exon_sensitivity, $exon_specificity, $gene_sensitivity, $gene_specificity) = (0,0,0,0,0,0);
            $nucleotide_sensitivity = safe_div($nucleotide_TP, $nucleotide_annot);
            $nucleotide_specificity = safe_div($nucleotide_TP, $nucleotide_pred);
            $exon_sensitivity = safe_div($exon_TP, $exon_annot);
            $exon_specificity = safe_div($exon_TP, $exon_pred);
            $gene_sensitivity = safe_div($gene_TP, $gene_annot);
            $gene_specificity = safe_div($gene_TP, $gene_pred);

            my $accuracy = ($nucleotide_sensitivity * 3 + $nucleotide_specificity * 2 + $exon_sensitivity * 4 + $exon_specificity * 3 + $gene_sensitivity * 2 + $gene_specificity * 1) / 15;

            my $accuracy_out = sprintf("%0.4f\t%0.4f\t%0.4f\t%0.4f\t%0.4f\t%0.4f\t%0.4f", $nucleotide_sensitivity, $nucleotide_specificity, $exon_sensitivity, $exon_specificity, $gene_sensitivity, $gene_specificity, $accuracy);
            # %out2 存放核酸、exon和gene水平的准确性数据。
            $out2{"$par_name_orig  $value:\t$accuracy_out\n"} = $accuracy;
            $sort1{"$par_name_orig  $value:\t$accuracy_out\n"} = $exon_sensitivity;
            $sort2{"$par_name_orig  $value:\t$accuracy_out\n"} = $nucleotide_sensitivity;
            $sort3{"$par_name_orig  $value:\t$accuracy_out\n"} =  $gene_sensitivity;
            # %out3 存放参数取值的整体准确性数据。
            $out3{$par_name_orig}{$value} = sprintf("%0.4f", $accuracy);
        }
        my @out2 = sort {$out2{$b}<=> $out2{$a} or $sort1{$b} <=> $sort1{$a} or $sort2{$b} <=> $sort2{$a} or $sort3{$b} <=> $sort3{$a} or $a cmp $b} keys %out2;
        my $best = shift @out2;
        print STDERR "*$best";
        foreach ( @out2 ) { print STDERR; }
        # %out 存放参数的最优值。
        my $best_accuracy = sprintf("%0.4f", $out2{$best});
        $out{$par_name_orig} = "$1\t$best_accuracy" if $best =~ m/(\S+):/;
    }

    # 返回两个哈希。
    return (\%out, \%out3);
}


# 核心算法，输入检测用基因模型、仅训练用基因模型和各参数的比较值。进行准确性分析。
sub analysis {
    my %metapars = %{$_[0]};
    my @GM_test = @{$_[1]};
    my @GM_onlytrain = @{$_[2]};

    unless ( -e "prepare_data.ok" ) {
    open OUT, ">", "command.list" or die $!; close OUT;
    # 重新生成命令列表时，清除旧的完成记录。
    unlink "command.list.completed" if -e "command.list.completed";

    # 预先计算需要生成的命令总数，用于显示准备数据阶段的进度。
    my $cmds_per_value = int( ( $num_of_geneModels_for_test + $gene_models_num_per_test - 1 ) / $gene_models_num_per_test );
    my $prepare_total = 0;
    foreach my $par_name_orig ( keys %metapars ) {
        $prepare_total += scalar( keys %{$metapars{$par_name_orig}} ) * $cmds_per_value;
    }
    my $prepare_done = 0;
    my $prepare_t0 = time();
    my $prepare_last_bucket;
    my $prepare_label = "Round $round_current/$rounds 准备数据";

    foreach my $par_name_orig ( sort keys %metapars ) {
        my $par_name = $par_name_orig;
        $par_name =~ s#^/##; $par_name =~ s#/#_#g;
        # 对每个参数取的每个值，进行准确性检测。随机选取一定数量的基因模型group1用于检测。
        @GM_test = shuffle(@GM_test);
        my @GM_test_group1 = @GM_test[0..$num_of_geneModels_for_test-1];
        my @GM_test_group2 = @GM_test[$num_of_geneModels_for_test..$#GM_test];

        foreach my $value ( sort {$a <=> $b} keys %{$metapars{$par_name_orig}} ) {
            # 准备数据存放文件夹
            mkdir "${par_name}_$value" unless -e "${par_name}_$value";

            # 默认设置下，使用group1中每50个基因模型运行一次etraining和augustus进行检测，生成train和test的基因模型
            my @GM_test_group = ();
            my $para_num = 0;
            # 每个etraing和augustus命令从group1中挑出前50个基因模型。
            my @GM_test_group1_new = @GM_test_group1;  #避免修改@GM_test_group1中的信息。
            while ( @GM_test_group1_new ) {
                $para_num ++;
                mkdir "${par_name}_$value/$para_num" unless -e "${par_name}_$value/$para_num";
                my @GM_test_group_test;
                foreach ( 1 .. $gene_models_num_per_test ) {
                    if ( @GM_test_group1_new ) {
                        push @GM_test_group_test, shift @GM_test_group1_new;
                    }
                }

                # 生成每个命令的train和test基因模型
                open OUT, ">", "${par_name}_$value/$para_num/test.gb" or die "Error: Can not create file ${par_name}_$value/$para_num/test.gb, $!";
                foreach ( @GM_test_group_test ) { print OUT; }
                close OUT;
                open OUT, ">", "${par_name}_$value/$para_num/train.gb" or die "Error: Can not create file ${par_name}_$value/$para_num/train.gb, $!";
                foreach ( @GM_test_group ) { print OUT; }
                foreach ( @GM_test_group1_new ) { print OUT; }
                foreach ( @GM_test_group2 ) { print OUT; }
                if ( $onlytrain ) { foreach ( @GM_onlytrain ) { print OUT; } }
                close OUT;

                # 生成test.gb中所有基因模型的CDS总长度信息。以LOCUS名称查找CDS长度。
                my $CDS_length_total = 0;
                foreach ( @GM_test_group_test ) {
                    $CDS_length_total += $CDS_length_of_geneModel{ &locus_of($_) } || 0;
                }
                open OUT, ">", "${par_name}_$value/$para_num.TotalCDSLength" or die $!;
                print OUT $CDS_length_total;
                close OUT;

                push @GM_test_group, @GM_test_group_test;

                # 给每个命令准备参数配置文件
                system("cp -a $ENV{'AUGUSTUS_CONFIG_PATH'}/* ${par_name}_$value/$para_num/");
                open IN, "${par_name}_$value/$para_num/species/$species_name/${species_name}_parameters.cfg" or die $!;
                my $info = join "", <IN>;
                close IN;
                $info =~ s/($par_name_orig\s+)\S+/$1$value/;
                open OUT, ">", "${par_name}_$value/$para_num/species/$species_name/${species_name}_parameters.cfg" or die $!;
                print OUT $info;
                close OUT;

                # 给出命令行。使用 > /dev/null 2>&1 而非 &>，避免 /bin/sh 为 dash 时 etraining 被放入后台运行。
                open OUT, ">>", "command.list" or die $!;
                print OUT "etraining --min_intron_len=$min_intron_len --species=$species_name --AUGUSTUS_CONFIG_PATH=${par_name}_$value/$para_num ${par_name}_$value/$para_num/train.gb > /dev/null 2>&1; augustus --min_intron_len=$min_intron_len --species=$species_name --AUGUSTUS_CONFIG_PATH=${par_name}_$value/$para_num ${par_name}_$value/$para_num/test.gb > ${par_name}_$value/$para_num.out\n";
                close OUT;

                # 显示准备数据阶段的进度。
                $prepare_done ++;
                &report_progress($prepare_label, $prepare_done, $prepare_total,
                    "当前参数 $par_name_orig", $prepare_t0, $prepare_done, 10, \$prepare_last_bucket);
            }
        }
    }
    &progress_end();

    open OUT, ">", "prepare_data.ok"; close OUT;
    }

    # 使用内置的Perl worker池并行运行所有命令。
    print STDERR (localtime) . ": 使用Perl worker池并行运行 command.list 中的命令，cpu = $cpu\n";
    &run_parallel_commands("command.list", $cpu);
}

# 子程序，分析metapars.cfg文件，根据其取值范围，得到具体的取值信息。
sub get_metapars {
    my $file_metapars = $_[0];
    my %metapars;

    open IN, $file_metapars or die "Can not open file $file_metapars, $!";
    # 以下代码借鉴了 optimize_augustus.pl 内容
    while (<IN>) {
        next if m/^#/;
        if ( /^\s*(\S+)\s+(.*)\s*/ ) {
            my ($parname, $range) = ($1, $2);
            my @testlist;
            if ( $range =~ /"([^"]+)"-"([^"]+)"/ ) {
                # 整数取值范围
                my ($range_low, $range_high) = ($1, $2);
                for ( my $n = 0; $n < $pstep; $n ++ ) {
                    my $tv = int( $range_low + $n * ( $range_high - $range_low ) / ( $pstep - 1 ) );
                    if ( ! @testlist || $tv != $testlist[-1] ) {
                        push @testlist, $tv;
                    }
                }
            }
            elsif ( $range =~ /"([^"]+)"_"([^"]+)"/ ) {
                # 浮点数取值范围，统一格式化，避免出现 0.18000000000000002 这类字符串。
                my ($range_low, $range_high) = ($1, $2);
                for ( my $n = 0; $n < $pstep; $n ++ ) {
                    my $tv = sprintf("%.6g", $range_low + $n * ( $range_high - $range_low ) / ( $pstep - 1 ) );
                    push @testlist, $tv;
                }
            }
            else {
                # 列举的取值
                foreach my $item ( split /\s+/, $range ) {
                    next if $item eq '';
                    $item =~ s/^"(.*)"$/$1/;
                    push @testlist, $item;
                }
            }
            foreach my $tv ( @testlist ) {
                $metapars{$parname}{$tv} = 1;
            }
        }
    }
    close IN;

    return %metapars;
}

# ======================================================================
# 英文用法说明(English usage)存放于以下 __DATA__ 段。
# ======================================================================
__DATA__
Usage:
    __SCRIPT__ [options] Species_Directory train.gb

For example:
    __SCRIPT__ --onlytrain genes.only_train.gb --cpu 120 --gene_models_minimum_num_for_test 100 --gene_models_maximum_num_for_test 600 --gene_models_ratio_for_test 0.20 --gene_models_num_per_test 50 --tmp_dir BGM2AT.optimize_augustus.tmp --AUGUSTUS_CONFIG_PATH ./config --pstep 6 --rounds 6 --reduced_round 3 Species_Directory train.gb

[Description]
    This program optimizes the parameters of AUGUSTUS using the gene models in train.gb. The optimize_augustus.pl program shipped with AUGUSTUS optimizes only one parameter at a time, whereas this program makes full use of all CPU threads and optimizes all parameters simultaneously, which reduces the running time. It also has fewer features: only the regular AUGUSTUS parameter optimization is supported, comparative gene prediction (CGP) parameter optimization is not supported, and the last CDS of every gene model used for testing must contain a stop codon.

    The input Species_Directory must be the name of a species folder, used together with the path given by the environment variable $AUGUSTUS_CONFIG_PATH or by the option --AUGUSTUS_CONFIG_PATH (which has higher priority). The program optimizes the 28 parameters in the configuration file $AUGUSTUS_CONFIG_PATH/species/Species_Directory/Species_Directory_parameters.cfg. If this file does not exist, the program cannot run.

    How it works: (1) The metapars.cfg file is parsed to get the value range of each parameter, and at most 6 values are prepared for each parameter for the accuracy test, from which the best value is chosen. (2) At most 600 sequences are randomly picked from train.gb for the accuracy tests. (3) For the 28 parameters with about 6 values each, the test sequences are split into several parts, data files and command lines are generated for each part, and the built-in Perl multi-process workers (fork) run the analyses in parallel, giving the sensitivity and specificity at the nucleotide, exon and gene levels; the overall accuracy = (3*nucleotide_sensitivity + 2*nucleotide_specificity + 4*exon_sensitivity + 3*exon_specificity + 2*gene_sensitivity + 1*gene_specificity)/15. (4) The best value of each of the 28 parameters is selected and the mean of their accuracies is calculated; if the accuracy of the best value of a parameter exceeds the mean of the previous round, that parameter is updated in the parameters.cfg file. (5) The optimization runs for several rounds, until no parameter can be improved or the specified number of rounds is reached. From the end of round 3, if the accuracy of a parameter has improved, the value range of the parameter is also narrowed to help find better values in the next round. (6) In addition, the program corrects the 5 parameters /Constant/gc_range_min, /Constant/gc_range_max, /Constant/amberprob, /Constant/ochreprob and /Constant/opalprob.

    Parallelization is done by a built-in Perl worker pool and no external parafly program is needed: the parent process keeps at most --cpu worker processes running at the same time, each worker executes one etraining+augustus command, and a worker that finishes immediately picks up the next command. Every command that finishes successfully is recorded in the file command.list.completed in the folder of the current round, so commands that have already finished are not run again when an interrupted run is resumed. If any command fails, the program reports an error and stops after all commands of that round have ended.

    While running, the program reports its progress on the standard error (data preparation stage and parallel command stage). When the standard error is a terminal, the progress, elapsed time and estimated remaining time are refreshed on a single line using \r; when the standard error is redirected to a file, one full progress line is written each time a certain percentage is passed.

    Within the AUGUSTUS configuration directory, the program modifies only the parameters.cfg and metapars.cfg files of the species folder, and both files are backed up as "original_file_name.date_time.process_id" before modification. The etraining run used to correct the Constant parameters is executed in a separate temporary configuration directory, so the model files (such as .pbl files) in the real configuration directory are never rewritten.

[Main options]
    --onlytrain <string>    default: None
    Input a genbank format file containing gene models that are used for etraining only.

    --cpu <int>    default: 8
    Number of parallel processes used when running etraining and augustus (number of simultaneous workers, at least 1).

    --gene_models_minimum_num_for_test <int>    default: 100
    Every parameter test needs a number of gene models to measure the accuracy, and this option sets the lower limit of that number. By default 20% of the gene models in train.gb are randomly picked for testing, and no fewer than 100; if train.gb contains fewer gene models than this value, all gene models are used for testing.

    --gene_models_maximum_num_for_test <int>    default: 600
    Set the upper limit of the number of gene models used for each parameter test. By default no more than 600 gene models are used for testing.

    --gene_models_ratio_for_test <float>    default: 0.20
    Set the proportion of the gene models in train.gb that are used for each parameter test. The resulting number is truncated to an integer and then limited by the minimum and the maximum numbers.

    --gene_models_num_per_test <int>    default: 50
    Number of gene models tested by each augustus command, with all the other gene models used for etraining. Testing one AUGUSTUS parameter value requires ceil(number of gene models for testing / 50) etraining and augustus commands (rounded up, with no extra command when the number divides evenly). After all commands finish, the TP/FP/FN values at the gene/exon/nucleotide levels of all tested gene models are merged and the overall accuracy is calculated.

    --tmp_dir <string>    default: tmp_$date$pid
    Name of the temporary folder used while the program runs. If a roundN.stats file already exists in this folder, that round is skipped and the accuracy threshold is restored from the stats file, so that an interrupted run can be resumed.

    --AUGUSTUS_CONFIG_PATH <string>    default: None
    Set the path of the AUGUSTUS species configuration folder. This path must contain a subfolder named species, which in turn holds the species folders. Setting this option makes it possible to keep the species configuration in a location with read and write permission. Note that this option has higher priority than the environment variable $AUGUSTUS_CONFIG_PATH, and that the path must also contain the folders cgp, extrinsic, model, parameters and profile, whose files are needed when running etraining.

    --pstep <int>    default: 6
    Set the number of values compared when optimizing one parameter (at least 2). The program reads $AUGUSTUS_CONFIG_PATH/species/Species_Directory/Species_Directory_metapars.cfg to determine the parameters to optimize and their value ranges. For example, if /IntronModel/d is an integer in the range 100~950, the six values 100, 270, 440, 610, 780 and 950 are compared by default, i.e. 5 values are evenly chosen within the range. A larger value means more computation and possibly a better chance to find better parameters.

    --rounds <int>    default: 6
    Set the number of optimization rounds. In each round the 28 parameters are optimized, until a round yields no improvement or the specified number of rounds is reached.

    --reduced_round <int>    default: 3
    From the end of round 3 the program narrows the value ranges of the parameters, which helps to find better values; the standard optimize_augustus.pl of AUGUSTUS does not do this. Parameters with fewer possible values than --pstep are not narrowed. For example, /Constant/dss_end is an integer that can only be 0, 1, 2, 3 or 4, so its range is not narrowed. How the range is narrowed: by default 6 values are compared and sorted by accuracy from best to worst; starting from the second best, the search continues until both a value larger and a value smaller than the best one have been found, and the minimum and maximum of the values found become the new range.

    --min_intron_len <int>    default: 30
    Set the --min_intron_len option of augustus and etraining. The default in augustus is 39, which is too large for some small genomes; 20 is recommended for smaller genomes.

[Help options]
    --help    default: None
    Display the English help message and exit.

    --chinese_help    default: None
    显示中文用法说明并退出。
