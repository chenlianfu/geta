#!/usr/bin/perl
use strict;
use warnings;
use Getopt::Long;
use Storable qw(nstore retrieve);
use File::Temp qw(tempdir);
use POSIX ();

my $usage = <<USAGE;
Usage:
    perl $0 [options] --genome genome.fasta file1.gff3 file2.gff3 ... > total.gff3

    程序用于读取一个或多个GFF3文件，对GFF3文件格式进行修正，仅保留编码蛋白和lncRNA基因，并去除CDS区有重叠的冗余基因模型。

    1. 输入的GFF3文件格式要求：必须包含mRNA、CDS这两个Feature信息，且其第九列含有Parent信息；也可以包含exon和UTR信息；所有输入的GFF3文件中的所有基因具有不同的ID编号（若后输入文件中出现与先输入文件相同的基因/转录本ID，则后者被忽略并给出警告）。程序仅读取GFF3文件的gene、mRNA、lnc_RNA（或lncRNA）、CDS、exon信息；CDS/exon的Parent可以是逗号分隔的多个转录本。

    2. 程序对GFF3文件按如下顺序进行修正：
    2.1 根据输入的基因组序列信息，程序检测基因模型尾部CDS是否包含终止密码子。若不包含，则程序在基因组序列中检测后续的3个碱基是否为终止密码子，从而修正CDS范围，使之包含终止密码子；若尾部有多个连续终止密码子，则仅保留一个；
    2.2 若输入GFF3文件中不包含exon，则程序根据CDS信息生成exon信息和CDSs之间的intron信息；
    2.3 若输入GFF3文件中包含exon，且exon比CDS范围要多时，则生成UTRs之间的intron信息；
    2.4 若一个mRNA内有两CDSs之间的碱基距离 < 指定阈值，则程序在标准错误输出中给出警告信息，不进行处理；
    2.5 若一个mRNA内有两个exons之间的碱基距离 <= 0，则程序对Exon信息进行修正：先根据CDSs和exons计算出introns，再根据introns和mRNA边界得到准确的exons信息；
    2.6 程序对每个gene的mRNA进行了CDS和exon的完善，检测基因的完整性信息，得到UTR和intron信息，重新计算CDS的phase，并能将这些信息输出到GFF3结果文件中；
    2.7 在一个GFF3文件中，若有两个或多个基因在同一条链上的CDS区域有重叠，则按基因CDS的长度（若存在可变剪接，则是所有isoform的所有CDSs去冗余后的长度），从短到长去除基因模型，保证两两基因模型的CDS区重叠覆盖率（相对较短基因CDS长度的比例）<= 指定阈值；
    2.8 当输入多个GFF3文件时，检测到基因在同一条链上的CDS区重叠覆盖率（相对较短基因CDS长度的比例）> 指定阈值时，则去除后输入文件的基因模型;
    2.9 程序最后对基因模型按输入的基因组FASTA文件中的序列顺序及位置信息进行排序，然后根据需要对基因ID进行重命名，输出去冗余的标准GFF3格式的基因模型信息，此外也输出文件中的原有的Attribute信息。
    2.10 CDS/exon/intron/UTR 的原有Attribute信息按其所属转录本分别保存，不同基因/转录本中坐标相同的Feature不会相互混淆；同一Feature中重复出现的标签，仅保留第一次出现的值。

    3. 参数信息：
    --genome <string>
    输入基因组fasta文件。该参数是必须的，用于修正尾部的CDS和基因完整性检测。

    --discard_lncRNA    default: None
    添加该参数后，程序会忽略lncRNA转录本信息（第3列为lnc_RNA或lncRNA的Feature及其子Feature）。

    --discard_mRNA_without_CDS   default:None
    添加该参数后，程序会忽略没有CDS信息的mRNA转录本信息（lncRNA本身没有CDS，不受该参数影响），若整个基因都没有CDS信息，则忽略整个基因。

    --min_intron <int>    default: 1
    设置一个最短intron长度阈值。当检测到相邻两CDSs之间相距的碱基距离 < 该阈值时，程序会在标准错误输出中给出警告信息。当使用默认参数 1 时，出现警告表示基因模型有错误。

    --coverage <float>    default: 0.30
    设置一个覆盖度阈值（0~1）。当两个基因模型CDS重叠区碱基数 / 较小基因模型CDS去冗余碱基数 > 该覆盖度阈值时，则去除相应的基因模型。若该值设置为 1，则表示不会去除冗余的基因模型；设置为 0，则表示在CDS区重叠 >= 1 bp，也会去除冗余的基因模型。

    --gene_prefix <string>    default: None
    若设置该参数，则程序会对基因ID进行重命名，该参数用于设置gene ID前缀。若不设置该参数，则程序不会对基因进行重命名。

    --gene_code_length <int>    default: none
    设置基因数字编号的长度。若不添加该参数，则程序根据基因的数量自动计算出基因数字编号的长度。例如，基因总数量为10000~99999时，基因数字编号长度为5，于是第一个基因编号为00001；若基因总数量在1000~9999时，基因数字编号长度为4，第一个基因编号为0001。设置该参数用于强行指定基因编号的长度，从而决定基因编号前0的数量。若某个基因的编号数值长度 >= 本参数设置的值，则该基因编号数值前不加0。

    --no_attr_add <bool>     default: None
    添加该参数，则不在GFF3文件第9列添加Source和Integrity信息。

    --GFF3_source <string>    default: none
    若添加该参数，则程序输出的GFF3文件第二列变为该参数设置的值。若不添加该参数，则使用输入文件中原有的信息。

    --cpu <int>    default: 1
    并行进程数。不同参考序列（染色体/scaffold）上的基因模型相互独立，程序按参考序列拆分任务，使用多进程（fork）并行进行CDS修正、完整性检测和去冗余。多个输入文件之间“先输入者优先”的规则在每条参考序列内部保持不变，因此并行结果与 --cpu 1 完全一致。临时文件写入环境变量 TMPDIR 指定的目录（默认 /tmp），程序结束后自动删除。

    --help
    显示本帮助信息。

USAGE
if (@ARGV == 0) { die $usage }

my ($genome, $discard_lncRNA, $discard_mRNA_without_CDS, $gene_prefix, $gene_code_length, $no_attr_add, $GFF3_source, $help);
my $min_intron = 1;
my $coverage   = 0.3;
my $cpu        = 1;
GetOptions(
    "genome=s"                 => \$genome,
    "discard_lncRNA"           => \$discard_lncRNA,
    "discard_mRNA_without_CDS" => \$discard_mRNA_without_CDS,
    "min_intron=i"             => \$min_intron,
    "coverage=f"               => \$coverage,
    "gene_prefix=s"            => \$gene_prefix,
    "gene_code_length=i"       => \$gene_code_length,
    "no_attr_add!"             => \$no_attr_add,
    "GFF3_source=s"            => \$GFF3_source,
    "cpu=i"                    => \$cpu,
    "help|h"                   => \$help,
) or die $usage;
die $usage if $help;
die "--genome should be set\n" unless defined $genome;
die "No input GFF3 file.\n$usage" unless @ARGV;
die "--coverage should be in the range of [0, 1]\n" unless $coverage >= 0 && $coverage <= 1;
die "--min_intron should be >= 0\n" if $min_intron < 0;
die "--cpu should be >= 1\n" if $cpu < 1;
foreach (@ARGV) { die "can not find input file: $_\n" unless -e $_ }
my $rename = ( defined $gene_prefix && $gene_prefix ne '' ) ? 1 : 0;
my $BIN = 1000;

my %codon2aa = (
    TTT=>'F', TTC=>'F', TTA=>'L', TTG=>'L', TCT=>'S', TCC=>'S', TCA=>'S', TCG=>'S',
    TAT=>'Y', TAC=>'Y', TAA=>'*', TAG=>'*', TGT=>'C', TGC=>'C', TGA=>'*', TGG=>'W',
    CTT=>'L', CTC=>'L', CTA=>'L', CTG=>'L', CCT=>'P', CCC=>'P', CCA=>'P', CCG=>'P',
    CAT=>'H', CAC=>'H', CAA=>'Q', CAG=>'Q', CGT=>'R', CGC=>'R', CGA=>'R', CGG=>'R',
    ATT=>'I', ATC=>'I', ATA=>'I', ATG=>'M', ACT=>'T', ACC=>'T', ACA=>'T', ACG=>'T',
    AAT=>'N', AAC=>'N', AAA=>'K', AAG=>'K', AGT=>'S', AGC=>'S', AGA=>'R', AGG=>'R',
    GTT=>'V', GTC=>'V', GTA=>'V', GTG=>'V', GCT=>'A', GCC=>'A', GCA=>'A', GCG=>'A',
    GAT=>'D', GAC=>'D', GAA=>'E', GAG=>'E', GGT=>'G', GGC=>'G', GGA=>'G', GGG=>'G',
);
my %is_stop = ( TAA => 1, TAG => 1, TGA => 1 );

########## 读取基因组序列（统一转为大写，兼容软屏蔽序列与Windows换行符） ##########
my ( %seq, %seq_sort );
{
    open my $fh, '<', $genome or die "can not open file $genome, $!\n";
    my ( $id, $n ) = ( undef, 0 );
    while ( my $line = <$fh> ) {
        $line =~ s/[\r\n]+$//;
        if ( $line =~ m/^>(\S+)/ ) {
            $id = $1;
            if ( exists $seq_sort{$id} ) {
                warn "Warning: duplicated sequence ID $id in $genome, the sequences will be concatenated.\n";
            }
            else {
                $seq_sort{$id} = ++$n;
                $seq{$id} = '';
            }
        }
        elsif ( defined $id ) {
            $line =~ s/\s+//g;
            $seq{$id} .= uc $line;
        }
    }
    close $fh;
}

########## 读取GFF3文件 ##########
# %gene_attr / %gene_score : gene 行第9列（去除ID/Parent）和第6列
# %tx_attr / %tx_score     : mRNA / lnc_RNA 行第9列（去除ID/Parent）和第6列
# %is_lnc                  : lnc_RNA 转录本
# %feat_attr               : 其它Feature的得分和attribute信息，按所属转录本分别保存：
#                            转录本ID => "type\tstart\tend" => { score => 得分, attr => attribute }
# %model                   : gene_ID => { file, chr, strand, source, mRNA => { mRNA_ID => { source, CDS => [[s,e,score,phase],...], exon => [[s,e],...] } } }
# %chr_genes               : chr => [ file_index => [gene_ID, ...] ]
my ( %gene_attr, %gene_score, %tx_attr, %tx_score, %is_lnc, %feat_attr, %model, %gene_owner, %tx_owner, %chr_genes );
my @input_files = @ARGV;
foreach my $fi ( 0 .. $#input_files ) {
    &parse_gff3( $input_files[$fi], $fi );
}

########## 按参考序列拆分任务并行处理 ##########
my @chrs = keys %chr_genes;
foreach my $chr ( sort grep { !exists $seq{$_} } @chrs ) {
    warn "Warning: sequence $chr is not found in $genome; stop codon correction and integrity detection are skipped for genes on it, and these genes are output after all other sequences.\n";
}
my @chr_sorted = sort { ( $seq_sort{$a} || 9e18 ) <=> ( $seq_sort{$b} || 9e18 ) or $a cmp $b } @chrs;

my %chr_gene_num;
foreach my $chr (@chrs) {
    foreach my $list ( @{ $chr_genes{$chr} } ) {
        $chr_gene_num{$chr} += scalar @$list if $list;
    }
}

my $tmpdir = tempdir( "GFF3Clear_XXXXXX", TMPDIR => 1, CLEANUP => 1 );
my %task_file;
foreach my $i ( 0 .. $#chr_sorted ) { $task_file{ $chr_sorted[$i] } = "$tmpdir/$i.sto" }
# 基因数多的参考序列优先调度，以获得更好的负载均衡
my @tasks = sort { $chr_gene_num{$b} <=> $chr_gene_num{$a} or $a cmp $b } @chrs;

if ( $cpu == 1 or @tasks <= 1 ) {
    &run_task( $_, $task_file{$_} ) foreach @tasks;
}
else {
    my ( %running, @failed );
    foreach my $chr (@tasks) {
        while ( keys %running >= $cpu ) {
            my $pid = waitpid( -1, 0 );
            last if $pid <= 0;
            my $c = delete $running{$pid};
            push @failed, $c if defined $c && $? != 0;
        }
        my $pid = fork();
        die "Can not fork: $!\n" unless defined $pid;
        if ( $pid == 0 ) {
            my $ok = eval { &run_task( $chr, $task_file{$chr} ); 1 };
            unless ($ok) {
                print STDERR "Error when processing sequence $chr: $@";
                POSIX::_exit(1);
            }
            POSIX::_exit(0);
        }
        $running{$pid} = $chr;
    }
    while (%running) {
        my $pid = waitpid( -1, 0 );
        last if $pid <= 0;
        my $c = delete $running{$pid};
        push @failed, $c if defined $c && $? != 0;
    }
    die "Failed to process sequence(s): " . join( ", ", @failed ) . "\n" if @failed;
}

########## 汇总输出 ##########
my $total_gene_number = 0;
foreach my $chr (@chr_sorted) {
    open my $fh, '<', "$task_file{$chr}.n" or die "can not open file $task_file{$chr}.n, $!\n";
    my $n = <$fh>;
    close $fh;
    chomp $n;
    $total_gene_number += $n;
}
my $code_length = length($total_gene_number);
$code_length = $gene_code_length if $gene_code_length;

print "##gff-version 3\n";
my $gene_number = 0;
foreach my $chr (@chr_sorted) {
    my $genes = retrieve( $task_file{$chr} );
    foreach my $g (@$genes) {
        $gene_number++;
        &print_gene( $g, $gene_number, $code_length );
    }
    unlink $task_file{$chr}, "$task_file{$chr}.n";
}
print STDERR "Done: $total_gene_number genes were output.\n";


########## 子程序 ##########

sub parse_gff3 {
    my ( $input_file, $fi ) = @_;
    my %t2g;    # 本文件中 mRNA ID -> gene ID

    # 第一遍：读取 gene、mRNA、lnc_RNA 信息
    open my $fh, '<', $input_file or die "can not open file $input_file, $!\n";
    while ( my $line = <$fh> ) {
        $line =~ s/[\r\n]+$//;
        last if $line =~ m/^##FASTA/;    # FASTA 段之后不再是注释信息
        next if $line =~ m/^#/;
        next if $line =~ m/^\s*$/;
        my @f = split /\t/, $line;
        if ( @f < 9 ) {
            warn "Warning: In the GFF3 File $input_file, line with < 9 columns was skipped: $line\n";
            next;
        }
        my $type     = $f[2];
        my $lnc_flag = ( $type eq 'lnc_RNA' or $type eq 'lncRNA' ) ? 1 : 0;

        if ( $type eq 'mRNA' or $lnc_flag ) {
            next if $lnc_flag && $discard_lncRNA;
            my $tid    = &get_tag( $f[8], 'ID' );
            my $parent = &get_tag( $f[8], 'Parent' );
            unless ( defined $tid ) {
                warn "Warning: In the GFF3 File $input_file, mRNA Feature have no ID information: $line\n";
                next;
            }
            unless ( defined $parent ) {
                warn "Warning: In the GFF3 File $input_file, mRNA Feature have no Parent information: $line\n";
                next;
            }
            my ($gid) = split /,/, $parent;
            next if exists $t2g{$tid};    # 同一文件内重复的转录本行，保留第一次出现的
            if ( exists $tx_owner{$tid} ) {
                warn "Warning: transcript ID $tid in $input_file already exists in $input_files[$tx_owner{$tid}], ignored.\n";
                next;
            }
            if ( exists $gene_owner{$gid} && $gene_owner{$gid} != $fi ) {
                warn "Warning: gene ID $gid in $input_file already exists in $input_files[$gene_owner{$gid}], transcript $tid ignored.\n";
                next;
            }
            if ( $f[3] !~ m/^\d+$/ or $f[4] !~ m/^\d+$/ ) {
                warn "Warning: In the GFF3 File $input_file, invalid coordinates, skipped: $line\n";
                next;
            }
            my $g = $model{$gid} ||= { file => $fi, chr => $f[0], strand => $f[6], source => $f[1], mRNA => {} };
            if ( $g->{chr} ne $f[0] or $g->{strand} ne $f[6] ) {
                warn "Warning: transcript $tid is not on the same sequence/strand as other transcripts of gene $gid, ignored.\n";
                next;
            }
            $gene_owner{$gid} = $fi;
            $tx_owner{$tid}   = $fi;
            $t2g{$tid}        = $gid;
            $tx_attr{$tid}    = &get_attr( $f[8] );
            $tx_score{$tid}   = $f[5];
            $is_lnc{$tid}     = 1 if $lnc_flag;
            $g->{mRNA}{$tid}  = { source => $f[1], CDS => [], exon => [] };
        }
        elsif ( $type eq 'gene' ) {
            my $gid = &get_tag( $f[8], 'ID' );
            unless ( defined $gid ) {
                warn "Warning: In the GFF3 File $input_file, gene Feature have no ID information: $line\n";
                next;
            }
            next if exists $gene_attr{$gid};    # 先输入文件的 gene 信息优先
            $gene_attr{$gid}  = &get_attr( $f[8] );
            $gene_score{$gid} = $f[5];
        }
    }
    close $fh;

    # 第二遍：读取 CDS / exon 信息，得到 gene -> mRNA -> CDS/exon；
    # 同时按所属转录本保存 CDS/exon/intron/UTR 的得分和attribute信息
    my %attr_type = map { $_ => 1 } qw(CDS exon intron five_prime_UTR three_prime_UTR);
    open $fh, '<', $input_file or die "can not open file $input_file, $!\n";
    while ( my $line = <$fh> ) {
        $line =~ s/[\r\n]+$//;
        last if $line =~ m/^##FASTA/;
        next if $line =~ m/^#/;
        next if $line =~ m/^\s*$/;
        my @f = split /\t/, $line;
        next if @f < 9;
        next unless $attr_type{ $f[2] };
        my $is_main = ( $f[2] eq 'CDS' or $f[2] eq 'exon' ) ? 1 : 0;
        my $parent = &get_tag( $f[8], 'Parent' );
        unless ( defined $parent ) {
            warn "Warning: In the GFF3 File $input_file, CDS/exon Feature have no Parent information: $line\n" if $is_main;
            next;
        }
        if ( $f[3] !~ m/^\d+$/ or $f[4] !~ m/^\d+$/ ) {
            warn "Warning: In the GFF3 File $input_file, invalid coordinates, skipped: $line\n" if $is_main;
            next;
        }
        my ( $s, $e ) = ( $f[3], $f[4] );
        ( $s, $e ) = ( $e, $s ) if $s > $e;
        my $fattr = &get_attr( $f[8] );
        foreach my $tid ( split /,/, $parent ) {
            my $gid = $t2g{$tid};
            next unless defined $gid;
            my $g = $model{$gid};
            if ( $f[0] ne $g->{chr} or $f[6] ne $g->{strand} ) {
                warn "Warning: In the GFF3 File $input_file, $f[2] is not on the same sequence/strand as its transcript $tid, skipped: $line\n" if $is_main;
                next;
            }
            if ( $f[2] eq 'CDS' ) {
                push @{ $g->{mRNA}{$tid}{CDS} }, [ $s, $e, $f[5], $f[7] ];
            }
            elsif ( $f[2] eq 'exon' ) {
                push @{ $g->{mRNA}{$tid}{exon} }, [ $s, $e ];
            }
            # attribute 仅归属于该转录本下坐标相同的Feature，不同转录本/基因之间互不合并
            my $fa = $feat_attr{$tid}{"$f[2]\t$s\t$e"} ||= { score => $f[5], attr => '' };
            $fa->{attr} = &merge_attr( $fa->{attr}, $fattr );
        }
    }
    close $fh;

    my %genes_here;
    $genes_here{$_} = 1 foreach values %t2g;
    foreach my $gid ( sort keys %genes_here ) {
        push @{ $chr_genes{ $model{$gid}{chr} }[$fi] }, $gid;
    }
}

sub run_task {
    my ( $chr, $file ) = @_;
    my $result = &process_chr($chr);
    nstore( $result, $file );
    open my $fh, '>', "$file.n" or die "can not write file $file.n, $!\n";
    print $fh scalar(@$result), "\n";
    close $fh or die "can not write file $file.n, $!\n";
}

# 处理一条参考序列上的所有基因：模型修正 + 按输入文件顺序去冗余
sub process_chr {
    my ($chr) = @_;
    my $has_seq = exists $seq{$chr} ? 1 : 0;
    my ( %index, %alive, %info );

    foreach my $fi ( 0 .. $#input_files ) {
        my $list = $chr_genes{$chr}[$fi] or next;
        my @current;
        foreach my $gid (@$list) {
            my $g = $model{$gid};
            my ( %proc, @all_cds );
            foreach my $tid ( keys %{ $g->{mRNA} } ) {
                my $t = $g->{mRNA}{$tid};
                next unless @{ $t->{CDS} } or @{ $t->{exon} };
                my $p = &process_transcript( $t, $chr, $g->{strand}, $tid, $has_seq );
                $proc{$tid} = $p;
                push @all_cds, map { [ $_->[0], $_->[1] ] } @{ $p->{CDS} };
            }
            next unless %proc;
            my $merged = &merge_intervals( \@all_cds );
            my $len = 0;
            $len += $_->[1] - $_->[0] + 1 foreach @$merged;
            $info{$gid} = { strand => $g->{strand}, merged => $merged, len => $len, mRNA => \%proc };
            $alive{$gid} = 1;
            push @current, $gid;
            foreach my $iv (@$merged) {
                foreach my $b ( int( $iv->[0] / $BIN ) .. int( $iv->[1] / $BIN ) ) {
                    push @{ $index{ $g->{strand} }{$b} }, [ $iv->[0], $iv->[1], $gid ];
                }
            }
        }

        # 仅对当前文件的基因按CDS长度从短到长过滤；先输入文件的基因不会被删除
        foreach my $gid ( sort { $info{$a}{len} <=> $info{$b}{len} or $a cmp $b } grep { $info{$_}{len} > 0 } @current ) {
            my $gi = $info{$gid};
            my %partner;
            foreach my $iv ( @{ $gi->{merged} } ) {
                foreach my $b ( int( $iv->[0] / $BIN ) .. int( $iv->[1] / $BIN ) ) {
                    my $bin = $index{ $gi->{strand} }{$b} or next;
                    foreach my $e (@$bin) {
                        next if $e->[2] eq $gid or !$alive{ $e->[2] };
                        $partner{ $e->[2] } = 1 if $e->[0] <= $iv->[1] && $e->[1] >= $iv->[0];
                    }
                }
            }
            foreach my $pid ( sort keys %partner ) {
                my $pi    = $info{$pid};
                my $match = &intersect_length( $gi->{merged}, $pi->{merged} );
                my $min   = $gi->{len} < $pi->{len} ? $gi->{len} : $pi->{len};
                my $ratio = $min > 0 ? $match / $min : 0;
                if ( $ratio > $coverage ) {
                    print STDERR "Delete gene $gid, for its CDS coverage ratio with gene $pid is: $ratio > $coverage\n";
                    delete $alive{$gid};
                    last;
                }
            }
        }
    }

    # 组装输出结构
    my @out;
    foreach my $gid ( keys %info ) {
        next unless $alive{$gid};
        my $gi = $info{$gid};
        my @tx;
        foreach my $tid ( sort { &natcmp( $a, $b ) } keys %{ $gi->{mRNA} } ) {
            my $p = $gi->{mRNA}{$tid};
            # lncRNA 本身没有CDS，不受 --discard_mRNA_without_CDS 影响
            next if $discard_mRNA_without_CDS && !@{ $p->{CDS} } && !$is_lnc{$tid};
            push @tx, { id => $tid, source => $model{$gid}{mRNA}{$tid}{source}, %$p };
        }
        next unless @tx;
        my ( $start, $end, $cds_min );
        foreach my $t (@tx) {
            $start = $t->{start} if !defined $start || $t->{start} < $start;
            $end   = $t->{end}   if !defined $end   || $t->{end} > $end;
            foreach my $c ( @{ $t->{CDS} } ) {
                $cds_min = $c->[0] if !defined $cds_min || $c->[0] < $cds_min;
            }
        }
        push @out, {
            id     => $gid,
            chr    => $chr,
            strand => $model{$gid}{strand},
            source => $model{$gid}{source},
            start  => $start,
            end    => $end,
            sort5  => defined $cds_min ? $cds_min : $start,
            mRNA   => \@tx,
        };
    }
    @out = sort {
               $a->{start} <=> $b->{start}
            or $a->{end} <=> $b->{end}
            or $a->{strand} cmp $b->{strand}
            or $a->{sort5} <=> $b->{sort5}
            or $a->{id} cmp $b->{id}
    } @out;
    return \@out;
}

# 对一个转录本进行修正，返回 CDS / exon / intron / UTR / 完整性信息
sub process_transcript {
    my ( $t, $chr, $strand, $tid, $has_seq ) = @_;

    # 去除重复坐标的CDS与exon（复制一份，避免修改原始数据）
    # CDS 的第5、6个元素记录原始坐标，用于终止密码子修正后仍能找到原有的attribute
    my ( %seen, @cds, @exon );
    foreach my $c ( sort { $a->[0] <=> $b->[0] or $a->[1] <=> $b->[1] } @{ $t->{CDS} } ) {
        next if $seen{"$c->[0]\t$c->[1]"}++;
        push @cds, [ @$c[ 0 .. 3 ], $c->[0], $c->[1] ];
    }
    %seen = ();
    foreach my $e ( sort { $a->[0] <=> $b->[0] or $a->[1] <=> $b->[1] } @{ $t->{exon} } ) {
        next if $seen{"$e->[0]\t$e->[1]"}++;
        push @exon, [@$e];
    }

    my $integrity;
    if (@cds) {
        # 先修正尾部终止密码子，之后的 exon / UTR 均基于修正后的CDS计算
        $integrity = &fix_stop_codon_and_integrity( \@cds, $chr, $strand, $tid ) if $has_seq;
        &check_cds_intron( \@cds, $tid );
    }

    my @exon_new = &modify_exon( \@cds, \@exon );
    my @intron   = &gaps( \@exon_new );
    my ( $utr5, $utr3 ) = @cds ? &get_UTR( \@cds, \@exon_new, $strand ) : ( [], [] );
    &set_phase( \@cds, $strand ) if @cds;

    return {
        CDS       => \@cds,
        exon      => \@exon_new,
        intron    => \@intron,
        UTR5      => $utr5,
        UTR3      => $utr3,
        integrity => $integrity,
        start     => $exon_new[0][0],
        end       => $exon_new[-1][1],
    };
}

# @$cds 已按坐标升序排列；直接修改其中的坐标。返回完整性信息。
sub fix_stop_codon_and_integrity {
    my ( $cds, $chr, $strand, $tid ) = @_;
    my $seq_len = length $seq{$chr};
    foreach (@$cds) {
        if ( $_->[1] > $seq_len ) {
            warn "Warning: CDS of $tid exceeds the end of sequence $chr, stop codon correction skipped.\n";
            return undef;
        }
    }

    my $nt = '';
    $nt .= substr( $seq{$chr}, $_->[0] - 1, $_->[1] - $_->[0] + 1 ) foreach @$cds;
    my $phase;
    if ( $strand eq '-' ) {
        $nt = reverse $nt;
        $nt =~ tr/ACGT/TGCA/;
        $phase = $cds->[-1][3];
    }
    else {
        $phase = $cds->[0][3];
    }
    $phase = 0 unless defined $phase && $phase =~ m/^[012]$/;
    $nt = length($nt) > $phase ? substr( $nt, $phase ) : '';
    my $pep = &cds2pep($nt);
    # 以整条CDS（去除5'端phase后）的长度判断最后一个密码子是否完整
    my $codon_complete = ( length($nt) % 3 == 0 ) ? 1 : 0;

    # 尾部存在多个连续终止密码子时，仅保留一个
    if ( $codon_complete && $pep =~ m/(\*+)\*$/ ) {
        my $trim = 3 * length($1);
        my $c = $strand eq '-' ? $cds->[0] : $cds->[-1];
        if ( $c->[1] - $c->[0] + 1 > $trim ) {
            if   ( $strand eq '-' ) { $c->[0] += $trim }
            else                    { $c->[1] -= $trim }
            $pep =~ s/\*+$/*/;
        }
        else {
            warn "Warning: extra stop codons of $tid span more than the last CDS, not trimmed.\n";
        }
    }

    # 尾部没有终止密码子时，检测下游3个碱基
    if ( $codon_complete && $pep !~ m/\*$/ ) {
        if ( $strand eq '-' ) {
            my $c = $cds->[0];
            if ( $c->[0] > 3 ) {
                my $codon = reverse substr( $seq{$chr}, $c->[0] - 4, 3 );
                $codon =~ tr/ACGT/TGCA/;
                if ( $is_stop{$codon} ) {
                    $c->[0] -= 3;
                    $pep .= '*';
                }
            }
        }
        else {
            my $c = $cds->[-1];
            if ( $c->[1] + 3 <= $seq_len ) {
                my $codon = substr( $seq{$chr}, $c->[1], 3 );
                if ( $is_stop{$codon} ) {
                    $c->[1] += 3;
                    $pep .= '*';
                }
            }
        }
    }

    my $start_ok = ( $phase == 0 && $pep =~ m/^M/ ) ? 1 : 0;
    # 末尾密码子不完整时，不能认为3'端完整
    my $end_ok   = ( $codon_complete && $pep =~ m/\*$/ ) ? 1 : 0;
    return 'complete'       if $start_ok && $end_ok;
    return '3prime_partial' if $start_ok;
    return '5prime_partial' if $end_ok;
    return 'internal';
}

sub cds2pep {
    my $s   = uc $_[0];
    my $pep = '';
    my $n   = int( length($s) / 3 );
    for my $i ( 0 .. $n - 1 ) {
        my $codon = substr( $s, 3 * $i, 3 );
        $pep .= exists $codon2aa{$codon} ? $codon2aa{$codon} : 'X';
    }
    return $pep;
}

sub check_cds_intron {
    my ( $cds, $tid ) = @_;
    my @s = sort { $a->[0] <=> $b->[0] } @$cds;
    my $last = $s[0];
    for my $i ( 1 .. $#s ) {
        my $c   = $s[$i];
        my $len = $c->[0] - $last->[1] - 1;
        if ( $len < $min_intron ) {
            print STDERR "Warning: a intron length (value is $len) of mRNA $tid < $min_intron was detected:\n\tThe former CDS: $last->[0] - $last->[1]\n\tThe latter CDS: $c->[0] - $c->[1]\n";
        }
        $last = $c if $c->[1] > $last->[1];
    }
}

# 求区间集合之间的空隙（intron）。正确处理区间包含/重叠的情况。
sub gaps {
    my @s = sort { $a->[0] <=> $b->[0] } @{ $_[0] };
    my ( @g, $last_end );
    foreach (@s) {
        push @g, [ $last_end + 1, $_->[0] - 1 ] if defined $last_end && $_->[0] > $last_end + 1;
        $last_end = $_->[1] if !defined $last_end || $_->[1] > $last_end;
    }
    return @g;
}

# 根据CDS与exon信息修正exon：CDS来源的intron优先；exon来源的intron若与CDS或CDS intron重叠则舍弃。
sub modify_exon {
    my ( $cds, $exon ) = @_;
    my ( $min, $max );
    foreach ( @$cds, @$exon ) {
        $min = $_->[0] if !defined $min || $_->[0] < $min;
        $max = $_->[1] if !defined $max || $_->[1] > $max;
    }
    my @cds_intron = &gaps($cds);
    my @intron     = @cds_intron;
    foreach my $g ( &gaps($exon) ) {
        my $keep = 1;
        foreach my $x ( @cds_intron, @$cds ) {
            if ( $x->[0] <= $g->[1] && $x->[1] >= $g->[0] ) { $keep = 0; last }
        }
        push @intron, $g if $keep;
    }
    @intron = sort { $a->[0] <=> $b->[0] } @intron;

    my @out;
    my $s = $min;
    foreach (@intron) {
        push @out, [ $s, $_->[0] - 1 ] if $_->[0] - 1 >= $s;
        $s = $_->[1] + 1;
    }
    push @out, [ $s, $max ] if $max >= $s;
    return @out;
}

sub get_UTR {
    my ( $cds, $exon, $strand ) = @_;
    my @cds = sort { $a->[0] <=> $b->[0] } @$cds;
    my $cds_min = $cds[0][0];
    my $cds_max = $cds[0][1];
    foreach (@cds) { $cds_max = $_->[1] if $_->[1] > $cds_max }

    my ( @utr5, @utr3 );
    foreach my $e (@$exon) {
        my ( @pieces, $cur );
        $cur = $e->[0];
        foreach my $c (@cds) {
            next if $c->[1] < $e->[0] || $c->[0] > $e->[1];
            push @pieces, [ $cur, $c->[0] - 1 ] if $c->[0] > $cur;
            $cur = $c->[1] + 1 if $c->[1] + 1 > $cur;
        }
        push @pieces, [ $cur, $e->[1] ] if $cur <= $e->[1];
        foreach my $p (@pieces) {
            if ( $p->[1] < $cds_min ) {
                if   ( $strand eq '-' ) { push @utr3, $p }
                else                    { push @utr5, $p }
            }
            elsif ( $p->[0] > $cds_max ) {
                if   ( $strand eq '-' ) { push @utr5, $p }
                else                    { push @utr3, $p }
            }
        }
    }
    return ( \@utr5, \@utr3 );
}

# 以5'端第一个CDS的phase为起点（非0/1/2时视为0），按GFF3规范重新计算所有CDS的phase
sub set_phase {
    my ( $cds, $strand ) = @_;
    my @o = sort { $a->[0] <=> $b->[0] } @$cds;
    @o = reverse @o if $strand eq '-';
    my $p0 = $o[0][3];
    $p0 = 0 unless defined $p0 && $p0 =~ m/^[012]$/;
    my $cum = 0;
    for my $i ( 0 .. $#o ) {
        $o[$i][3] = $i == 0 ? $p0 : ( 3 - ( $cum - $p0 ) % 3 ) % 3;
        $cum += $o[$i][1] - $o[$i][0] + 1;
    }
}

sub merge_intervals {
    my @s = sort { $a->[0] <=> $b->[0] } @{ $_[0] };
    my @m;
    foreach (@s) {
        if ( @m && $_->[0] <= $m[-1][1] ) {
            $m[-1][1] = $_->[1] if $_->[1] > $m[-1][1];
        }
        else {
            push @m, [ $_->[0], $_->[1] ];
        }
    }
    return \@m;
}

# 两组已合并、已排序区间的交集长度（重叠1bp也计入）
sub intersect_length {
    my ( $x, $y ) = @_;
    my ( $i, $j, $len ) = ( 0, 0, 0 );
    while ( $i < @$x && $j < @$y ) {
        my $s = $x->[$i][0] > $y->[$j][0] ? $x->[$i][0] : $y->[$j][0];
        my $e = $x->[$i][1] < $y->[$j][1] ? $x->[$i][1] : $y->[$j][1];
        $len += $e - $s + 1 if $e >= $s;
        if   ( $x->[$i][1] < $y->[$j][1] ) { $i++ }
        else                               { $j++ }
    }
    return $len;
}

sub get_tag {
    my ( $attr, $tag ) = @_;
    foreach my $kv ( split /;/, $attr ) {
        $kv =~ s/^\s+//;
        $kv =~ s/\s+$//;
        return $1 if $kv =~ m/^\Q$tag\E=(.+)$/;
    }
    return undef;
}

# 提取第9列中除 ID / Parent 之外的attribute；同一标签重复出现时，仅保留第一次出现的值
sub get_attr {
    my @out;
    foreach ( split /;/, $_[0] ) {
        s/^\s+//;
        s/\s+$//;
        next if $_ eq '';
        next if m/^(?:ID|Parent)=/;
        push @out, $_;
    }
    return &merge_attr( '', join( ";", @out ) );
}

# 合并两段attribute字符串，按标签名去重：同一标签只保留第一次出现的值，避免同一标签出现多次
sub merge_attr {
    my ( $old, $new ) = @_;
    my ( %seen, @out );
    foreach ( split( /;/, defined $old ? $old : '' ), split( /;/, defined $new ? $new : '' ) ) {
        next if $_ eq '';
        my ($tag) = m/^([^=]*)=/;
        $tag = $_ unless defined $tag;
        next if $seen{$tag}++;
        push @out, $_;
    }
    return @out ? join( ";", @out ) . ';' : '';
}

sub strip_tag {
    my ( $attr, $tag ) = @_;
    my @out = grep { $_ ne '' && !m/^\Q$tag\E=/ } split /;/, $attr;
    return @out ? join( ";", @out ) . ';' : '';
}

sub natcmp {
    my ( $x, $y ) = @_;
    my @a = split /(\d+)/, $x;
    my @b = split /(\d+)/, $y;
    while ( @a && @b ) {
        my ( $p, $q ) = ( shift @a, shift @b );
        my $c = ( $p =~ m/^\d+$/ && $q =~ m/^\d+$/ ) ? $p <=> $q : $p cmp $q;
        return $c if $c;
    }
    return scalar(@a) <=> scalar(@b) || $x cmp $y;
}

# 取某转录本下指定Feature的得分和attribute；参数：转录本ID, 类型, 起点, 终点
sub feat_extra {
    my ( $tid, @k ) = @_;
    my $key = join "\t", @k;
    return ( '.', '' ) unless exists $feat_attr{$tid} && exists $feat_attr{$tid}{$key};
    my $score = $feat_attr{$tid}{$key}{score};
    $score = '.' unless defined $score && $score ne '';
    my $attr = $feat_attr{$tid}{$key}{attr};
    $attr = '' unless defined $attr;
    return ( $score, $attr );
}

sub print_gene {
    my ( $g, $n, $code_length ) = @_;
    my ( $gid, $chr, $strand ) = ( $g->{id}, $g->{chr}, $g->{strand} );
    my $new_gid = $rename ? $gene_prefix . ( '0' x ( $code_length - length($n) ) ) . $n : $gid;
    my $gsrc    = defined $GFF3_source ? $GFF3_source : $g->{source};
    my $gscore  = ( defined $gene_score{$gid} && $gene_score{$gid} ne '' ) ? $gene_score{$gid} : '.';
    my $gattr   = defined $gene_attr{$gid} ? $gene_attr{$gid} : '';
    $gattr = &strip_tag( $gattr, 'Source' ) . "Source=$gid;" if $rename && !$no_attr_add;
    print join( "\t", $chr, $gsrc, 'gene', $g->{start}, $g->{end}, $gscore, $strand, '.', "ID=$new_gid;$gattr" ), "\n";

    my $rev   = $strand eq '-' ? 1 : 0;
    my $width = length( scalar @{ $g->{mRNA} } );
    $width = 2 if $width < 2;
    my $k = 0;
    foreach my $t ( @{ $g->{mRNA} } ) {
        $k++;
        my $tid   = $t->{id};
        my $mid   = $rename ? "$new_gid.t" . ( '0' x ( $width - length($k) ) ) . $k : $tid;
        my $src   = defined $GFF3_source ? $GFF3_source : $t->{source};
        my $type  = $is_lnc{$tid} ? 'lnc_RNA' : 'mRNA';
        my $score = ( defined $tx_score{$tid} && $tx_score{$tid} ne '' ) ? $tx_score{$tid} : '.';
        my $tattr = defined $tx_attr{$tid} ? $tx_attr{$tid} : '';
        unless ($no_attr_add) {
            $tattr = &strip_tag( $tattr, 'Integrity' ) . "Integrity=$t->{integrity};" if defined $t->{integrity};
            $tattr = &strip_tag( $tattr, 'Source' ) . "Source=$tid;" if $rename;
        }
        print join( "\t", $chr, $src, $type, $t->{start}, $t->{end}, $score, $strand, '.', "ID=$mid;Parent=$new_gid;$tattr" ), "\n";

        # 各子Feature按转录方向编号
        my $ordered = sub {
            my @l = sort { $a->[0] <=> $b->[0] } @{ $_[0] };
            return $rev ? reverse(@l) : @l;
        };
        my @feat;
        my $i = 0;
        foreach my $c ( $ordered->( $t->{CDS} ) ) {
            $i++;
            # 用CDS的原始坐标（终止密码子修正前）查找其原有attribute
            my ( undef, $ex ) = &feat_extra( $tid, 'CDS', $c->[4], $c->[5] );
            my $cscore = ( defined $c->[2] && $c->[2] ne '' ) ? $c->[2] : '.';
            push @feat, [ $c->[0], 3, join( "\t", $chr, $src, 'CDS', $c->[0], $c->[1], $cscore, $strand, $c->[3], "ID=$mid.CDS$i;Parent=$mid;$ex" ) ];
        }
        my @simple = ( [ 'exon', 'exon', 2, $t->{exon} ], [ 'intron', 'intron', 5, $t->{intron} ] );
        unless ( $is_lnc{$tid} ) {
            push @simple, [ 'five_prime_UTR', 'utr5p', 1, $t->{UTR5} ], [ 'three_prime_UTR', 'utr3p', 4, $t->{UTR3} ];
        }
        foreach my $sp (@simple) {
            my ( $ftype, $tag, $rank, $list ) = @$sp;
            $i = 0;
            foreach my $r ( $ordered->($list) ) {
                $i++;
                my ( $fscore, $ex ) = &feat_extra( $tid, $ftype, $r->[0], $r->[1] );
                push @feat, [ $r->[0], $rank, join( "\t", $chr, $src, $ftype, $r->[0], $r->[1], $fscore, $strand, '.', "ID=$mid.$tag$i;Parent=$mid;$ex" ) ];
            }
        }
        if ($rev) {
            @feat = sort { $b->[0] <=> $a->[0] or $a->[1] <=> $b->[1] } @feat;
        }
        else {
            @feat = sort { $a->[0] <=> $b->[0] or $a->[1] <=> $b->[1] } @feat;
        }
        print "$_->[2]\n" foreach @feat;
    }
    print "\n";
}
